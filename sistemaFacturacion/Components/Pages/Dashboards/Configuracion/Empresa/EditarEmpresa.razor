@page "/dashboards/configuracion/empresa/editar"
@using Microsoft.AspNetCore.Authorization
@using sistemaFacturacion.Models
@using CurrieTechnologies.Razor.SweetAlert2
@using System.ComponentModel.DataAnnotations
@using sistemaFacturacion.Services
@attribute [Authorize(Roles = "Admin")]

@inject IEmpresaApiClient EmpresaApi
@inject SweetAlertService Swal
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="page-header mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning shadow-sm"
                 style="width:3rem;height:3rem;">
                <i class="ri-building-line fs-4"></i>
            </div>
            <div>
                <h1 class="page-title fw-semibold fs-20 mb-0">Editar empresa</h1>
                <p class="text-muted fs-13 mb-0">
                    Actualiza la información general, tributaria y de contacto de tu empresa.
                </p>
            </div>
        </div>
    </div>
</div>

@if (cargando)
{
    <div class="alert alert-info">
        <span class="spinner-border spinner-border-sm me-2"></span>
        Cargando datos de la empresa...
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorCarga))
{
    <div class="alert alert-danger">
        <i class="ri-error-warning-line me-2"></i>@errorCarga
    </div>
}
else if (form == null)
{
    <div class="alert alert-warning">
        No se pudo cargar la información de la empresa.
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <EditForm Model="@form" OnValidSubmit="@HandleValidSubmitAsync" OnInvalidSubmit="@HandleInvalidAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <ValidationSummary />
                </div>

                <div class="row g-4">
                    <div class="col-12">
                        <div class="rounded-3 border p-3 bg-light">
                            <h6 class="fw-semibold fs-14 d-flex align-items-center mb-3 gap-2">
                                <i class="ri-file-text-line text-primary fs-5"></i>
                                <span>Información Básica</span>
                            </h6>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">RUC</label>
                                    <InputText class="form-control"
                                               @bind-Value="form.RucEmp"
                                               readonly
                                               disabled />
                                    <small class="text-muted d-block mt-1">El RUC no puede ser modificado.</small>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Ambiente</label>
                                    <InputSelect class="form-select" @bind-Value="form.AmbEmp">
                                        <option value="">-- Selecciona --</option>
                                        <option value="PRODUCCION">Producción</option>
                                        <option value="PRUEBAS">Pruebas</option>
                                    </InputSelect>
                                    <small class="text-muted d-block mt-1">Define si estás en ambiente de pruebas o producción del SRI.</small>
                                    <ValidationMessage For="@(() => form.AmbEmp)" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Nombre Comercial</label>
                                    <InputText class="form-control"
                                               @bind-Value="form.NomEmp"
                                               placeholder="Nombre comercial de la empresa"
                                               maxlength="200" />
                                    <ValidationMessage For="@(() => form.NomEmp)" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Dirección</label>
                                    <InputText class="form-control"
                                               @bind-Value="form.DirEmp"
                                               placeholder="Dirección completa"
                                               maxlength="300" />
                                    <ValidationMessage For="@(() => form.DirEmp)" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Teléfono</label>
                                    <InputText class="form-control"
                                               @bind-Value="form.TelEmp"
                                               inputmode="numeric"
                                               placeholder="Ej: 0999999999"
                                               maxlength="10"
                                               @oninput="e =>
                                               {
                                                   form.TelEmp = CleanTelefono(e.Value?.ToString());
                                                   CurrentEditContext?.NotifyFieldChanged(FieldIdentifier.Create(() => form.TelEmp));
                                               }" />
                                    <ValidationMessage For="@(() => form.TelEmp)" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Correo Electrónico</label>
                                    <InputText class="form-control"
                                               @bind-Value="form.CorEmp"
                                               type="email"
                                               placeholder="contacto@empresa.com" />
                                    <ValidationMessage For="@(() => form.CorEmp)" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
                    <span class="text-muted small">
                        <i class="ri-information-line me-1"></i>
                        Los cambios serán guardados inmediatamente.
                    </span>
                    <div class="btn-list">
                        <a class="btn btn-light btn-wave"
                           href="/dashboards/configuracion/empresa">
                            <i class="ri-arrow-go-back-line me-1 align-middle"></i>
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-primary btn-wave"
                                disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2 align-middle"
                                      role="status" aria-hidden="true"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <i class="ri-save-3-line me-1 align-middle"></i>
                                <span>Guardar cambios</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [CascadingParameter] private EditContext? CurrentEditContext { get; set; }

    private EmpresaConfigBasicaRequest? form;
    private int empresaId = 4; // ID fijo de la empresa única
    private bool cargando = true;
    private bool isSubmitting = false;
    private string? errorCarga;

    protected override async Task OnInitializedAsync()
    {
        await CargarEmpresa();
    }

    private async Task CargarEmpresa()
    {
        try
        {
            cargando = true;
            var empresa = await EmpresaApi.GetAsync();

            if (empresa != null)
            {
                empresaId = empresa.IdEmp;
                form = new EmpresaConfigBasicaRequest
                {
                    NomEmp = empresa.NomEmp,
                    RucEmp = empresa.RucEmp,
                    DirEmp = empresa.DirEmp,
                    TelEmp = empresa.TelEmp,
                    CorEmp = empresa.CorEmp,
                    AmbEmp = empresa.AmbEmp
                };
            }
            else
            {
                errorCarga = "No se encontró información de la empresa.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorCarga = $"Error al cargar la empresa: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private static string CleanTelefono(string? s)
    {
        var digits = new string((s ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 10) digits = digits[..10];
        return digits;
    }

    private async Task HandleValidSubmitAsync()
    {
        isSubmitting = true;
        try
        {
            var actualizado = await EmpresaApi.UpdateConfigBasicaAsync(empresaId, form!);

            bool isDark = await JS.InvokeAsync<bool>("isAppInDarkMode");

            var result = await Swal.FireAsync(new SweetAlertOptions
            {
                Icon = SweetAlertIcon.Success,
                Title = "Empresa actualizada",
                Html = $@"
                    <div style='text-align:left;font-size:14px;line-height:1.45'>
                        <div style='display:flex;align-items:center;gap:.6rem;margin:0 0 .65rem'>
                            <svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke-width='1.5' stroke='currentColor' style='width:1.5rem;height:1.5rem;color:#22c55e;flex-shrink:0'>
                                <path stroke-linecap='round' stroke-linejoin='round' d='M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' />
                            </svg>
                            <div>
                                <div style='font-weight:700;font-size:1rem'>{Escape(actualizado.NomEmp)}</div>
                                <div style='font-size:.83rem;color:var(--text-muted)'>RUC: {Escape(actualizado.RucEmp)}</div>
                            </div>
                        </div>
                        <p style='margin:0;color:var(--text-muted)'>Los cambios han sido guardados exitosamente.</p>
                    </div>",
                ShowCancelButton = true,
                ConfirmButtonText = "Ver información",
                CancelButtonText = "Cerrar",
                FocusConfirm = false
            });

            if (result.IsConfirmed)
            {
                Nav.NavigateTo("/dashboards/configuracion/empresa");
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Toast = true,
                    Position = SweetAlertPosition.TopEnd,
                    Icon = SweetAlertIcon.Success,
                    Title = "Cambios guardados",
                    ShowConfirmButton = false,
                    Timer = 2000,
                    Background = isDark ? "#1e1e1e" : null,
                    Color = isDark ? "#e6e6e6" : null
                });

                // Recargar datos
                await CargarEmpresa();
            }
        }
        catch (HttpRequestException ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Icon = SweetAlertIcon.Error,
                Title = "No se pudo actualizar",
                Text = ex.Message,
                Footer = "<small>Intenta nuevamente o contacta al soporte técnico.</small>"
            });
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task HandleInvalidAsync(EditContext ctx)
    {
        var errores = ctx.GetValidationMessages().Take(3);
        await Swal.FireAsync(new SweetAlertOptions
        {
            Icon = SweetAlertIcon.Warning,
            Title = "Completa los campos",
            Html = string.Join("<br/>", errores.Select(Escape))
        });
    }

    private static string Escape(string? s) =>
        string.IsNullOrEmpty(s) ? "" : s.Replace("<", "&lt;").Replace(">", "&gt;");
}