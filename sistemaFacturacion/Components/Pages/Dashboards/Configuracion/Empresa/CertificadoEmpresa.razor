@page "/dashboards/configuracion/certificado-digital"
@using Microsoft.AspNetCore.Authorization
@using sistemaFacturacion.Models
@using CurrieTechnologies.Razor.SweetAlert2
@using sistemaFacturacion.Services
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Admin")]

@inject IEmpresaApiClient EmpresaApi
@inject SweetAlertService Swal
@inject IJSRuntime JS
@inject NavigationManager Nav

<section class="certificado-dashboard">
    <div class="page-header mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="page-title fw-semibold fs-20">Certificado Digital</h1>
                <p class="text-muted fs-13">Gestiona tu certificado de firma electrónica para facturación SRI</p>
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="VolverEmpresa">
                <i class="ri-arrow-left-line me-1"></i> Volver
            </button>
        </div>
    </div>

    @if (cargando)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-3 text-muted">Cargando información del certificado...</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">
            <i class="ri-error-warning-line me-2"></i>
            @error
        </div>
    }
    else if (empresa == null)
    {
        <div class="alert alert-warning">
            <i class="ri-error-warning-line me-2"></i>
            No se encontró información de la empresa.
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-8 col-12">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0 d-flex align-items-center gap-2">
                            <i class="ri-information-line text-info"></i>
                            Estado Actual del Certificado
                        </h6>
                    </div>
                    <div class="card-body">
                        @if (estadoCertificado != null && estadoCertificado.Existe)
                        {
                            <div class="alert @(estadoCertificado.EstaVencido ? "alert-danger" : estadoCertificado.DiasRestantes < 30 ? "alert-warning" : "alert-success") mb-3">
                                <div class="d-flex align-items-start gap-3">
                                    <i class="@(estadoCertificado.EstaVencido ? "ri-close-circle-line" : "ri-checkbox-circle-line") fs-3"></i>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-2">
                                            @if (estadoCertificado.EstaVencido)
                                            {
                                                <span>Certificado Vencido</span>
                                            }
                                            else if (estadoCertificado.DiasRestantes < 30)
                                            {
                                                <span>Certificado por vencer</span>
                                            }
                                            else
                                            {
                                                <span>Certificado Activo</span>
                                            }
                                        </h6>
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <small class="d-block"><strong>Fecha de vencimiento:</strong></small>
                                                <span>@estadoCertificado.FechaVencimiento?.ToString("dd/MM/yyyy")</span>
                                            </div>
                                            <div class="col-md-6">
                                                <small class="d-block"><strong>Días restantes:</strong></small>
                                                <span class="@(estadoCertificado.DiasRestantes < 30 ? "fw-bold" : "")">
                                                    @estadoCertificado.DiasRestantes días
                                                </span>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(estadoCertificado.RutaCertificado))
                                        {
                                            <div class="mt-2">
                                                <small class="d-block"><strong>Ruta del archivo:</strong></small>
                                                <code class="fs-12">@estadoCertificado.RutaCertificado</code>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (estadoCertificado.EstaVencido || estadoCertificado.DiasRestantes < 30)
                            {
                                <div class="alert alert-info">
                                    <i class="ri-information-line me-2"></i>
                                    <strong>Recomendación:</strong>
                                    @if (estadoCertificado.EstaVencido)
                                    {
                                        <span>Tu certificado ha vencido. Debes renovarlo inmediatamente para continuar emitiendo documentos electrónicos.</span>
                                    }
                                    else
                                    {
                                        <span>Tu certificado vencerá pronto. Te recomendamos renovarlo para evitar interrupciones en la emisión de documentos.</span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="ri-alert-line me-2"></i>
                                <strong>Sin certificado:</strong> No hay ningún certificado digital cargado en el sistema.
                            </div>
                        }
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0 d-flex align-items-center gap-2">
                            <i class="ri-upload-cloud-line text-primary"></i>
                            @((estadoCertificado?.Existe == true) ? "Actualizar Certificado Digital" : "Cargar Certificado Digital")
                        </h6>
                    </div>
                    <div class="card-body">
                        <EditForm Model="@uploadRequest" OnValidSubmit="HandleUploadCertificado">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Archivo del Certificado <span class="text-danger">*</span>
                                </label>
                                <InputFile OnChange="HandleFileSelected"
                                           class="form-control"
                                           accept=".p12,.pfx"
                                           disabled="@subiendoCertificado" />
                                <div class="form-text">
                                    <i class="ri-file-lock-line me-1"></i>
                                    Formatos permitidos: .p12 o .pfx (máximo 5MB)
                                </div>
                                @if (!string.IsNullOrWhiteSpace(nombreArchivoSeleccionado))
                                {
                                    <div class="mt-2">
                                        <span class="badge bg-info-subtle text-info">
                                            <i class="ri-file-line me-1"></i>
                                            @nombreArchivoSeleccionado
                                        </span>
                                    </div>
                                }
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Contraseña del Certificado <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <InputText @bind-Value="uploadRequest.Password"
                                               type="@(mostrarPassword ? "text" : "password")"
                                               class="form-control"
                                               placeholder="Ingresa la contraseña del certificado"
                                               disabled="@subiendoCertificado" />
                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            @onclick="() => mostrarPassword = !mostrarPassword"
                                            disabled="@subiendoCertificado">
                                        <i class="@(mostrarPassword ? "ri-eye-off-line" : "ri-eye-line")"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => uploadRequest.Password)" class="text-danger small" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    Fecha de Vencimiento <span class="text-danger">*</span>
                                </label>
                                <InputDate @bind-Value="uploadRequest.FechaVencimiento"
                                           class="form-control"
                                           disabled="@subiendoCertificado" />
                                <ValidationMessage For="@(() => uploadRequest.FechaVencimiento)" class="text-danger small" />
                                <div class="form-text">
                                    <i class="ri-calendar-line me-1"></i>
                                    Ingresa la fecha en que vence tu certificado digital
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit"
                                        class="btn btn-primary"
                                        disabled="@(subiendoCertificado || uploadRequest.ArchivoBytes.Length == 0)">
                                    @if (subiendoCertificado)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Subiendo...</span>
                                    }
                                    else
                                    {
                                        <i class="ri-upload-line me-1"></i>
                                        <span>@((estadoCertificado?.Existe == true) ? "Actualizar Certificado" : "Cargar Certificado")</span>
                                    }
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="LimpiarFormulario"
                                        disabled="@subiendoCertificado">
                                    <i class="ri-refresh-line me-1"></i>
                                    Limpiar
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-12">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0 d-flex align-items-center gap-2">
                            <i class="ri-question-line text-primary"></i>
                            ¿Qué es un certificado digital?
                        </h6>
                    </div>
                    <div class="card-body">
                        <p class="text-muted fs-13 mb-3">
                            El certificado de firma electrónica es un archivo digital que te permite firmar y validar
                            documentos electrónicos ante el SRI (Servicio de Rentas Internas del Ecuador).
                        </p>
                        <div class="alert alert-info mb-0">
                            <small>
                                <strong>Importante:</strong> Este certificado es emitido por entidades certificadoras
                                autorizadas y tiene una validez determinada.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0 d-flex align-items-center gap-2">
                            <i class="ri-shield-check-line text-success"></i>
                            Requisitos
                        </h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2">
                                <i class="ri-check-line text-success me-2"></i>
                                Archivo en formato .p12 o .pfx
                            </li>
                            <li class="mb-2">
                                <i class="ri-check-line text-success me-2"></i>
                                Contraseña del certificado
                            </li>
                            <li class="mb-2">
                                <i class="ri-check-line text-success me-2"></i>
                                Certificado vigente y no vencido
                            </li>
                            <li class="mb-0">
                                <i class="ri-check-line text-success me-2"></i>
                                Emitido por entidad autorizada
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0 d-flex align-items-center gap-2">
                            <i class="ri-information-line text-warning"></i>
                            Recomendaciones
                        </h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0 text-muted fs-13">
                            <li class="mb-2">
                                <i class="ri-arrow-right-s-line me-1"></i>
                                Renueva tu certificado antes de que venza
                            </li>
                            <li class="mb-2">
                                <i class="ri-arrow-right-s-line me-1"></i>
                                Guarda una copia de seguridad del archivo
                            </li>
                            <li class="mb-2">
                                <i class="ri-arrow-right-s-line me-1"></i>
                                No compartas la contraseña del certificado
                            </li>
                            <li class="mb-0">
                                <i class="ri-arrow-right-s-line me-1"></i>
                                Verifica la fecha de vencimiento regularmente
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private EmpresaDto? empresa;
    private CertificadoEstadoDto? estadoCertificado;
    private CertificadoUploadRequest uploadRequest = new();
    private string? nombreArchivoSeleccionado;

    private bool cargando = true;
    private bool subiendoCertificado = false;
    private bool mostrarPassword = false;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarInformacion();
        }
    }

    private async Task CargarInformacion()
    {
        try
        {
            cargando = true;
            StateHasChanged();

            empresa = await EmpresaApi.GetAsync();

            if (empresa != null)
            {
                estadoCertificado = await EmpresaApi.GetEstadoCertificadoAsync(empresa.IdEmp);
            }
        }
        catch (HttpRequestException ex)
        {
            error = $"Error al cargar información: {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null) return;

        var allowedExtensions = new[] { ".p12", ".pfx" };
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!allowedExtensions.Contains(extension))
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Formato no válido",
                Html = "Solo se permiten archivos .p12 o .pfx",
                Icon = SweetAlertIcon.Error
            });
            return;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Archivo muy grande",
                Html = "El archivo no debe superar los 5MB",
                Icon = SweetAlertIcon.Error
            });
            return;
        }

        try
        {
            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(memoryStream);

            uploadRequest.ArchivoBytes = memoryStream.ToArray();
            uploadRequest.NombreArchivo = file.Name;
            nombreArchivoSeleccionado = file.Name;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error al cargar archivo",
                Html = $"<small>{ex.Message}</small>",
                Icon = SweetAlertIcon.Error
            });
        }
    }

    private async Task HandleUploadCertificado()
    {
        if (empresa == null) return;

        try
        {
            var result = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "¿Confirmar carga?",
                Html = $"¿Estás seguro de {((estadoCertificado?.Existe == true) ? "actualizar" : "cargar")} el certificado digital?",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, continuar",
                CancelButtonText = "Cancelar"
            });

            if (!result.IsConfirmed) return;

            subiendoCertificado = true;
            StateHasChanged();

            var success = await EmpresaApi.UploadCertificadoAsync(empresa.IdEmp, uploadRequest);

            if (success)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "¡Éxito!",
                    Html = "El certificado se ha cargado correctamente",
                    Icon = SweetAlertIcon.Success,
                    Timer = 2000,
                    ShowConfirmButton = false
                });

                LimpiarFormulario();
                await CargarInformacion();
            }
        }
        catch (HttpRequestException ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error al cargar certificado",
                Html = $"<small>{ex.Message}</small>",
                Icon = SweetAlertIcon.Error
            });
        }
        finally
        {
            subiendoCertificado = false;
            StateHasChanged();
        }
    }

    private void LimpiarFormulario()
    {
        uploadRequest = new CertificadoUploadRequest();
        nombreArchivoSeleccionado = null;
        mostrarPassword = false;
        StateHasChanged();
    }

    private void VolverEmpresa()
    {
        Nav.NavigateTo("/dashboards/configuracion/empresa");
    }
}