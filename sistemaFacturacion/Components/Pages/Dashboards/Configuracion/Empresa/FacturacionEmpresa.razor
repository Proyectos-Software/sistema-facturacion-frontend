@page "/dashboards/configuracion/facturacion-electronica"
@using Microsoft.AspNetCore.Authorization
@using sistemaFacturacion.Models
@using CurrieTechnologies.Razor.SweetAlert2
@using sistemaFacturacion.Services
@attribute [Authorize(Roles = "Admin")]

@inject IEmpresaApiClient EmpresaApi
@inject SweetAlertService Swal
@inject IJSRuntime JS
@inject NavigationManager Nav

<section class="facturacion-electronica-dashboard">
    <div class="page-header mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary shadow-sm"
                     style="width:3rem;height:3rem;">
                    <i class="ri-file-list-3-line fs-4"></i>
                </div>
                <div>
                    <h1 class="page-title fw-semibold fs-20 mb-0">Configuración de Facturación Electrónica</h1>
                    <p class="text-muted fs-13 mb-0">
                        Configura los parámetros necesarios para la emisión de comprobantes electrónicos según el SRI
                    </p>
                </div>
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="VolverEmpresa">
                <i class="ri-arrow-left-line me-1"></i> Volver
            </button>
        </div>
    </div>

    @if (cargando)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-3 text-muted">Cargando configuración actual...</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorCarga))
    {
        <div class="alert alert-danger">
            <i class="ri-error-warning-line me-2"></i>
            @errorCarga
        </div>
    }
    else if (form == null)
    {
        <div class="alert alert-warning">
            <i class="ri-error-warning-line me-2"></i>
            No se pudo cargar la información de la empresa.
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-8 col-12">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0 d-flex align-items-center gap-2">
                            <i class="ri-information-line text-info"></i>
                            Configuración Actual
                        </h6>
                    </div>
                    <div class="card-body">
                        @if (string.IsNullOrWhiteSpace(empresa?.Establecimiento) ||
                                            string.IsNullOrWhiteSpace(empresa?.PuntoEmision) ||
                                            string.IsNullOrWhiteSpace(empresa?.CodigoNumerico))
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="ri-alert-line me-2"></i>
                                <strong>Configuración incompleta:</strong> Los parámetros del SRI no están configurados completamente.
                                Completa el formulario a continuación para habilitar la facturación electrónica.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success mb-3">
                                <i class="ri-checkbox-circle-line me-2"></i>
                                <strong>Configuración completa:</strong> Los parámetros del SRI están correctamente configurados.
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <small class="text-muted d-block mb-1">Establecimiento</small>
                                    <div class="fw-semibold">
                                        <code class="fs-6">@empresa.Establecimiento</code>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted d-block mb-1">Punto de Emisión</small>
                                    <div class="fw-semibold">
                                        <code class="fs-6">@empresa.PuntoEmision</code>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted d-block mb-1">Ambiente</small>
                                    <div>
                                        <span class="badge @(empresa.AmbEmp == "PRUEBAS" ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success")">
                                            @empresa.AmbEmp
                                        </span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted d-block mb-1">Código Numérico</small>
                                    <div class="fw-semibold">
                                        <code class="fs-6">@empresa.CodigoNumerico</code>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0 d-flex align-items-center gap-2">
                            <i class="ri-settings-3-line text-primary"></i>
                            Parámetros del SRI
                        </h6>
                    </div>
                    <div class="card-body">
                        <EditForm Model="@form" OnValidSubmit="@HandleValidSubmit">
                            <DataAnnotationsValidator />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        Establecimiento <span class="text-danger">*</span>
                                    </label>
                                    <InputText @bind-Value="form.Establecimiento"
                                               class="form-control"
                                               placeholder="001"
                                               maxlength="3"
                                               disabled="@guardando"
                                               @oninput="e => {
                                               form.Establecimiento = LimpiarSoloNumeros(e.Value?.ToString(), 3);
                                               StateHasChanged();
                                           }" />
                                <div class="form-text">
                                    <i class="ri-information-line me-1"></i>
                                    Debe tener exactamente 3 dígitos (ej: 001, 002)
                                </div>
                                <ValidationMessage For="@(() => form.Establecimiento)" class="text-danger small" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Punto de Emisión <span class="text-danger">*</span>
                                </label>
                                <InputText @bind-Value="form.PuntoEmision"
                                           class="form-control"
                                           placeholder="001"
                                           maxlength="3"
                                           disabled="@guardando"
                                           @oninput="e => {
                                           form.PuntoEmision = LimpiarSoloNumeros(e.Value?.ToString(), 3);
                                           StateHasChanged();
                                                                                          }" />
                                <div class="form-text">
                                    <i class="ri-information-line me-1"></i>
                                    Debe tener exactamente 3 dígitos (ej: 001, 002)
                                </div>
                                <ValidationMessage For="@(() => form.PuntoEmision)" class="text-danger small" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">
                                    Código Numérico <span class="text-danger">*</span>
                                </label>
                                <InputText @bind-Value="form.CodigoNumerico"
                                           class="form-control"
                                           placeholder="12345678"
                                           maxlength="8"
                                           disabled="@guardando"
                                           @oninput="e => {
                                                                                              form.CodigoNumerico = LimpiarSoloNumeros(e.Value?.ToString(), 8);
                                           StateHasChanged();
                                                                                          }" />
                                <div class="form-text">
                                    <i class="ri-information-line me-1"></i>
                                    Debe tener exactamente 8 dígitos. Este código se usa en la generación de la clave de acceso
                                </div>
                                <ValidationMessage For="@(() => form.CodigoNumerico)" class="text-danger small" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">
                                    Ambiente <span class="text-danger">*</span>
                                </label>
                                <InputSelect @bind-Value="form.AmbEmp"
                                             class="form-select"
                                             disabled="@guardando">
                                    <option value="">-- Selecciona un ambiente --</option>
                                    <option value="PRUEBAS">Pruebas</option>
                                    <option value="PRODUCCION">Producción</option>
                                </InputSelect>
                                <div class="form-text">
                                    <i class="ri-information-line me-1"></i>
                                    Define si los comprobantes se enviarán al ambiente de pruebas o producción del SRI
                                </div>
                                <ValidationMessage For="@(() => form.AmbEmp)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="alert alert-info mt-4 mb-0">
                            <div class="d-flex align-items-start gap-2">
                                <i class="ri-lightbulb-line fs-5"></i>
                                <div>
                                    <strong>Importante:</strong> Estos parámetros son proporcionados por el SRI y son
                                    necesarios para la correcta generación de la clave de acceso en los comprobantes electrónicos.
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
                            <span class="text-muted small">
                                <i class="ri-information-line me-1"></i>
                                Los cambios se guardarán inmediatamente
                            </span>
                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="LimpiarFormulario"
                                        disabled="@guardando">
                                    <i class="ri-refresh-line me-1"></i>
                                    Restablecer
                                </button>
                                <button type="submit"
                                        class="btn btn-primary"
                                        disabled="@guardando">
                                    @if (guardando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Guardando...</span>
                                    }
                                    else
                                    {
                                        <i class="ri-save-line me-1"></i>
                                        <span>Guardar configuración</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-12">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-transparent">
                    <h6 class="mb-0 d-flex align-items-center gap-2">
                        <i class="ri-question-line text-primary"></i>
                        ¿Qué es esto?
                    </h6>
                </div>
                <div class="card-body">
                    <p class="text-muted fs-13 mb-3">
                        Los parámetros del SRI son códigos numéricos asignados por el Servicio de Rentas Internas
                        que identifican tu punto de emisión de comprobantes electrónicos.
                    </p>
                    <div class="alert alert-light mb-0">
                        <small>
                            <strong>Nota:</strong> Estos datos son proporcionados por el SRI al momento de
                            registrar tu establecimiento en el sistema de facturación electrónica.
                        </small>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-transparent">
                    <h6 class="mb-0 d-flex align-items-center gap-2">
                        <i class="ri-list-check text-success"></i>
                        Definiciones
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong class="d-block mb-1 fs-13">Establecimiento</strong>
                        <p class="text-muted fs-12 mb-0">
                            Código de 3 dígitos que identifica tu sucursal o punto de venta físico.
                        </p>
                    </div>
                    <hr class="my-2" />
                    <div class="mb-3">
                        <strong class="d-block mb-1 fs-13">Punto de Emisión</strong>
                        <p class="text-muted fs-12 mb-0">
                            Código de 3 dígitos que identifica el punto específico desde donde emites comprobantes.
                        </p>
                    </div>
                    <hr class="my-2" />
                    <div class="mb-3">
                        <strong class="d-block mb-1 fs-13">Código Numérico</strong>
                        <p class="text-muted fs-12 mb-0">
                            Código de 8 dígitos que forma parte de la clave de acceso del comprobante electrónico.
                        </p>
                    </div>
                    <hr class="my-2" />
                    <div class="mb-0">
                        <strong class="d-block mb-1 fs-13">Ambiente</strong>
                        <p class="text-muted fs-12 mb-0">
                            Define si emites en <strong>PRUEBAS</strong> (ambiente de desarrollo) o
                            <strong>PRODUCCIÓN</strong> (ambiente real del SRI).
                        </p>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent">
                    <h6 class="mb-0 d-flex align-items-center gap-2">
                        <i class="ri-links-line text-warning"></i>
                        Enlaces relacionados
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <a href="/dashboards/configuracion/empresa" class="link-primary text-decoration-none">
                                <i class="ri-building-line me-2"></i>
                                Información de empresa
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="/dashboards/configuracion/certificado-digital" class="link-primary text-decoration-none">
                                <i class="ri-key-2-line me-2"></i>
                                Certificado digital
                            </a>
                        </li>
                        <li class="mb-0">
                            <a href="/dashboards/configuracion/empresa/editar" class="link-primary text-decoration-none">
                                <i class="ri-edit-line me-2"></i>
                                Editar información básica
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
        }
</section>

@code {
    private EmpresaDto? empresa;
    private EmpresaConfigSriRequest? form;

    private bool cargando = true;
    private bool guardando = false;
    private string? errorCarga;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            cargando = true;
            StateHasChanged();

            empresa = await EmpresaApi.GetAsync();

            if (empresa != null)
            {
                form = new EmpresaConfigSriRequest
                {
                    Establecimiento = empresa.Establecimiento ?? string.Empty,
                    PuntoEmision = empresa.PuntoEmision ?? string.Empty,
                    CodigoNumerico = empresa.CodigoNumerico ?? string.Empty,
                    AmbEmp = empresa.AmbEmp ?? string.Empty
                };
            }
            else
            {
                errorCarga = "No se encontró información de la empresa.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorCarga = $"Error al cargar configuración: {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidSubmit()
    {
        if (empresa == null || form == null) return;

        try
        {
            var result = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "¿Guardar configuración?",
                Html = @"
                    <div style='text-align:left;'>
                        <p>Se actualizarán los siguientes parámetros:</p>
                        <ul style='font-size:0.9rem;'>
                            <li><strong>Establecimiento:</strong> " + form.Establecimiento + @"</li>
                            <li><strong>Punto de emisión:</strong> " + form.PuntoEmision + @"</li>
                            <li><strong>Código numérico:</strong> " + form.CodigoNumerico + @"</li>
                            <li><strong>Ambiente:</strong> " + form.AmbEmp + @"</li>
                        </ul>
                    </div>",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, guardar",
                CancelButtonText = "Cancelar"
            });

            if (!result.IsConfirmed) return;

            guardando = true;
            StateHasChanged();

            var actualizado = await EmpresaApi.UpdateConfigSriAsync(empresa.IdEmp, form);

            var isDarkMode = await JS.InvokeAsync<bool>("isAppInDarkMode");

            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "¡Configuración guardada!",
                Html = "Los parámetros del SRI se han actualizado correctamente.",
                Icon = SweetAlertIcon.Success,
                Timer = 2000,
                ShowConfirmButton = false,
                Background = isDarkMode ? "#1e1e1e" : null,
                Color = isDarkMode ? "#e6e6e6" : null
            });

            // Recargar datos
            await CargarDatos();
        }
        catch (HttpRequestException ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error al guardar",
                Html = $"<small>{ex.Message}</small>",
                Icon = SweetAlertIcon.Error
            });
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private void LimpiarFormulario()
    {
        if (empresa != null)
        {
            form = new EmpresaConfigSriRequest
            {
                Establecimiento = empresa.Establecimiento ?? string.Empty,
                PuntoEmision = empresa.PuntoEmision ?? string.Empty,
                CodigoNumerico = empresa.CodigoNumerico ?? string.Empty,
                AmbEmp = empresa.AmbEmp ?? string.Empty
            };
            StateHasChanged();
        }
    }

    private static string LimpiarSoloNumeros(string? input, int maxLength)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;

        var digits = new string(input.Where(char.IsDigit).ToArray());
        return digits.Length > maxLength ? digits[..maxLength] : digits;
    }

    private void VolverEmpresa()
    {
        Nav.NavigateTo("/dashboards/configuracion/empresa");
    }
}