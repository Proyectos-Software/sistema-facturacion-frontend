@page "/dashboards/configuracion/empresa"
@using Microsoft.AspNetCore.Authorization
@using sistemaFacturacion.Models
@using CurrieTechnologies.Razor.SweetAlert2
@using sistemaFacturacion.Services
@attribute [Authorize(Roles = "Admin")]

@inject IEmpresaApiClient EmpresaApi
@inject SweetAlertService Swal
@inject IJSRuntime JS
@inject NavigationManager Nav

<section class="empresa-dashboard">
    <div class="page-header mb-4">
        <h1 class="page-title fw-semibold fs-20">Configuración de Empresa</h1>
        <p class="text-muted fs-13">Gestiona la información general de tu empresa y datos tributarios.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
        <div class="col">
            <a href="/dashboards/configuracion/empresa/editar" class="text-decoration-none">
                <div class="card hover-scale h-100 border-0 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-warning-subtle p-3">
                            <i class="ri-building-line fs-3"></i>
                        </div>
                        <div>
                            <h5 class="mb-1">Editar empresa</h5>
                            <small class="text-muted">Actualizar información general y tributaria</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm bg-light">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info-subtle p-3">
                        <i class="ri-information-line fs-3"></i>
                    </div>
                    <div>
                        <h5 class="mb-1">Información del sistema</h5>
                        <small class="text-muted">Una sola empresa puede ser gestionada</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (cargando)
    {
        <div class="alert alert-info">Cargando información de la empresa...</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (empresa == null)
    {
        <div class="alert alert-warning">
            <i class="ri-error-warning-line me-2"></i>
            No se encontró información de empresa. Por favor, contacta al administrador del sistema.
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-lg-8 col-12">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0 d-flex align-items-center gap-2">
                            <i class="ri-building-4-line text-primary"></i>
                            Información General
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-1">RUC</small>
                                    <div class="fw-semibold">
                                        <code class="fs-6">@empresa.RucEmp</code>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-1">Ambiente</small>
                                    <div class="fw-semibold">
                                        <span class="badge @(empresa.AmbEmp == "PRUEBAS" ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success")">
                                            @empresa.AmbEmp
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-1">Nombre Comercial</small>
                                    <div class="fw-semibold fs-5">@empresa.NomEmp</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-1">Dirección</small>
                                    <div>@empresa.DirEmp</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-12">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0 d-flex align-items-center gap-2">
                            <i class="ri-contacts-line text-primary"></i>
                            Datos de Contacto
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-column gap-3">
                            <div>
                                <small class="text-muted d-block mb-1">
                                    <i class="ri-phone-line me-1"></i> Teléfono
                                </small>
                                <div class="fw-semibold">@empresa.TelEmp</div>
                            </div>
                            <div>
                                <small class="text-muted d-block mb-1">
                                    <i class="ri-mail-line me-1"></i> Correo Electrónico
                                </small>
                                <div class="fw-semibold">@empresa.CorEmp</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-lg-6 col-12">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0 d-flex align-items-center gap-2">
                            <i class="ri-file-text-line text-primary"></i>
                            Configuración SRI
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <small class="text-muted d-block mb-1">Establecimiento</small>
                                <div class="fw-semibold">
                                    <code>@(string.IsNullOrWhiteSpace(empresa.Establecimiento) ? "No configurado" : empresa.Establecimiento)</code>
                                </div>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block mb-1">Punto de Emisión</small>
                                <div class="fw-semibold">
                                    <code>@(string.IsNullOrWhiteSpace(empresa.PuntoEmision) ? "No configurado" : empresa.PuntoEmision)</code>
                                </div>
                            </div>
                            <div class="col-12">
                                <small class="text-muted d-block mb-1">Código Numérico</small>
                                <div class="fw-semibold">
                                    <code>@(string.IsNullOrWhiteSpace(empresa.CodigoNumerico) ? "No configurado" : empresa.CodigoNumerico)</code>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-12">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0 d-flex align-items-center gap-2">
                            <i class="ri-key-2-line text-primary"></i>
                            Estado del Certificado Digital
                        </h6>
                    </div>
                    <div class="card-body">
                        @if (empresa.TieneCertificado && empresa.CertificadoExiste)
                        {
                            <div class="alert alert-success mb-2">
                                <i class="ri-checkbox-circle-line me-2"></i>
                                <strong>Certificado activo</strong>
                            </div>
                            @if (empresa.FechaVencimientoCertificado.HasValue)
                            {
                                var diasRestantes = (empresa.FechaVencimientoCertificado.Value - DateTime.Now).Days;
                                var alertClass = diasRestantes < 30 ? "alert-warning" : "alert-info";

                                <div class="@alertClass">
                                    <small>
                                        <strong>Vencimiento:</strong> @empresa.FechaVencimientoCertificado.Value.ToString("dd/MM/yyyy")
                                        <br />
                                        <strong>Días restantes:</strong> @diasRestantes días
                                    </small>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="ri-error-warning-line me-2"></i>
                                No hay certificado digital cargado
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-6 col-12">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0">Acciones rápidas</h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled d-grid mb-0 gap-2">
                            <li>
                                <a class="link-primary" href="/dashboards/configuracion/empresa/editar">
                                    <i class="ri-edit-line"></i> Editar información de la empresa
                                </a>
                            </li>
                            <li>
                                <a class="link-primary" href="/dashboards/configuracion/facturacion-electronica">
                                    <i class="ri-file-list-3-line"></i> Configurar facturación electrónica
                                </a>
                            </li>
                            <li>
                                <a class="link-primary" href="/dashboards/configuracion/certificado-digital">
                                    <i class="ri-key-2-line"></i> Gestionar certificado digital
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-12">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h6 class="mb-0">Información importante</h6>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info mb-3">
                            <i class="ri-information-line me-2"></i>
                            <strong>Una empresa por sistema:</strong> Solo puedes gestionar una empresa en este sistema.
                        </div>
                        <p class="text-muted mb-0">
                            Asegúrate de mantener actualizada la información de tu empresa para la correcta emisión de documentos electrónicos.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private EmpresaDto? empresa;
    private bool cargando = true;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Cargar();
        }
    }

    private async Task Cargar()
    {
        try
        {
            cargando = true;
            StateHasChanged();

            empresa = await EmpresaApi.GetAsync();

            var isDarkMode = await JS.InvokeAsync<bool>("isAppInDarkMode");
            if (empresa != null)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Toast = true,
                    Position = SweetAlertPosition.TopEnd,
                    Icon = SweetAlertIcon.Success,
                    Title = "Información cargada",
                    ShowConfirmButton = false,
                    Timer = 1200,
                    Background = isDarkMode ? "#1e1e1e" : null,
                    Color = isDarkMode ? "#e6e6e6" : null
                });
            }
        }
        catch (HttpRequestException ex)
        {
            error = $"No se pudo cargar la información de la empresa. {ex.Message}";
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error al cargar",
                Html = $"<small>{ex.Message}</small>",
                Icon = SweetAlertIcon.Error
            });
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
}