@page "/dashboards/reporte-general"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using sistemaFacturacion.Interfaces
@inject IVentasPorEmpleadoApiClient VentasPorEmpleadoApi
@inject IVentasGeneralApiClient VentasGeneralApi
@inject IInventarioApiClient InventarioApi
@inject IDashboardVentasApiClient DashboardVentasApi
@inject SweetAlertService Swal
@inject IJSRuntime JS
@inject NavigationManager Nav

<section class="reportes-dashboard">
    <div class="page-header mb-4">
        <h1 class="page-title fw-semibold fs-20">Generador de Reportes</h1>
        <p class="text-muted fs-13">Seleccione un reporte para generar y descargar.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-4">

        <div class="col">
            <div class="card report-card-style h-100 border-0 shadow-sm"
                 @onclick="() => NavigateToReportParamsPage(ReportType.VentasPorEmpleado)">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info-subtle p-3">
                        <i class="ri-file-user-line fs-3"></i>
                    </div>
                    <div>
                        <h5 class="mb-1">Ventas por Empleado</h5>
                        <small class="text-muted">Reporte PDF detallado por empleado.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card report-card-style h-100 border-0 shadow-sm"
                 @onclick="() => NavigateToReportParamsPage(ReportType.VentasGeneral)">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-secondary-subtle p-3">
                        <i class="ri-file-chart-line fs-3"></i>
                    </div>
                    <div>
                        <h5 class="mb-1">Ventas Generales</h5>
                        <small class="text-muted">Resumen PDF de todas las ventas.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card report-card-style h-100 border-0 shadow-sm"
                 @onclick="() => NavigateToReportParamsPage(ReportType.Inventario)">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-purple-subtle p-3">
                        <i class="ri-archive-line fs-3"></i>
                    </div>
                    <div>
                        <h5 class="mb-1">Inventario</h5>
                        <small class="text-muted">Detalle PDF del inventario actual.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card report-card-style h-100 border-0 shadow-sm"
                 @onclick="() => NavigateToReportParamsPage(ReportType.DashboardVentas)">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success-subtle p-3">
                        <i class="ri-dashboard-line fs-3"></i>
                    </div>
                    <div>
                        <h5 class="mb-1">Dashboard Ventas</h5>
                        <small class="text-muted">KPIs y gráficos en PDF.</small>
                    </div>
                </div>
            </div>
        </div>

    </div>

</section>

@code {

    private bool isDarkMode;

    public enum ReportType
    {
        VentasPorEmpleado,
        VentasGeneral,
        Inventario,
        DashboardVentas
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isDarkMode = await JS.InvokeAsync<bool>("isAppInDarkMode");
        }
        catch { }
    }

    private void NavigateToReportParamsPage(ReportType reportType)
    {
        Nav.NavigateTo($"/reportes/parametros?type={(int)reportType}");
    }
}
