@page "/dashboards/lotes/editar/{id:int}"
@using System.ComponentModel.DataAnnotations
@using System.Net
@using Microsoft.AspNetCore.Authorization
@using sistemaFacturacion.Models
@using sistemaFacturacion.Services
@inject ILotesApiClient LotesApi
@inject IProductosApiClient ProductosApi
@inject NavigationManager Nav
@inject CurrieTechnologies.Razor.SweetAlert2.SweetAlertService Swal
@attribute [Authorize]

<div class="page-header mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary shadow-sm"
                 style="width:3rem;height:3rem;">
                <i class="ri-inbox-line fs-4"></i>
            </div>
            <div>
                <h1 class="page-title fw-semibold fs-20 mb-0">Editar lote</h1>
                <p class="text-muted fs-13 mb-0">
                    Actualice la información del lote seleccionado manteniendo el control de inventario y rentabilidad.
                </p>
            </div>
        </div>
        <div class="btn-list">
            <button type="button"
                    class="btn btn-light btn-wave"
                    @onclick="Volver">
                <i class="ri-arrow-go-back-line me-1 align-middle"></i>
                Volver a lotes
            </button>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="alert alert-info d-flex align-items-center">
        <span class="spinner-border spinner-border-sm me-3"></span>
        <span>Cargando información del lote...</span>
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger d-flex align-items-center">
        <i class="ri-error-warning-line fs-5 me-2"></i>
        <div>
            <div class="fw-semibold mb-1">No se pudo cargar el lote</div>
            <small class="text-muted d-block mb-0">@error</small>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <EditForm Model="@vm" OnValidSubmit="@Guardar">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <ValidationSummary />
                </div>

                <!-- Sección: Producto y lote -->
                <div class="rounded-3 lote-form-section mb-3 border p-3">
                    <h6 class="fw-semibold fs-14 d-flex align-items-center mb-3 gap-2">
                        <i class="ri-box-3-line text-primary fs-5"></i>
                        <span>Producto y lote</span>
                    </h6>

                    <div class="row g-3">
                        <div class="col-lg-3 col-12">
                            <label class="form-label lote-form-label">Código producto</label>
                            <div class="input-group">
                                <span class="input-group-text lote-input-icon">
                                    <i class="ri-barcode-line"></i>
                                </span>
                                <input class="form-control lote-form-input fw-semibold"
                                       value="@vm.CodigoProducto"
                                       disabled />
                            </div>
                            <small class="text-muted d-block lote-help-text mt-1">
                                Identificador único del producto.
                            </small>
                        </div>

                        <div class="col-lg-9 col-12">
                            <label class="form-label lote-form-label">Nombre del producto</label>
                            <div class="input-group">
                                <span class="input-group-text lote-input-icon">
                                    <i class="ri-shopping-bag-line"></i>
                                </span>
                                <input class="form-control lote-form-input fw-semibold"
                                       value="@(string.IsNullOrWhiteSpace(vm.NombreProducto) ? "(sin nombre)" : vm.NombreProducto)"
                                       disabled />
                            </div>
                            <small class="text-muted d-block lote-help-text mt-1">
                                Producto al que pertenece este lote.
                            </small>
                        </div>

                        <div class="col-lg-4 col-12">
                            <label class="form-label lote-form-label">Categoría</label>
                            <div class="input-group">
                                <span class="input-group-text lote-input-icon">
                                    <i class="ri-price-tag-3-line"></i>
                                </span>
                                <input class="form-control lote-form-input"
                                       value="@(string.IsNullOrWhiteSpace(vm.NombreCategoria) ? "Sin categoría" : vm.NombreCategoria)"
                                       disabled />
                            </div>
                            <small class="text-muted d-block lote-help-text mt-1">
                                Clasificación del producto.
                            </small>
                        </div>

                        <div class="col-lg-4 col-12">
                            <label class="form-label lote-form-label">Código de lote</label>
                            <div class="input-group">
                                <span class="input-group-text lote-input-icon">
                                    <i class="ri-archive-2-line"></i>
                                </span>
                                <input class="form-control lote-form-input fw-semibold"
                                       value="@vm.CodLot"
                                       disabled />
                            </div>
                            <small class="text-muted d-block lote-help-text mt-1">
                                Código identificador del lote.
                            </small>
                        </div>

                        <div class="col-lg-4 col-12">
                            <label class="form-label lote-form-label">Estado actual</label>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge" style="@EstadoBadgeStyle">@EstadoTexto</span>
                            </div>
                            <small class="text-muted d-block lote-help-text mt-1">
                                Estado calculado según disponibilidad del lote.
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Secciones lado a lado -->
                <div class="row g-3">
                    <!-- Columna izquierda: Fechas e inventario -->
                    <div class="col-xl-6 col-lg-6">
                        <!-- Fechas del lote -->
                        <div class="rounded-3 lote-form-section mb-3 border p-3">
                            <h6 class="fw-semibold fs-14 d-flex align-items-center mb-3 gap-2">
                                <i class="ri-calendar-check-line text-primary fs-5"></i>
                                <span>Fechas del lote</span>
                            </h6>

                            <div class="alert alert-info d-flex align-items-start lote-alert-info mb-3 gap-2 border-0 px-3 py-2">
                                <i class="ri-information-line fs-5 flex-shrink-0"></i>
                                <small class="lote-alert-text mb-0">
                                    Asegúrese de que la fecha de expiración sea posterior a la fecha de compra.
                                </small>
                            </div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label lote-form-label">
                                        Fecha de compra <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text lote-input-icon">
                                            <i class="ri-calendar-2-line"></i>
                                        </span>
                                        <InputDate class="form-control lote-form-input" @bind-Value="vm.FecCom" />
                                    </div>
                                    <ValidationMessage For="@(() => vm.FecCom)" />
                                    <small class="text-muted d-block lote-help-text mt-1">
                                        Fecha en que se adquirió el lote.
                                    </small>
                                </div>

                                <div class="col-12">
                                    <label class="form-label lote-form-label">
                                        Fecha de expiración <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text lote-input-icon">
                                            <i class="ri-timer-2-line"></i>
                                        </span>
                                        <InputDate class="form-control lote-form-input" @bind-Value="vm.FecExp" />
                                    </div>
                                    <ValidationMessage For="@(() => vm.FecExp)" />
                                    <small class="text-muted d-block lote-help-text mt-1">
                                        Fecha límite de vigencia del lote.
                                    </small>
                                </div>

                                <div class="col-12">
                                    <div class="lote-info-box rounded border p-3">
                                        <div class="d-flex align-items-center mb-1 gap-2">
                                            <i class="ri-time-line text-primary"></i>
                                            <span class="fw-semibold fs-13 lote-info-title">Vigencia estimada</span>
                                        </div>
                                        <div class="lote-info-content fs-12">
                                            Desde <strong>@vm.FecCom.ToShortDateString()</strong>
                                            hasta <strong>@vm.FecExp.ToShortDateString()</strong>
                                        </div>
                                        @if (vm.FecExp > vm.FecCom)
                                        {
                                            var dias = (vm.FecExp - vm.FecCom).Days;
                                            <div class="lote-info-content fs-12 mt-1">
                                                <i class="ri-calendar-line me-1"></i>@dias día(s) de duración
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Inventario -->
                        <div class="rounded-3 lote-form-section border p-3">
                            <h6 class="fw-semibold fs-14 d-flex align-items-center mb-3 gap-2">
                                <i class="ri-stack-line text-primary fs-5"></i>
                                <span>Control de inventario</span>
                            </h6>

                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label lote-form-label">
                                        Cantidad total <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text lote-input-icon">
                                            <i class="ri-archive-line"></i>
                                        </span>
                                        <InputNumber class="form-control lote-form-input" @bind-Value="vm.CanLot" />
                                    </div>
                                    <ValidationMessage For="@(() => vm.CanLot)" />
                                    <small class="text-muted d-block lote-help-text mt-1">
                                        Unidades totales del lote.
                                    </small>
                                </div>

                                <div class="col-6">
                                    <label class="form-label lote-form-label">
                                        Disponible <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text lote-input-icon">
                                            <i class="ri-checkbox-circle-line"></i>
                                        </span>
                                        <InputNumber class="form-control lote-form-input" @bind-Value="vm.CanDis" />
                                    </div>
                                    <ValidationMessage For="@(() => vm.CanDis)" />
                                    <small class="text-muted d-block lote-help-text mt-1">
                                        Unidades actualmente disponibles para venta.
                                    </small>
                                </div>

                                @if (vm.CanLot > 0 && vm.CanDis >= 0)
                                {
                                    var reservadas = vm.CanLot - vm.CanDis;
                                    var porcentajeDisponible = (decimal)vm.CanDis / vm.CanLot * 100;

                                    <div class="col-12">
                                        <div class="lote-info-box rounded border p-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fw-semibold fs-13 lote-info-title">Resumen de stock</span>
                                                <span class="badge bg-primary-subtle text-primary">
                                                    @Math.Round(porcentajeDisponible, 1)% disponible
                                                </span>
                                            </div>
                                            <div class="progress lote-progress mb-2" style="height: 8px;">
                                                <div class="progress-bar bg-success"
                                                     role="progressbar"
                                                     style="width: @porcentajeDisponible%"
                                                     aria-valuenow="@porcentajeDisponible"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100"></div>
                                            </div>
                                            <div class="d-flex justify-content-between lote-info-content fs-12">
                                                <span><i class="ri-box-3-line me-1"></i>@reservadas reservadas</span>
                                                <span><i class="ri-shopping-cart-line me-1"></i>@vm.CanDis disponibles</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Columna derecha: Precios y estado -->
                    <div class="col-xl-6 col-lg-6">
                        <!-- Política de precios -->
                        <div class="rounded-3 lote-form-section mb-3 border p-3">
                            <h6 class="fw-semibold fs-14 d-flex align-items-center mb-3 gap-2">
                                <i class="ri-money-dollar-circle-line text-primary fs-5"></i>
                                <span>Política de precios</span>
                            </h6>

                            <div class="alert alert-warning d-flex align-items-start lote-alert-warning mb-3 gap-2 border-0 px-3 py-2">
                                <i class="ri-error-warning-line fs-5 flex-shrink-0"></i>
                                <small class="lote-alert-text mb-0">
                                    El precio de venta debe mantener un margen de rentabilidad adecuado respecto al costo de compra.
                                </small>
                            </div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label lote-form-label">
                                        Precio de compra (costo) <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text lote-input-icon">$</span>
                                        <InputNumber class="form-control lote-form-input"
                                                     @bind-Value="vm.PreCom"
                                                     @bind-Value:after="ActualizarRangoPrecio" />
                                    </div>
                                    <ValidationMessage For="@(() => vm.PreCom)" />
                                    <small class="text-muted d-block lote-help-text mt-1">
                                        Costo unitario actual del producto en este lote.
                                    </small>
                                </div>

                                <div class="col-12">
                                    <label class="form-label lote-form-label">
                                        Precio de venta (referencial)
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text lote-input-icon">
                                            <i class="ri-lightbulb-line"></i>
                                        </span>
                                        <input class="form-control lote-form-input"
                                               value="El precio de venta se gestiona desde el módulo de productos."
                                               disabled />
                                    </div>

                                    @if (precioMinSugerido.HasValue && precioMaxSugerido.HasValue)
                                    {
                                        <small class="d-block lote-help-text mt-1">
                                            <i class="ri-lightbulb-line me-1"></i>
                                            Rango sugerido para precio de venta futuro:
                                            <strong>$@(precioMinSugerido ?? 0.00m)</strong> – <strong>$@(precioMaxSugerido ?? 0.00m)</strong>
                                        </small>
                                    }
                                </div>

                            </div>
                        </div>

                        <!-- Estado del lote (informativo) -->
                        <div class="rounded-3 lote-form-section border p-3">
                            <h6 class="fw-semibold fs-14 d-flex align-items-center mb-3 gap-2">
                                <i class="ri-checkbox-circle-line text-primary fs-5"></i>
                                <span>Estado del lote</span>
                            </h6>

                            <div class="lote-estado-box rounded border p-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle @(vm.EstLot ? "bg-success text-white" : "bg-danger text-white")"
                                         style="width:2.5rem;height:2.5rem;flex-shrink:0;">
                                        <i class="@(vm.EstLot ? "ri-check-line" : "ri-close-line") fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold @(vm.EstLot ? "text-success" : "text-danger") mb-1">
                                            @(vm.EstLot ? "Con stock disponible" : "Sin stock disponible")
                                        </div>
                                        <div class="fs-12 lote-estado-description mb-0">
                                            Este estado se gestiona automáticamente según las unidades disponibles del lote
                                            y se utiliza como referencia en las operaciones de venta.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer con acciones -->
                <div class="d-flex justify-content-between align-items-center border-top lote-footer-border mt-4 flex-wrap gap-2 pt-3">
                    <div class="d-flex align-items-center small lote-footer-text gap-2">
                        <i class="ri-shield-check-line text-primary fs-5"></i>
                        <span>Verifique todos los datos antes de guardar. Los cambios afectarán inventario y rentabilidad.</span>
                    </div>
                    <div class="btn-list">
                        <button type="button"
                                class="btn btn-light btn-wave"
                                @onclick="Volver">
                            <i class="ri-close-line me-1 align-middle"></i>
                            Cancelar
                        </button>
                        <button type="submit"
                                class="btn btn-primary btn-wave">
                            <i class="ri-save-3-line me-1 align-middle"></i>
                            Guardar cambios
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int id { get; set; }

    private bool isLoading = true;
    private string? error;
    private LoteVM vm = new();

    private const decimal MargenBase = 0.30m;
    private const decimal FactorDemanda = 0.10m;

    private decimal? precioMinSugerido;
    private decimal? precioMaxSugerido;

    private string EstadoTexto => vm?.EstLot == true ? "Con stock" : "Sin stock";

    private string EstadoBadgeStyle => vm?.EstLot == true
        ? "background:#16a34a;color:#fff;border-radius:9999px;padding:.25rem .6rem;font-weight:700;letter-spacing:.02em"
        : "background:#ef4444;color:#fff;border-radius:9999px;padding:.25rem .6rem;font-weight:700;letter-spacing:.02em";

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            error = null;

            var dto = await LotesApi.GetByIdAsync(id);
            if (dto is null)
            {
                error = $"No se encontró el lote {id}.";
                return;
            }

            vm = new LoteVM
            {
                Id = dto.Id,
                CodLot = dto.CodLot ?? "",
                IdPro = dto.IdPro,
                NombreProducto = dto.NombreProducto ?? "",
                NombreCategoria = dto.NombreCategoria ?? "",
                FecCom = dto.FecCom,
                FecExp = dto.FecExp,
                CanLot = dto.CanLot,
                CanDis = dto.CanDis,
                PreCom = dto.PreCom,
                EstLot = dto.EstLot
            };


            try
            {
                var producto = await ProductosApi.GetByIdAsync(vm.IdPro);
                if (producto is not null)
                {
                    vm.NombreProducto = producto.Nombre;
                    vm.NombreCategoria = producto.NombreCategoria;
                    vm.CodigoProducto = producto.Codigo;
                }
            }
            catch
            {
                // Si falla la consulta del producto, se mantienen los datos del DTO del lote
            }

            await ObtenerRangoPrecioAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ActualizarRangoPrecio()
    {
        await ObtenerRangoPrecioAsync();
        StateHasChanged();
    }

    private async Task<bool> ValidarCamposAsync()
    {
        if (vm.IdPro <= 0)
        {
            await Alert(
                "Producto no asociado",
                "El lote no tiene un producto asociado. Contacte al administrador del sistema."
            );
            return false;
        }

        if (vm.FecCom > vm.FecExp)
        {
            await Alert("Fechas inconsistentes", "La fecha de compra no puede ser mayor que la de expiración.");
            return false;
        }

        if (vm.CanDis > vm.CanLot)
        {
            await Alert("Cantidad inválida", "Disponible no puede superar la cantidad del lote.");
            return false;
        }

        if (vm.PreCom <= 0)
        {
            await Alert("Precio de compra inválido", "El precio de compra debe ser mayor que 0.");
            return false;
        }

        // Ya no se valida precio de venta porque no se envía al backend.
        return true;
    }

    private async Task<(decimal Min, decimal Max)?> ObtenerRangoPrecioAsync()
    {
        if (vm.IdPro <= 0 || vm.PreCom <= 0)
        {
            precioMinSugerido = precioMaxSugerido = null;
            return null;
        }

        List<LoteDto> lotesProducto;
        try
        {
            lotesProducto = await LotesApi.GetByProductIdAsync(vm.IdPro);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            lotesProducto = new List<LoteDto>();
        }

        var otrosLotes = lotesProducto
            .Where(l => l.Id != vm.Id)
            .ToList();

        decimal costoFifo;
        decimal ultimoCosto;
        decimal costoBase;

        if (otrosLotes.Any())
        {
            var activos = otrosLotes
                .Where(l => l.CanDis > 0)
                .OrderBy(l => l.FecCom)
                .ToList();

            if (activos.Any())
            {
                costoFifo = activos.First().PreCom;
                ultimoCosto = activos.Last().PreCom;
            }
            else
            {
                var ordenados = otrosLotes.OrderBy(l => l.FecCom).ToList();
                costoFifo = ordenados.First().PreCom;
                ultimoCosto = ordenados.Last().PreCom;
            }

            costoBase = ultimoCosto;
        }
        else
        {
            costoFifo = vm.PreCom;
            ultimoCosto = vm.PreCom;
            costoBase = vm.PreCom;
        }

        var (min, max) = CalcularRangoPrecio(costoFifo, ultimoCosto, costoBase);
        precioMinSugerido = min;
        precioMaxSugerido = max;
        return (min, max);
    }

    private (decimal Min, decimal Max) CalcularRangoPrecio(decimal costoFifo, decimal ultimoCosto, decimal costoBase)
    {
        var minimo = Math.Max(
            costoFifo * 1.20m,
            ultimoCosto * 1.15m);

        var maximo = costoBase * (1 + MargenBase) * (1 + FactorDemanda);

        return (
            decimal.Round(minimo, 2, MidpointRounding.AwayFromZero),
            decimal.Round(maximo, 2, MidpointRounding.AwayFromZero)
        );
    }

    private async Task Guardar()
    {
        if (!await ValidarCamposAsync())
            return;

        try
        {
            var req = new LoteUpdateRequest
            {
                IdPro = vm.IdPro,
                FecCom = vm.FecCom,
                FecExp = vm.FecExp,
                CanLot = vm.CanLot,
                CanDis = vm.CanDis,
                PreCom = vm.PreCom
            };


            await LotesApi.UpdateAsync(vm.Id, req);

            await Swal.FireAsync(new()
            {
                Icon = SweetAlertIcon.Success,
                Title = "Lote actualizado",
                Toast = true,
                Position = SweetAlertPosition.TopEnd,
                Timer = 1600,
                ShowConfirmButton = false
            });

            Nav.NavigateTo("/dashboards/lotes/listar");
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new()
            {
                Icon = SweetAlertIcon.Error,
                Title = "Error al actualizar",
                Html = $"<small>{ex.Message}</small>"
            });
        }
    }

    private Task Alert(string title, string html) =>
        Swal.FireAsync(new()
        {
            Icon = SweetAlertIcon.Warning,
            Title = title,
            Html = $"<small>{html}</small>",
            ConfirmButtonColor = "#0ea5e9"
        });

    private void Volver() => Nav.NavigateTo("/dashboards/lotes/listar");

    private sealed class LoteVM
    {
        public int Id { get; set; }

        public string CodLot { get; set; } = "";

        [Range(1, int.MaxValue, ErrorMessage = "Debe existir un producto asociado.")]
        public int IdPro { get; set; }

        public string CodigoProducto { get; set; } = "";
        public string NombreProducto { get; set; } = "";
        public string NombreCategoria { get; set; } = "";

        [Required] public DateTime FecCom { get; set; }
        [Required] public DateTime FecExp { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Debe ser ≥ 1")]
        public int CanLot { get; set; }

        [Range(0, int.MaxValue, ErrorMessage = "Debe ser ≥ 0")]
        public int CanDis { get; set; }

        [Range(0, 999999, ErrorMessage = "Debe ser ≥ 0")]
        public decimal PreCom { get; set; } 

        public bool EstLot { get; set; }
    }
