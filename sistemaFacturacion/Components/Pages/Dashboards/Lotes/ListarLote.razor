@page "/dashboards/lotes/listar"
@using Microsoft.AspNetCore.Authorization
@using sistemaFacturacion.Models
@using sistemaFacturacion.Services
@attribute [Authorize]

@inject ILotesApiClient LotesApi
@inject NavigationManager Navigation

<div class="page-header mb-4">
    <h1 class="page-title fw-semibold fs-20">Listado de Lotes</h1>
    <p class="text-muted fs-13">Consulta, filtrado avanzado y agrupación por categoría de producto</p>
</div>

@if (cargando)
{
    <div class="alert alert-info">
        <span class="spinner-border spinner-border-sm me-2"></span> Cargando lotes...
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">
        <i class="ri-error-warning-line me-2"></i>@error
    </div>
}
else
{
    <div class="card mb-3 border-0 shadow-sm">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4 col-12">
                    <label class="form-label">
                        Búsqueda rápida (código lote, producto, categoría)
                    </label>
                    <input class="form-control"
                           @bind="FiltroTexto"
                           @bind:event="oninput"
                           placeholder="Escribe para filtrar en varios campos..." />
                </div>

                <div class="col-lg-2 col-6">
                    <label class="form-label">Estado</label>
                    <select class="form-select" @bind="FiltroEstado">
                        <option value="">Todos</option>
                        <option value="activos">Activos</option>
                        <option value="inactivos">Inactivos</option>
                    </select>
                </div>

                <div class="col-lg-2 col-6">
                    <label class="form-label">Por página</label>
                    <select class="form-select" @bind="pageSize">
                        <option>5</option>
                        <option>10</option>
                        <option>20</option>
                    </select>
                </div>

                <div class="col-lg-4 d-grid d-lg-flex justify-content-lg-end col-12 gap-2">
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="@(() => Navigation.NavigateTo("/dashboards/lotes"))">
                        <i class="ri-add-line me-1"></i>Nuevo lote
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="Recargar">
                        <i class="ri-refresh-line me-1"></i>Recargar
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="LimpiarFiltros">
                        <i class="ri-filter-off-line me-1"></i>Limpiar
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <button type="button"
                        class="btn btn-sm btn-link px-0"
                        @onclick="ToggleFiltrosAvanzados">
                    <i class="ri-filter-3-line me-1"></i>
                    @(mostrarFiltrosAvanzados ? "Ocultar filtros avanzados" : "Mostrar filtros avanzados")
                </button>
                <span class="text-muted small">
                    Filtros específicos con autocompletado, rangos de cantidades, precios y fechas.
                </span>
            </div>

            @if (mostrarFiltrosAvanzados)
            {
                <!-- Texto con autocompletado -->
                <div class="row g-3 mt-2">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Código lote</label>
                        <div class="position-relative">
                            <input class="form-control"
                                   value="@filtroCodLote"
                                   @oninput="OnCodLoteInput"
                                   placeholder="Filtrar por código de lote..."
                                   autocomplete="off" />
                            @if (sugerenciasCodLote.Count > 0)
                            {
                                <div class="dropdown-menu show w-100 shadow-sm">
                                    @foreach (var s in sugerenciasCodLote)
                                    {
                                        <button type="button"
                                                class="dropdown-item"
                                                @onclick="() => SeleccionarSugerenciaCodLote(s)">
                                            @s
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Producto</label>
                        <div class="position-relative">
                            <input class="form-control"
                                   value="@filtroProducto"
                                   @oninput="OnProductoInput"
                                   placeholder="Filtrar por nombre de producto..."
                                   autocomplete="off" />
                            @if (sugerenciasProducto.Count > 0)
                            {
                                <div class="dropdown-menu show w-100 shadow-sm">
                                    @foreach (var s in sugerenciasProducto)
                                    {
                                        <button type="button"
                                                class="dropdown-item"
                                                @onclick="() => SeleccionarSugerenciaProducto(s)">
                                            @s
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Rangos de cantidades -->
                <div class="row g-3 mt-1">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Cantidad de lote (rango)</label>
                        <div class="row g-2 align-items-center">
                            <div class="col-6">
                                <input type="number"
                                       min="0"
                                       class="form-control form-control-sm"
                                       @bind="FiltroCantLoteMin"
                                       @bind:event="oninput"
                                       placeholder="Desde" />
                            </div>
                            <div class="col-6">
                                <input type="number"
                                       min="0"
                                       class="form-control form-control-sm"
                                       @bind="FiltroCantLoteMax"
                                       @bind:event="oninput"
                                       placeholder="Hasta" />
                            </div>
                        </div>
                        <small class="text-muted d-block mt-1">
                            Deja vacío uno de los campos para filtrar solo por mínimo o máximo.
                        </small>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Cantidad disponible (rango)</label>
                        <div class="row g-2 align-items-center">
                            <div class="col-6">
                                <input type="number"
                                       min="0"
                                       class="form-control form-control-sm"
                                       @bind="FiltroCantDispMin"
                                       @bind:event="oninput"
                                       placeholder="Desde" />
                            </div>
                            <div class="col-6">
                                <input type="number"
                                       min="0"
                                       class="form-control form-control-sm"
                                       @bind="FiltroCantDispMax"
                                       @bind:event="oninput"
                                       placeholder="Hasta" />
                            </div>
                        </div>
                        <small class="text-muted d-block mt-1">
                            Rango flexible de stock disponible.
                        </small>
                    </div>
                </div>

                <!-- Rangos de precios -->
                <div class="row g-3 mt-1">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Precio de compra (rango)</label>
                        <div class="row g-2 align-items-center">
                            <div class="col-6">
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control form-control-sm"
                                       @bind="FiltroPrecioComMin"
                                       @bind:event="oninput"
                                       placeholder="Desde" />
                            </div>
                            <div class="col-6">
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control form-control-sm"
                                       @bind="FiltroPrecioComMax"
                                       @bind:event="oninput"
                                       placeholder="Hasta" />
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Precio de venta (rango)</label>
                        <div class="row g-2 align-items-center">
                            <div class="col-6">
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control form-control-sm"
                                       @bind="FiltroPrecioVenMin"
                                       @bind:event="oninput"
                                       placeholder="Desde" />
                            </div>
                            <div class="col-6">
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control form-control-sm"
                                       @bind="FiltroPrecioVenMax"
                                       @bind:event="oninput"
                                       placeholder="Hasta" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fechas -->
                <div class="row g-3 mt-1">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Fecha de compra</label>
                        <select class="form-select form-select-sm"
                                @bind="FiltroPeriodoCompra">
                            <option value="">Todas</option>
                            <option value="week">Últimos 7 días</option>
                            <option value="month">Últimos 30 días</option>
                            <option value="year">Últimos 12 meses</option>
                            <option value="custom">Rango personalizado</option>
                        </select>

                        @if (FiltroPeriodoCompra == "custom")
                        {
                            <div class="d-flex mt-2 gap-2">
                                <input type="date"
                                       class="form-control form-control-sm"
                                       @bind="PeriodoCompraDesde" />
                                <input type="date"
                                       class="form-control form-control-sm"
                                       @bind="PeriodoCompraHasta" />
                            </div>
                            <small class="text-muted">Filtra por fecha de compra del lote.</small>
                        }
                        else if (!string.IsNullOrWhiteSpace(FiltroPeriodoCompra))
                        {
                            <small class="text-muted d-block mt-1">
                                Basado en la fecha de compra del lote.
                            </small>
                        }
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Fecha de expiración</label>
                        <select class="form-select form-select-sm"
                                @bind="FiltroPeriodoExp">
                            <option value="">Todas</option>
                            <option value="week">Próximos 7 días</option>
                            <option value="month">Próximos 30 días</option>
                            <option value="year">Próximos 12 meses</option>
                            <option value="custom">Rango personalizado</option>
                        </select>

                        @if (FiltroPeriodoExp == "custom")
                        {
                            <div class="d-flex mt-2 gap-2">
                                <input type="date"
                                       class="form-control form-control-sm"
                                       @bind="PeriodoExpDesde" />
                                <input type="date"
                                       class="form-control form-control-sm"
                                       @bind="PeriodoExpHasta" />
                            </div>
                            <small class="text-muted">Filtra por fecha de expiración del lote.</small>
                        }
                        else if (!string.IsNullOrWhiteSpace(FiltroPeriodoExp))
                        {
                            <small class="text-muted d-block mt-1">
                                Basado en la fecha de expiración del lote.
                            </small>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between bg-transparent">
            <div>
                <h6 class="mb-0">Lotes (@FilteredCount resultados)</h6>
                <small class="text-muted">
                    Categoría seleccionada:
                    @(string.IsNullOrWhiteSpace(categoriaSeleccionada) ? "-" : categoriaSeleccionada)
                </small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-light"
                        title="Anterior"
                        @onclick="PrevPage"
                        disabled="@(pageIndex == 1)">
                    <i class="ri-arrow-left-s-line"></i>
                </button>
                <span class="small text-muted">Página @pageIndex de @TotalPages</span>
                <button class="btn btn-sm btn-light"
                        title="Siguiente"
                        @onclick="NextPage"
                        disabled="@(pageIndex == TotalPages)">
                    <i class="ri-arrow-right-s-line"></i>
                </button>
            </div>
        </div>

        <div class="card-body px-3 pt-2 pb-0">
            @if (categoriasProductos.Count > 0)
            {
                <nav class="nav nav-style-1 nav-pills mb-3" role="tablist">
                    @foreach (var categoria in categoriasProductos)
                    {
                        var activo = !string.IsNullOrWhiteSpace(categoriaSeleccionada) &&
                        string.Equals(categoria, categoriaSeleccionada, StringComparison.OrdinalIgnoreCase);

                        <button type="button"
                                class="nav-link @(activo ? "active" : "")"
                                @onclick="@(() => SeleccionarCategoria(categoria))">
                            @categoria
                        </button>
                    }
                </nav>
            }
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table-hover mb-0 table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th @onclick="@(() => OrdenarPor(nameof(RowVM.CodLot)))"
                                role="button"
                                class="user-select-none">
                                Código lote @IconoOrden(nameof(RowVM.CodLot))
                            </th>
                            <th @onclick="@(() => OrdenarPor(nameof(RowVM.NombreProducto)))"
                                role="button"
                                class="user-select-none">
                                Producto @IconoOrden(nameof(RowVM.NombreProducto))
                            </th>
                            <th @onclick="@(() => OrdenarPor(nameof(RowVM.NombreCategoria)))"
                                role="button"
                                class="user-select-none">
                                Categoría @IconoOrden(nameof(RowVM.NombreCategoria))
                            </th>
                            <th @onclick="@(() => OrdenarPor(nameof(RowVM.FecCom)))"
                                role="button"
                                class="user-select-none">
                                F. Compra @IconoOrden(nameof(RowVM.FecCom))
                            </th>
                            <th @onclick="@(() => OrdenarPor(nameof(RowVM.FecExp)))"
                                role="button"
                                class="user-select-none">
                                F. Expira @IconoOrden(nameof(RowVM.FecExp))
                            </th>
                            <th @onclick="@(() => OrdenarPor(nameof(RowVM.CanLot)))"
                                role="button"
                                class="user-select-none">
                                Cant. lote @IconoOrden(nameof(RowVM.CanLot))
                            </th>
                            <th @onclick="@(() => OrdenarPor(nameof(RowVM.CanDis)))"
                                role="button"
                                class="user-select-none">
                                Disponible @IconoOrden(nameof(RowVM.CanDis))
                            </th>
                            <th @onclick="@(() => OrdenarPor(nameof(RowVM.PreCom)))"
                                role="button"
                                class="user-select-none">
                                Precio compra @IconoOrden(nameof(RowVM.PreCom))
                            </th>
                            <th @onclick="@(() => OrdenarPor(nameof(RowVM.PreVen)))"
                                role="button"
                                class="user-select-none">
                                Precio venta @IconoOrden(nameof(RowVM.PreVen))
                            </th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Paged.Count == 0)
                        {
                            <tr>
                                <td colspan="11" class="text-muted py-4 text-center">
                                    <i class="ri-inbox-line fs-3 d-block mb-2"></i>
                                    No hay resultados con los filtros aplicados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var l in Paged)
                            {
                                <tr @key="l.Id">
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(l.CodLot))
                                        {
                                            <span class="badge bg-primary-subtle text-primary fw-semibold">
                                                @l.CodLot
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@l.NombreProducto</td>
                                    <td>@l.NombreCategoria</td>
                                    <td>
                                        <small class="text-muted">
                                            @l.FecCom.ToString("dd/MM/yyyy")
                                        </small>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @l.FecExp.ToString("dd/MM/yyyy")
                                        </small>
                                    </td>
                                    <td>@l.CanLot</td>
                                    <td>@l.CanDis</td>
                                    <td><small>@FormatMoney(l.PreCom)</small></td>
                                    <td><small>@FormatMoney(l.PreVen)</small></td>
                                    <td>
                                        @if (l.EstLot)
                                        {
                                            <span class="badge rounded-pill bg-success text-fixed-white d-inline-flex align-items-center gap-1 px-2 py-1">
                                                <i class="ri-check-line fs-14"></i>
                                                <span>Con stock</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger text-fixed-white d-inline-flex align-items-center gap-1 px-2 py-1">
                                                <i class="ri-close-line fs-14"></i>
                                                <span>Sin stock</span>
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                @onclick="() => IrAEditar(l)"
                                                title="Editar lote">
                                            <i class="ri-edit-line"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<RowVM> items = new();
    private bool cargando = true;
    private string? error;

    // Filtros rápidos
    private string? _filtroTexto;
    private string? _filtroEstado;

    private string? FiltroTexto
    {
        get => _filtroTexto;
        set
        {
            if (_filtroTexto != value)
            {
                _filtroTexto = value;
                pageIndex = 1;
            }
        }
    }

    private string? FiltroEstado
    {
        get => _filtroEstado;
        set
        {
            if (_filtroEstado != value)
            {
                _filtroEstado = value;
                pageIndex = 1;
            }
        }
    }

    // Filtros avanzados texto
    private string? filtroCodLote;
    private string? filtroProducto;

    private bool mostrarFiltrosAvanzados;

    private List<string> sugerenciasCodLote = new();
    private List<string> sugerenciasProducto = new();

    // Filtros numéricos (rangos)
    private decimal? _filtroCantLoteMin;
    private decimal? _filtroCantLoteMax;
    private decimal? _filtroCantDispMin;
    private decimal? _filtroCantDispMax;
    private decimal? _filtroPrecioComMin;
    private decimal? _filtroPrecioComMax;
    private decimal? _filtroPrecioVenMin;
    private decimal? _filtroPrecioVenMax;

    private decimal? FiltroCantLoteMin
    {
        get => _filtroCantLoteMin;
        set
        {
            if (_filtroCantLoteMin != value)
            {
                _filtroCantLoteMin = value;
                pageIndex = 1;
            }
        }
    }

    private decimal? FiltroCantLoteMax
    {
        get => _filtroCantLoteMax;
        set
        {
            if (_filtroCantLoteMax != value)
            {
                _filtroCantLoteMax = value;
                pageIndex = 1;
            }
        }
    }

    private decimal? FiltroCantDispMin
    {
        get => _filtroCantDispMin;
        set
        {
            if (_filtroCantDispMin != value)
            {
                _filtroCantDispMin = value;
                pageIndex = 1;
            }
        }
    }

    private decimal? FiltroCantDispMax
    {
        get => _filtroCantDispMax;
        set
        {
            if (_filtroCantDispMax != value)
            {
                _filtroCantDispMax = value;
                pageIndex = 1;
            }
        }
    }

    private decimal? FiltroPrecioComMin
    {
        get => _filtroPrecioComMin;
        set
        {
            if (_filtroPrecioComMin != value)
            {
                _filtroPrecioComMin = value;
                pageIndex = 1;
            }
        }
    }

    private decimal? FiltroPrecioComMax
    {
        get => _filtroPrecioComMax;
        set
        {
            if (_filtroPrecioComMax != value)
            {
                _filtroPrecioComMax = value;
                pageIndex = 1;
            }
        }
    }

    private decimal? FiltroPrecioVenMin
    {
        get => _filtroPrecioVenMin;
        set
        {
            if (_filtroPrecioVenMin != value)
            {
                _filtroPrecioVenMin = value;
                pageIndex = 1;
            }
        }
    }

    private decimal? FiltroPrecioVenMax
    {
        get => _filtroPrecioVenMax;
        set
        {
            if (_filtroPrecioVenMax != value)
            {
                _filtroPrecioVenMax = value;
                pageIndex = 1;
            }
        }
    }

    // Filtro periodo (fecha compra)
    private string? _filtroPeriodoCompra;
    private string? FiltroPeriodoCompra
    {
        get => _filtroPeriodoCompra;
        set
        {
            if (_filtroPeriodoCompra != value)
            {
                _filtroPeriodoCompra = value;
                if (_filtroPeriodoCompra != "custom")
                {
                    PeriodoCompraDesde = null;
                    PeriodoCompraHasta = null;
                }
                pageIndex = 1;
            }
        }
    }

    private DateTime? _periodoCompraDesde;
    private DateTime? PeriodoCompraDesde
    {
        get => _periodoCompraDesde;
        set
        {
            if (_periodoCompraDesde != value)
            {
                _periodoCompraDesde = value;
                pageIndex = 1;
            }
        }
    }

    private DateTime? _periodoCompraHasta;
    private DateTime? PeriodoCompraHasta
    {
        get => _periodoCompraHasta;
        set
        {
            if (_periodoCompraHasta != value)
            {
                _periodoCompraHasta = value;
                pageIndex = 1;
            }
        }
    }

    // Filtro periodo (fecha expiración)
    private string? _filtroPeriodoExp;
    private string? FiltroPeriodoExp
    {
        get => _filtroPeriodoExp;
        set
        {
            if (_filtroPeriodoExp != value)
            {
                _filtroPeriodoExp = value;
                if (_filtroPeriodoExp != "custom")
                {
                    PeriodoExpDesde = null;
                    PeriodoExpHasta = null;
                }
                pageIndex = 1;
            }
        }
    }

    private DateTime? _periodoExpDesde;
    private DateTime? PeriodoExpDesde
    {
        get => _periodoExpDesde;
        set
        {
            if (_periodoExpDesde != value)
            {
                _periodoExpDesde = value;
                pageIndex = 1;
            }
        }
    }

    private DateTime? _periodoExpHasta;
    private DateTime? PeriodoExpHasta
    {
        get => _periodoExpHasta;
        set
        {
            if (_periodoExpHasta != value)
            {
                _periodoExpHasta = value;
                pageIndex = 1;
            }
        }
    }

    // Paginación y ordenamiento
    private int pageIndex = 1;
    private int _pageSize = 10;

    private int pageSize
    {
        get => _pageSize;
        set
        {
            if (_pageSize != value)
            {
                _pageSize = value;
                pageIndex = 1;
            }
        }
    }

    private string? sortBy;
    private bool sortAsc = true;

    // Categorías (pestañas)
    private readonly List<string> categoriasProductos = new();
    private string? categoriaSeleccionada;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            cargando = true;
            error = null;

            var lotes = await LotesApi.GetAllAsync();

            items = lotes
                .Select(l => new RowVM
                {
                    Id = l.Id,
                    CodLot = l.CodLot,
                    NombreProducto = l.NombreProducto ?? string.Empty,
                    NombreCategoria = l.NombreCategoria,
                    NombreTipoTributario = l.NombreTipoTributario,
                    FecCom = l.FecCom,
                    FecExp = l.FecExp,
                    CanLot = l.CanLot,
                    CanDis = l.CanDis,
                    PreCom = l.PreCom,
                    PreVen = l.PreVen,
                    EstLot = l.EstLot
                })
                .OrderByDescending(r => r.FecCom)
                .ToList();

            categoriasProductos.Clear();
            categoriasProductos.AddRange(
                items
                    .Select(x => x.NombreCategoria)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(x => x)
            );

            if (categoriasProductos.Count > 0)
            {
                if (string.IsNullOrWhiteSpace(categoriaSeleccionada) ||
                    !categoriasProductos.Contains(categoriaSeleccionada, StringComparer.OrdinalIgnoreCase))
                {
                    categoriaSeleccionada = categoriasProductos[0];
                }
            }
            else
            {
                categoriaSeleccionada = null;
            }
        }
        catch (HttpRequestException ex)
        {
            error = "Error al cargar lotes: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Recargar()
    {
        await CargarDatos();
        pageIndex = 1;
    }

    private void LimpiarFiltros()
    {
        FiltroTexto = null;
        FiltroEstado = null;

        filtroCodLote = null;
        filtroProducto = null;

        sugerenciasCodLote.Clear();
        sugerenciasProducto.Clear();

        FiltroCantLoteMin = null;
        FiltroCantLoteMax = null;
        FiltroCantDispMin = null;
        FiltroCantDispMax = null;
        FiltroPrecioComMin = null;
        FiltroPrecioComMax = null;
        FiltroPrecioVenMin = null;
        FiltroPrecioVenMax = null;

        FiltroPeriodoCompra = null;
        PeriodoCompraDesde = null;
        PeriodoCompraHasta = null;

        FiltroPeriodoExp = null;
        PeriodoExpDesde = null;
        PeriodoExpHasta = null;

        sortBy = null;
        sortAsc = true;

        if (categoriasProductos.Count > 0)
        {
            categoriaSeleccionada = categoriasProductos[0];
        }
        else
        {
            categoriaSeleccionada = null;
        }

        pageIndex = 1;
    }

