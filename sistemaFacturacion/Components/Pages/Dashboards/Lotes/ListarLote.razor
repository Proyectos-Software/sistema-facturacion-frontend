    private List<string> CalcularSugerencias(string? valor, Func<RowVM, string?> selector)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return new List<string>();

        var query = valor.Trim();
        if (query.Length < 2)
            return new List<string>();

        return items
            .Select(selector)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(s => s.IndexOf(query, StringComparison.OrdinalIgnoreCase) >= 0)
            .OrderBy(s => s)
            .Take(8)
            .ToList();
    }

    // Filtrado
    private List<RowVM> Filtered
    {
        get
        {
            var r = items.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(categoriaSeleccionada))
            {
                var cat = categoriaSeleccionada;
                r = r.Where(x =>
                    string.Equals(x.NombreCategoria, cat, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_filtroTexto))
            {
                var q = _filtroTexto.Trim();
                r = r.Where(x =>
                    ContainsIgnoreCase(x.CodLot, q) ||
                    ContainsIgnoreCase(x.NombreProducto, q) ||
                    ContainsIgnoreCase(x.NombreCategoria, q));
            }

            if (!string.IsNullOrWhiteSpace(filtroCodLote))
            {
                var q = filtroCodLote.Trim();
                r = r.Where(x => ContainsIgnoreCase(x.CodLot, q));
            }

            if (!string.IsNullOrWhiteSpace(filtroProducto))
            {
                var q = filtroProducto.Trim();
                r = r.Where(x => ContainsIgnoreCase(x.NombreProducto, q));
            }

            r = AplicarFiltroRangoDecimal(r, x => (decimal?)x.CanLot, FiltroCantLoteMin, FiltroCantLoteMax);
            r = AplicarFiltroRangoDecimal(r, x => (decimal?)x.CanDis, FiltroCantDispMin, FiltroCantDispMax);
            r = AplicarFiltroRangoDecimal(r, x => x.PreCom, FiltroPrecioComMin, FiltroPrecioComMax);
            r = AplicarFiltroRangoDecimal(r, x => x.PreVen, FiltroPrecioVenMin, FiltroPrecioVenMax);

            if (!string.IsNullOrWhiteSpace(_filtroEstado))
            {
                var activo = _filtroEstado == "activos";
                r = r.Where(x => x.EstLot == activo);
            }

            // Fecha compra
            if (!string.IsNullOrWhiteSpace(_filtroPeriodoCompra) ||
                PeriodoCompraDesde.HasValue || PeriodoCompraHasta.HasValue)
            {
                var now = DateTime.Now;
                DateTime? from = null;
                DateTime? to = null;

                switch (_filtroPeriodoCompra)
                {
                    case "week":
                        from = now.AddDays(-7).Date;
                        break;
                    case "month":
                        from = now.AddDays(-30).Date;
                        break;
                    case "year":
                        from = now.AddYears(-1).Date;
                        break;
                    case "custom":
                        if (PeriodoCompraDesde.HasValue)
                            from = PeriodoCompraDesde.Value.Date;
                        if (PeriodoCompraHasta.HasValue)
                            to = PeriodoCompraHasta.Value.Date;
                        break;
                }

                if (string.IsNullOrWhiteSpace(_filtroPeriodoCompra) &&
                    (PeriodoCompraDesde.HasValue || PeriodoCompraHasta.HasValue))
                {
                    from ??= PeriodoCompraDesde?.Date;
                    to ??= PeriodoCompraHasta?.Date;
                }

                if (from.HasValue || to.HasValue)
                {
                    r = r.Where(x =>
                    {
                        var fecha = x.FecCom.Date;
                        if (from.HasValue && fecha < from.Value) return false;
                        if (to.HasValue && fecha > to.Value) return false;
                        return true;
                    });
                }
            }

            // Fecha expiración
            if (!string.IsNullOrWhiteSpace(_filtroPeriodoExp) ||
                PeriodoExpDesde.HasValue || PeriodoExpHasta.HasValue)
            {
                var now = DateTime.Now;
                DateTime? from = null;
                DateTime? to = null;

                switch (_filtroPeriodoExp)
                {
                    case "week":
                        from = now.Date;
                        to = now.AddDays(7).Date;
                        break;
                    case "month":
                        from = now.Date;
                        to = now.AddDays(30).Date;
                        break;
                    case "year":
                        from = now.Date;
                        to = now.AddYears(1).Date;
                        break;
                    case "custom":
                        if (PeriodoExpDesde.HasValue)
                            from = PeriodoExpDesde.Value.Date;
                        if (PeriodoExpHasta.HasValue)
                            to = PeriodoExpHasta.Value.Date;
                        break;
                }

                if (string.IsNullOrWhiteSpace(_filtroPeriodoExp) &&
                    (PeriodoExpDesde.HasValue || PeriodoExpHasta.HasValue))
                {
                    from ??= PeriodoExpDesde?.Date;
                    to ??= PeriodoExpHasta?.Date;
                }

                if (from.HasValue || to.HasValue)
                {
                    r = r.Where(x =>
                    {
                        var fecha = x.FecExp.Date;
                        if (from.HasValue && fecha < from.Value) return false;
                        if (to.HasValue && fecha > to.Value) return false;
                        return true;
                    });
                }
            }

            r = Ordenar(r);
            return r.ToList();
        }
    }

    private IEnumerable<RowVM> AplicarFiltroRangoDecimal(
        IEnumerable<RowVM> src,
        Func<RowVM, decimal?> selector,
        decimal? min,
        decimal? max)
    {
        var tieneMin = min.HasValue;
        var tieneMax = max.HasValue;

        if (!tieneMin && !tieneMax) return src;

        return src.Where(x =>
        {
            var v = selector(x);
            if (!v.HasValue) return false;
            if (tieneMin && v.Value < min.Value) return false;
            if (tieneMax && v.Value > max.Value) return false;
            return true;
        });
    }

    private int FilteredCount => Filtered.Count;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)pageSize));

    private List<RowVM> Paged =>
        Filtered
            .Skip((pageIndex - 1) * pageSize)
            .Take(pageSize)
            .ToList();

    // Ordenamiento
    private IEnumerable<RowVM> Ordenar(IEnumerable<RowVM> src)
    {
        if (string.IsNullOrWhiteSpace(sortBy))
            return src;

        Func<RowVM, object?> key = sortBy switch
        {
            nameof(RowVM.CodLot) => x => x.CodLot ?? string.Empty,
            nameof(RowVM.NombreProducto) => x => x.NombreProducto ?? string.Empty,
            nameof(RowVM.NombreCategoria) => x => x.NombreCategoria ?? string.Empty,
            nameof(RowVM.FecCom) => x => x.FecCom.Ticks,
            nameof(RowVM.FecExp) => x => x.FecExp.Ticks,
            nameof(RowVM.CanLot) => x => x.CanLot,
            nameof(RowVM.CanDis) => x => x.CanDis,
            nameof(RowVM.PreCom) => x => x.PreCom,
            nameof(RowVM.PreVen) => x => x.PreVen,
            _ => x => x.CodLot ?? string.Empty
        };

        return sortAsc ? src.OrderBy(key) : src.OrderByDescending(key);
    }

    private void OrdenarPor(string prop)
    {
        if (sortBy == prop)
        {
            sortAsc = !sortAsc;
        }
        else
        {
            sortBy = prop;
            sortAsc = true;
        }

        pageIndex = 1;
    }

    private string IconoOrden(string prop) =>
        sortBy != prop ? string.Empty : (sortAsc ? "↑" : "↓");

    private void PrevPage()
    {
        if (pageIndex > 1) pageIndex--;
    }

    private void NextPage()
    {
        if (pageIndex < TotalPages) pageIndex++;
    }

    // Navegación
    private void IrAEditar(RowVM r)
    {
        if (r.Id <= 0) return;
        Navigation.NavigateTo($"/dashboards/lotes/editar/{r.Id}");
    }

    private void SeleccionarCategoria(string categoria)
    {
        categoriaSeleccionada = categoria;
        pageIndex = 1;
    }

    // Utilidades
    private static bool ContainsIgnoreCase(string? source, string? value)
    {
        if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(value))
            return false;

        return source.IndexOf(value, StringComparison.OrdinalIgnoreCase) >= 0;
    }

    private static string FormatMoney(decimal v) => v.ToString("N2");

    private sealed class RowVM
    {
        public int Id { get; init; }
        public string? CodLot { get; init; }
        public string NombreProducto { get; init; } = string.Empty;
        public string NombreCategoria { get; init; } = string.Empty;
        public string NombreTipoTributario { get; init; } = string.Empty;
        public DateTime FecCom { get; init; }
        public DateTime FecExp { get; init; }
        public int CanLot { get; init; }
        public int CanDis { get; init; }
        public decimal PreCom { get; init; }
        public decimal PreVen { get; init; }
        public bool EstLot { get; set; }
    }
