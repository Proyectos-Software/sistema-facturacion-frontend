                                        <div class="mb-3">
                                            <label class="form-label">Tipo de RUC</label>
                                            <InputSelect class="form-select" @bind-Value="_formCliente.TipoRucPersona">
                                                <option value="">-- Selecciona --</option>
                                                <option value="NATURAL">Persona natural</option>
                                                <option value="JURIDICA">Persona jurídica (empresa)</option>
                                            </InputSelect>
                                            <small class="text-muted d-block mt-1">
                                                Define si el RUC pertenece a una persona natural o a una empresa.
                                            </small>
                                            <ValidationMessage For="@(() => _formCliente.TipoRucPersona)" />
