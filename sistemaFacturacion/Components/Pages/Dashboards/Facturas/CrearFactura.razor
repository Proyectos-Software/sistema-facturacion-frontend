                </div>

                <div class="modal-body">
                    <EditForm Model="@_formCliente" OnValidSubmit="@CrearClienteAsync">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-lg-5">
                                <div class="rounded-3 h-100 border p-3">
                                    <h6 class="fw-semibold fs-14 d-flex align-items-center mb-3 gap-2">
                                        <i class="ri-id-card-line text-primary fs-5"></i>
                                        <span>Datos de identificación</span>
                                    </h6>

                                    <div class="mb-3">
                                        <label class="form-label">Tipo de identificación</label>
                                        <InputSelect class="form-select" @bind-Value="_formCliente.TipoIdentificacion">
