    private sealed class FacturaItemModel
    {
        public int? ProductoId { get; set; }
        public string NombreProducto { get; set; } = string.Empty;
        public int Cantidad { get; set; } = 1;
        public decimal PrecioUnitario { get; set; } = 0m;
        public int TarifaTributaria { get; set; } = 0;
        public decimal Subtotal => Cantidad * PrecioUnitario;
    }

    public class ClienteCreateVM : IValidatableObject
    {
        [Required(ErrorMessage = "Seleccione el tipo de identificación.")]
        public string? TipoIdentificacion { get; set; }

        public string? TipoRucPersona { get; set; }

        [Required(ErrorMessage = "La identificación es obligatoria.")]
        public string? Identificacion { get; set; }

        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [RegularExpression(@"^[A-Za-zÁÉÍÓÚáéíóúÑñ\s]+$", ErrorMessage = "El nombre solo debe contener letras.")]
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string? Nombre { get; set; }

        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string? Apellido { get; set; }

        [Required(ErrorMessage = "La dirección es obligatoria.")]
        [RegularExpression(@"^[A-Za-zÁÉÍÓÚáéíóúÑñ\s0-9,.-]+$", ErrorMessage = "La dirección contiene caracteres inválidos.")]
        [StringLength(200, ErrorMessage = "Máximo 200 caracteres.")]
        public string? Direccion { get; set; }

        [Required(ErrorMessage = "El teléfono es obligatorio.")]
        [RegularExpression(@"^\d{10}$", ErrorMessage = "El teléfono debe tener 10 dígitos.")]
        public string? Telefono { get; set; }

        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Correo inválido.")]
        public string? Correo { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var tipo = (TipoIdentificacion ?? "").Trim().ToUpperInvariant();
            var id = (Identificacion ?? "").Trim();
            var tipoRuc = (TipoRucPersona ?? "").Trim().ToUpperInvariant();

            if (string.IsNullOrWhiteSpace(tipo) || string.IsNullOrWhiteSpace(id))
                yield break;

            var esRuc = tipo == "RUC";
            var esRucJuridico = esRuc && tipoRuc == "JURIDICA";

            if (tipo is "CEDULA" or "RUC")
            {
                if (!id.All(char.IsDigit))
                    yield return new ValidationResult("Solo se permiten dígitos.", new[] { nameof(Identificacion) });
            }

            if (esRuc && string.IsNullOrWhiteSpace(TipoRucPersona))
            {
                yield return new ValidationResult(
                    "Seleccione si el RUC es de persona natural o jurídica.",
                    new[] { nameof(TipoRucPersona) });
            }

            if (!esRucJuridico)
            {
                if (string.IsNullOrWhiteSpace(Apellido))
                {
                    yield return new ValidationResult(
                        "El apellido es obligatorio para personas naturales.",
                        new[] { nameof(Apellido) });
                }
            }
        }
    }
}
