                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" @onclick="CerrarModalCrearCliente" disabled="@_isSavingCliente">
                                <i class="ri-close-line me-1"></i>Cancelar
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSavingCliente">
                                <i class="ri-save-line me-1"></i>
                                @(_isSavingCliente ? "Guardando..." : "Guardar Cliente")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _mostrarModal = false;
    private bool _mostrarModalProductos = false;
    private bool _mostrarModalCrearCliente = false;
    private bool _isSavingCliente = false;

    // Variables para la búsqueda dinámica con autocompletado
    private bool _mostrarSugerencias = false;
    private List<ClienteDto> _todosLosClientes = new(); // Carga local para filtrado rápido
    private List<ClienteDto> _sugerenciasClientes = new();

    // Variables para el modal de crear cliente
    private ClienteCreateVM _formCliente = new();

    // Variables para el modal de productos
    private string _busquedaModalProductos = string.Empty;
    private string _categoriaFiltroModal = string.Empty;
    private List<ProductoDto> _productosFiltradosModal = new();
    private HashSet<int> _productosSeleccionados = new();
    private List<string> _categoriasDisponibles = new();
    private bool _seleccionarTodos = false;

    private int _idUsu;
    private int _idEmp = 18;
    private int _idEmpresa = 4;
    private string _nombreUsuario = string.Empty;
    private DateTime _fechaEmision = DateTime.Now;

    private string _tipoDocumentoSeleccionado = "CEDULA"; // Valor por defecto
    private string _busquedaDocumento = string.Empty;
    private ClienteDto? _clienteSeleccionado;

    private List<ProductoDto> _productos = new();
    private List<ProductoDto> _productosConStock = new();
    private List<LoteDto> _todosLosLotes = new();
    private Dictionary<int, int> _stockPorProducto = new();
    private readonly List<FacturaItemModel> _items = new();

    // Búsqueda dinámica de productos
    private readonly Dictionary<FacturaItemModel, bool> _mostrarSugerenciasProducto = new();
    private readonly Dictionary<FacturaItemModel, List<ProductoDto>> _sugerenciasProductos = new();

    // --- LÓGICA DE IMPUESTOS ---
    private decimal _subtotalIva0 => _items
        .Where(i => i.TarifaTributaria == 0)
        .Sum(i => i.Subtotal);

    private decimal _subtotalIva15 => _items
        .Where(i => i.TarifaTributaria == 15)
        .Sum(i => i.Subtotal);

    private decimal _iva => _items.Sum(i =>
        i.Subtotal * (i.TarifaTributaria / 100m)
    );

    private decimal _subtotal => _subtotalIva0 + _subtotalIva15;
    private decimal _total => _subtotal + _iva;

    private bool PuedeGuardar =>
        _clienteSeleccionado is not null &&
        _items.Any(i => i.ProductoId.HasValue && i.Cantidad > 0) &&
        _idUsu != 0;

    private IEnumerable<ProductoDto> ObtenerFuenteProductosBusqueda()
    {
        return _productosConStock != null && _productosConStock.Any()
            ? _productosConStock
            : _productos;
    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarUsuarioActualAsync();

            var tProductos = CargarProductosAsync();
            var tLotes = CargarLotesAsync();
            var tClientes = CargarTodosLosClientesAsync();
            await Task.WhenAll(tProductos, tLotes, tClientes);

            CalcularStockPorProducto();

            _productosConStock = _productos
                .Where(p => GetStockProducto(p.Id) > 0)
                .OrderBy(p => p.Nombre)
                .ToList();

            _categoriasDisponibles = _productosConStock
                .Select(p => p.NombreCategoria ?? "Sin categoría")
                .Distinct()
                .OrderBy(c => c)
                .ToList();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", $"Error durante la inicialización: {ex.Message}", "error");
        }

        _isLoading = false;
    }

    private async Task CargarTodosLosClientesAsync()
    {
        try
        {
            _todosLosClientes = await ClientesApi.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando clientes para autocompletado: " + ex.Message);
        }
    }

    private void OnInputBusqueda(ChangeEventArgs e)
    {
        _busquedaDocumento = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_busquedaDocumento))
        {
            _sugerenciasClientes.Clear();
            _mostrarSugerencias = false;
            return;
        }

        _sugerenciasClientes = _todosLosClientes
            .Where(c => c.TipCli == _tipoDocumentoSeleccionado)
            .Where(c =>
                ContainsIgnoreCase(c.IdeCli, _busquedaDocumento) ||
                ContainsIgnoreCase(c.NomCli, _busquedaDocumento) ||
                ContainsIgnoreCase(c.ApeCli, _busquedaDocumento)
            )
            .Take(8)
            .ToList();

        _mostrarSugerencias = _sugerenciasClientes.Any();
    }

    private void SeleccionarSugerencia(ClienteDto cliente)
    {
        _busquedaDocumento = cliente.IdeCli;
        _tipoDocumentoSeleccionado = cliente.TipCli;
        _mostrarSugerencias = false;
        _clienteSeleccionado = cliente;
    }

    private async Task OcultarSugerenciasDelay()
    {
        await Task.Delay(200);
        _mostrarSugerencias = false;
    }

    private static bool ContainsIgnoreCase(string? source, string? value)
    {
        if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(value))
            return false;
        return source.IndexOf(value, StringComparison.OrdinalIgnoreCase) >= 0;
    }

    private async Task CargarUsuarioActualAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var idUsuClaim = user.FindFirst("idUsu")?.Value;
        if (int.TryParse(idUsuClaim, out var idUsu))
        {
            _idUsu = idUsu;
        }

        _nombreUsuario = user.Identity?.Name ?? "Usuario";
    }

    private async Task CargarProductosAsync()
    {
        try
        {
            _productos = await ProductosApi.GetAllAsync();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", $"No se pudieron cargar los productos: {ex.Message}", "error");
        }
    }

    private async Task CargarLotesAsync()
    {
        try
        {
            _todosLosLotes = await LotesApi.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando lotes: " + ex.Message);
        }
    }

    private void CalcularStockPorProducto()
    {
        _stockPorProducto = _todosLosLotes
            .Where(l => l.EstLot) 
            .GroupBy(l => l.IdPro)
            .ToDictionary(
                g => g.Key,
                g => g.Sum(l => Math.Max(0, l.CanDis)) 
            );
    }

    private int GetStockProducto(int idProducto)
    {
        if (_todosLosLotes == null || !_todosLosLotes.Any())
        {
            return 0;
        }

        return _todosLosLotes
            .Where(l => l.IdPro == idProducto && l.EstLot) 
            .Sum(l => Math.Max(0, l.CanDis));             
    }

    private string GetProductoNombre(FacturaItemModel item)
    {
        return item.NombreProducto ?? string.Empty;
    }

    private void OnInputBusquedaProducto(FacturaItemModel item, ChangeEventArgs e)
    {
        var busqueda = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(busqueda))
        {
            _sugerenciasProductos[item] = new List<ProductoDto>();
            _mostrarSugerenciasProducto[item] = false;
            return;
        }

        var sugerencias = _productosConStock
            .Where(p =>
                ContainsIgnoreCase(p.Nombre, busqueda) ||
                ContainsIgnoreCase(p.Codigo, busqueda)
            )
            .Take(8)
            .ToList();

        _sugerenciasProductos[item] = sugerencias;
        _mostrarSugerenciasProducto[item] = sugerencias.Any();
    }


    private void SeleccionarProducto(FacturaItemModel item, ProductoDto producto)
    {
        // Verificar si el producto ya está en otra fila
        if (_items.Any(i => i != item && i.ProductoId == producto.Id))
        {
            _mostrarSugerenciasProducto[item] = false;
            _sugerenciasProductos[item] = new List<ProductoDto>();
            return;
        }

        // Utilizar el método auxiliar compartido para configurar el producto
        ConfigurarProductoEnItem(item, producto);

        _mostrarSugerenciasProducto[item] = false;
        _sugerenciasProductos[item] = new List<ProductoDto>();
    }

    // Método auxiliar compartido para configurar un producto en un item
    private void ConfigurarProductoEnItem(FacturaItemModel item, ProductoDto producto)
    {
        item.ProductoId = producto.Id;
        item.NombreProducto = producto.Nombre;
        item.PrecioUnitario = producto.PrecioVenta;
        item.Cantidad = 1;
        item.TarifaTributaria = producto.IdTipoTributario switch
        {
            1 => 0,   // IVA 0%
            2 => 15,  // IVA 15%
            _ => 0
        };
    }

    private void LimpiarProducto(FacturaItemModel item)
    {
        item.ProductoId = null;
        item.NombreProducto = string.Empty;
        item.PrecioUnitario = 0;
        item.TarifaTributaria = 0;
        item.Cantidad = 1;
    }

    private async Task OcultarSugerenciasProductoDelay(FacturaItemModel item)
    {
        await Task.Delay(200);
        _mostrarSugerenciasProducto[item] = false;
    }

    private void AbrirModalProductos()
    {
        _mostrarModalProductos = true;
        _busquedaModalProductos = string.Empty;
        _categoriaFiltroModal = string.Empty;
        _productosSeleccionados.Clear();
        _seleccionarTodos = false;

        FiltrarProductosModal();
    }


    private void CerrarModalProductos()
    {
        _mostrarModalProductos = false;
        _productosSeleccionados.Clear();
        _seleccionarTodos = false;
    }

    private void FiltrarProductosModal()
    {
        var query = _productosConStock.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_busquedaModalProductos))
        {
            query = query.Where(p =>
                ContainsIgnoreCase(p.Codigo, _busquedaModalProductos) ||
                ContainsIgnoreCase(p.Nombre, _busquedaModalProductos) ||
                ContainsIgnoreCase(p.Descripcion, _busquedaModalProductos)
            );
        }

        if (!string.IsNullOrWhiteSpace(_categoriaFiltroModal))
        {
            query = query.Where(p => (p.NombreCategoria ?? "Sin categoría") == _categoriaFiltroModal);
        }

        _productosFiltradosModal = query
            .OrderBy(p => p.Nombre)
            .ToList();

        if (_productosFiltradosModal.Any())
        {
            _seleccionarTodos = _productosFiltradosModal.All(p => _productosSeleccionados.Contains(p.Id));
        }
        else
        {
            _seleccionarTodos = false;
        }
    }

    private void ToggleSeleccionProducto(int productoId)
    {
        if (_productosSeleccionados.Contains(productoId))
        {
            _productosSeleccionados.Remove(productoId);
        }
        else
        {
            _productosSeleccionados.Add(productoId);
        }

        _seleccionarTodos = _productosFiltradosModal.Any() &&
                            _productosFiltradosModal.All(p => _productosSeleccionados.Contains(p.Id));
    }

    private void ToggleSeleccionarTodos()
    {
        _seleccionarTodos = !_seleccionarTodos;

        if (_seleccionarTodos)
        {
            foreach (var producto in _productosFiltradosModal)
            {
                _productosSeleccionados.Add(producto.Id);
            }
        }
        else
        {
            foreach (var producto in _productosFiltradosModal)
            {
                _productosSeleccionados.Remove(producto.Id);
            }
        }
    }

    private void AgregarProductosSeleccionados()
    {
        if (!_productosSeleccionados.Any())
        {
            return;
        }

        var productosAgregar = _productosConStock
            .Where(p => _productosSeleccionados.Contains(p.Id))
            .Where(p => GetStockProducto(p.Id) > 0) // seguridad adicional
            .ToList();

        var filasVacias = _items.Where(i => !i.ProductoId.HasValue).ToList();

        foreach (var producto in productosAgregar)
        {
            if (_items.Any(i => i.ProductoId == producto.Id))
            {
                continue;
            }

            FacturaItemModel item;

            if (filasVacias.Any())
            {
                item = filasVacias.First();
                filasVacias.Remove(item);
            }
            else
            {
                item = new FacturaItemModel();
                _items.Add(item);
            }

            ConfigurarProductoEnItem(item, producto);
        }

        CerrarModalProductos();
    }

    private void LimpiarFiltrosModal()
    {
        _busquedaModalProductos = string.Empty;
        _categoriaFiltroModal = string.Empty;
        FiltrarProductosModal();
    }

    private async Task BuscarClienteAsync()
    {
        if (_clienteSeleccionado != null && _clienteSeleccionado.IdeCli == _busquedaDocumento) return;

        if (string.IsNullOrWhiteSpace(_tipoDocumentoSeleccionado))
        {
            await Swal.FireAsync("Atención", "Seleccione el tipo de documento.", "warning");
            return;
        }

        if (string.IsNullOrWhiteSpace(_busquedaDocumento))
        {
            await Swal.FireAsync("Atención", "Ingrese el número del documento o nombre.", "warning");
            return;
        }

        try
        {
            var clienteLocal = _todosLosClientes.FirstOrDefault(c => c.IdeCli == _busquedaDocumento && c.TipCli == _tipoDocumentoSeleccionado);

            if (clienteLocal != null)
            {
                _clienteSeleccionado = clienteLocal;
            }
            else
            {
                _clienteSeleccionado = await ClientesApi.GetByDocumentoAsync(
                    _tipoDocumentoSeleccionado,
                    _busquedaDocumento
                );
            }

            if (_clienteSeleccionado is null)
            {
                await Swal.FireAsync("Sin resultados",
                    $"No se encontró un cliente con {_tipoDocumentoSeleccionado} {_busquedaDocumento}.",
                    "info");
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", $"Error al buscar cliente: {ex.Message}", "error");
        }
    }

    private void LimpiarCliente()
    {
        _clienteSeleccionado = null;
        _busquedaDocumento = string.Empty;
    }

    private void AgregarItem()
    {
        _items.Add(new FacturaItemModel());
    }

    private void EliminarItem(int index)
    {
        if (index >= 0 && index < _items.Count)
        {
            _items.RemoveAt(index);
        }
    }

    private void OnCantidadChanged(FacturaItemModel item, ChangeEventArgs e)
    {
        if (!item.ProductoId.HasValue)
        {
            item.Cantidad = 1;
            return;
        }

        var stockDisponible = GetStockProducto(item.ProductoId.Value);

        if (stockDisponible <= 0)
        {
            item.Cantidad = 0;
            return;
        }

        if (!int.TryParse(e.Value?.ToString(), out var cantIngresada) || cantIngresada <= 0)
        {
            item.Cantidad = Math.Min(1, stockDisponible);
            return;
        }

        item.Cantidad = cantIngresada > stockDisponible
            ? stockDisponible
            : cantIngresada;
    }

    private void MostrarModalConfirmacion()
    {
        if (!PuedeGuardar)
        {
            return;
        }
        _mostrarModal = true;
    }

    private void CerrarModal()
    {
        if (!_isSaving)
        {
            _mostrarModal = false;
        }
    }

    private async Task ConfirmarYGuardarAsync()
    {
        _isSaving = true;
        StateHasChanged(); // ← fuerza refresco inmediato del botón con spinner

        var detallesValidos = _items
            .Where(i => i.ProductoId.HasValue && i.Cantidad > 0)
            .ToList();

        var request = new FacturaCreateRequest
        {
            IdCli = _clienteSeleccionado!.IdCli,
            IdEmp = _idEmp,
            IdUsu = _idUsu,
            IdEmpresa = _idEmpresa,
            Detalles = detallesValidos
                .Select(i => new FacturaDetalleCreateRequest
                {
                    IdPro = i.ProductoId!.Value,
                    Cantidad = i.Cantidad
                })
                .ToList()
        };

        try
        {
            var facturaCreada = await FacturasApi.CrearFacturaAsync(request);

            _isSaving = false;
            _mostrarModal = false;

            await Swal.FireAsync(
                "¡Éxito!",
                $"Factura #{facturaCreada.NumFac} creada, firmada y enviada correctamente.",
                "success"
            );

            NavigationManager.NavigateTo("/dashboards/facturas");
        }
        catch (Exception ex)
        {
            _isSaving = false;
            await Swal.FireAsync("Error", $"Error al crear la factura: {ex.Message}", "error");
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/dashboards/facturas");
    }

