@page "/dashboards/facturas/crear"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using sistemaFacturacion.Models
@using sistemaFacturacion.Services
@using CurrieTechnologies.Razor.SweetAlert2
@inject IClientesApiClient ClientesApi
@inject IProductosApiClient ProductosApi
@inject ILotesApiClient LotesApi
@inject IFacturasApiClient FacturasApi
@inject AuthenticationStateProvider AuthStateProvider
@inject SweetAlertService Swal
@inject NavigationManager NavigationManager

<div class="page-header-breadcrumb mb-4">
    <div class="d-flex align-center justify-content-between flex-wrap">
        <h1 class="page-title fw-medium fs-18 mb-0">
            <i class="ri-file-add-line me-2"></i>Crear Nueva Factura
        </h1>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="javascript:void(0);">Ventas</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nueva Factura</li>
        </ol>
    </div>
</div>

@if (_isLoading)
{
    <div class="py-5 text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="text-muted mt-3">Cargando datos del sistema...</p>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card custom-card mb-3 shadow-sm @(_mostrarSugerencias ? "dropdown-activo" : "")"
                 style="overflow: visible;">
                <div class="card-header bg-primary-transparent">
                    <div class="d-flex align-items-center">
                        <i class="ri-user-line fs-20 text-primary me-2"></i>
                        <h5 class="fw-semibold mb-0">Cliente</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8 position-relative">
                            <label class="form-label fw-medium">
                                Tipo de identificación <span class="text-danger">*</span>
                            </label>

                            <div class="input-group mb-2">
                                <span class="input-group-text bg-light">
                                    <i class="ri-id-card-line"></i>
                                </span>
                                <select class="form-select"
                                        value="@_tipoDocumentoSeleccionado"
                                        @onchange="OnTipoDocumentoChanged">
                                    <option value="CEDULA">Cédula</option>
                                    <option value="RUC">RUC</option>
                                    <option value="PASAPORTE">Pasaporte</option>
                                    <option value="07">Consumidor Final</option>
                                </select>


                            </div>

                            @if (_tipoDocumentoSeleccionado != "07")
                            {
                                <label class="form-label fw-medium mt-2">
                                    Buscar Cliente (Identificación o Nombre) <span class="text-danger">*</span>
                                </label>

                                <div class="input-group mb-2">
                                    <span class="input-group-text bg-light">
                                        <i class="ri-search-line"></i>
                                    </span>

                                    <input type="text"
                                           class="form-control"
                                           placeholder="Escriba identificación o nombre..."
                                           @bind="_busquedaDocumento"
                                           @oninput="OnInputBusqueda"
                                           @onfocusout="OcultarSugerenciasDelay"
                                           autocomplete="off" />

                                    <button class="btn btn-primary"
                                            type="button"
                                            @onclick="BuscarClienteAsync">
                                        <i class="ri-check-line me-1"></i> Cargar
                                    </button>
                                </div>

                                <!-- ESTE botón es el correcto -->
                                <button class="btn btn-sm btn-outline-primary w-100"
                                        type="button"
                                        @onclick="AbrirModalCrearCliente">
                                    <i class="ri-user-add-line me-1"></i>Crear Nuevo Cliente
                                </button>
                            }
                            else
                            {
                                <div class="alert alert-info mt-3">
                                    <i class="ri-information-line me-2"></i>
                                    Consumidor Final seleccionado automáticamente.
                                </div>
                            }  

                            @if (_mostrarSugerencias && _sugerenciasClientes.Any())
                            {
                                <div class="autocomplete-dropdown-custom">
                                    @foreach (var c in _sugerenciasClientes)
                                    {
                                        var esPersonaJuridica = c.ApeCli?.Contains("-") ?? false;
                                        <button type="button" class="autocomplete-item-custom"
                                                @onmousedown="() => SeleccionarSugerencia(c)">
                                            <div class="d-flex align-items-center w-100">
                                                <div class="autocomplete-avatar">
                                                    <i class="@(esPersonaJuridica ? "ri-building-line" : "ri-user-3-line")"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-semibold text-dark">
                                                        @(esPersonaJuridica? c.NomCli: $"{c.NomCli} {c.ApeCli}")
                                                    </div>
                                                    <small class="text-muted">
                                                        <i class="ri-bank-card-line me-1"></i>@c.IdeCli
                                                    </small>
                                                </div>
                                                <span class="badge bg-primary-transparent">@c.TipCli</span>
                                            </div>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @if (_clienteSeleccionado is not null)
                    {
                        var esPersonaJuridicaSeleccionada = _clienteSeleccionado.ApeCli?.Contains("-") ?? false;
                        <div class="bg-light rounded-3 border-success mt-3 border p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="badge bg-success-transparent me-2">
                                            <i class="ri-checkbox-circle-line"></i> Seleccionado
                                        </span>
                                        <span class="badge bg-info-transparent">
                                            <i class="@(esPersonaJuridicaSeleccionada ? "ri-building-line" : "ri-user-3-line") me-1"></i>
                                            @(esPersonaJuridicaSeleccionada ? "Empresa" : "Persona Natural")
                                        </span>
                                    </div>
                                    <h6 class="fw-bold mb-2">
                                        @(esPersonaJuridicaSeleccionada? _clienteSeleccionado.NomCli: $"{_clienteSeleccionado.NomCli} {_clienteSeleccionado.ApeCli}")
                                    </h6>
                                    <div class="row g-2 small text-muted">
                                        <div class="col-md-6">
                                            <i class="ri-bank-card-line me-1"></i>
                                            <strong>ID:</strong> @_clienteSeleccionado.IdeCli
                                        </div>
                                        <div class="col-md-6">
                                            <i class="ri-phone-line me-1"></i>
                                            <strong>Tel:</strong> @_clienteSeleccionado.TelCli
                                        </div>
                                        <div class="col-12">
                                            <i class="ri-mail-line me-1"></i>
                                            <strong>Email:</strong> @_clienteSeleccionado.CorCli
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-danger-light" @onclick="LimpiarCliente" title="Cambiar cliente">
                                    <i class="ri-close-line"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card custom-card shadow-sm">
                <div class="card-header bg-info-transparent">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="ri-shopping-cart-line fs-20 text-info me-2"></i>
                            <h5 class="fw-semibold mb-0">Productos</h5>
                        </div>
                        @* Botón "Cargar Productos" eliminado según requerimiento *@
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (_items.Any())
                    {
                        <div class="table-responsive">
                            <table class="table-hover mb-0 table">
                                <thead class="table-light">
                                    <tr>
                                        <th width="5%" class="text-center">#</th>
                                        <th width="45%">Producto</th>
                                        <th width="15%" class="text-center">Cantidad</th>
                                        <th width="15%" class="text-end">P. Unit.</th>
                                        <th width="15%" class="text-end">Subtotal</th>
                                        <th width="5%" class="text-center">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < _items.Count; i++)
                                    {
                                        var index = i;
                                        var item = _items[i];
                                        <tr class="align-middle">
                                            <td class="fw-bold text-muted text-center">@(i + 1)</td>
                                            <td class="position-relative">
                                                <div class="input-group input-group-sm">
                                                    <input type="text"
                                                           class="form-control @(item.ProductoId.HasValue ? "border-success" : "")"
                                                           placeholder="Buscar producto..."
                                                           value="@GetProductoNombre(item)"
                                                           @oninput="e => OnInputBusquedaProducto(item, e)"
                                                           @onfocusout="() => OcultarSugerenciasProductoDelay(item)"
                                                           autocomplete="off" />
                                                    @if (item.ProductoId.HasValue)
                                                    {
                                                        <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => LimpiarProducto(item)">
                                                            <i class="ri-close-line"></i>
                                                        </button>
                                                    }
                                                </div>

                                                @if (_mostrarSugerenciasProducto.GetValueOrDefault(item, false) && _sugerenciasProductos.GetValueOrDefault(item, new()).Any())
                                                {
                                                    <div class="autocomplete-dropdown-productos">
                                                        @foreach (var p in _sugerenciasProductos[item])
                                                        {
                                                            <button type="button" class="autocomplete-item-producto"
                                                                    @onmousedown="() => SeleccionarProducto(item, p)">
                                                                <div class="d-flex justify-content-between w-100">
                                                                    <div class="flex-grow-1">
                                                                        <div class="fw-semibold">@p.Nombre</div>
                                                                        <small class="text-muted">Código: @p.Codigo</small>
                                                                    </div>
                                                                    <div class="text-end">
                                                                        <div class="badge bg-success-subtle text-success">
                                                                            Stock: @GetStockProducto(p.Id)
                                                                        </div>
                                                                        <small class="text-muted d-block">$@p.PrecioVenta.ToString("N2")</small>
                                                                    </div>
                                                                </div>
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <input type="number"
                                                       class="form-control form-control-sm text-center"
                                                       min="1"
                                                       value="@item.Cantidad"
                                                       @onchange="e => OnCantidadChanged(item, e)"
                                                       disabled="@(!item.ProductoId.HasValue)" />
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-secondary-transparent">
                                                    $@item.PrecioUnitario.ToString("N2")
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <span class="fw-bold text-primary">
                                                    $@item.Subtotal.ToString("N2")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-danger-light"
                                                        @onclick="@(() => EliminarItem(index))"
                                                        title="Eliminar item">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    <tr class="bg-light-hover">
                                        <td colspan="6" class="p-0">
                                            <div class="d-flex">
                                                <button class="btn btn-link text-decoration-none fw-medium flex-fill py-2 ps-4 text-start"
                                                        style="border-radius: 0; color: var(--primary-color);"
                                                        @onclick="AbrirModalProductos">
                                                    <i class="ri-add-circle-line fs-16 me-2 align-middle"></i>Seleccionar productos desde lista
                                                </button>
                                                <button class="btn btn-link text-decoration-none fw-medium py-2 pe-4 text-end"
                                                        style="border-radius: 0; border-left: 1px solid #e9ecef; color: #6366f1;"
                                                        @onclick="AgregarItem">
                                                    <i class="ri-edit-2-line fs-16 me-2 align-middle"></i>Agregar línea manual
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="py-5 text-center">
                            <i class="ri-inbox-line fs-48 text-muted d-block mb-3 opacity-50"></i>
                            <p class="text-muted mb-2">No hay productos agregados</p>
                            <button class="btn btn-sm btn-primary" @onclick="AbrirModalProductos">
                                <i class="ri-add-line me-1"></i>Seleccionar productos desde lista
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card custom-card mb-3 shadow-sm">
                <div class="card-header bg-secondary-transparent">
                    <div class="d-flex align-items-center">
                        <i class="ri-information-line fs-20 me-2"></i>
                        <h6 class="fw-semibold mb-0">Información</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Fecha de emisión</label>
                        <input type="date"
                               class="form-control form-control-sm"
                               value="@_fechaEmision.ToString("yyyy-MM-dd")"
                               disabled />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small text-muted mb-1">Usuario</label>
                        <input type="text"
                               class="form-control form-control-sm"
                               value="@_nombreUsuario"
                               disabled />
                    </div>
                </div>
            </div>

            <div class="card custom-card mb-3 shadow-sm">
                <div class="card-header bg-success-transparent">
                    <div class="d-flex align-items-center">
                        <i class="ri-money-dollar-circle-line fs-20 text-success me-2"></i>
                        <h6 class="fw-semibold mb-0">Resumen</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center border-bottom mb-2 pb-2">
                        <span class="text-muted">Subtotal IVA 0%:</span>
                        <span class="fw-semibold">$@_subtotalIva0.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center border-bottom mb-2 pb-2">
                        <span class="text-muted">Subtotal IVA 15%:</span>
                        <span class="fw-semibold">$@_subtotalIva15.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center border-bottom mb-2 pb-2">
                        <span class="text-muted">IVA (15%):</span>
                        <span class="fw-semibold">$@_iva.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <span class="fw-bold fs-16">TOTAL:</span>
                        <span class="fw-bold text-success fs-20">$@_total.ToString("N2")</span>
                    </div>

                    <div class="alert alert-info mt-3 mb-0 border-0 py-2">
                        <small class="d-flex">
                            <i class="ri-information-line me-2 mt-1"></i>
                            <span>Los totales son referenciales. El cálculo final se realiza en el backend.</span>
                        </small>
                    </div>
                </div>
            </div>

            <div class="card custom-card shadow-sm">
                <div class="card-body">
                    <button class="btn btn-success btn-lg mb-2 w-100"
                            @onclick="MostrarModalConfirmacion"
                            disabled="@(!PuedeGuardar || _isSaving)">
                        <i class="ri-save-line me-2"></i>
                        @(_isSaving ? "Procesando..." : "Guardar Factura")
                    </button>
                    <button class="btn btn-light w-100" @onclick="Cancelar" disabled="@_isSaving">
                        <i class="ri-close-line me-1"></i>Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="ri-file-list-3-line me-2"></i>Confirmar Factura
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal" disabled="@_isSaving"></button>
                </div>
                <div class="modal-body">
                    @if (_clienteSeleccionado is not null)
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-primary mb-3">
                                <i class="ri-user-line me-2"></i>Información del Cliente
                            </h6>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Nombre:</small>
                                    <strong>@_clienteSeleccionado.NomCli @_clienteSeleccionado.ApeCli</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Identificación:</small>
                                    <strong>@_clienteSeleccionado.IdeCli</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Email:</small>
                                    <strong>@_clienteSeleccionado.CorCli</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Teléfono:</small>
                                    <strong>@_clienteSeleccionado.TelCli</strong>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="mb-4">
                            <h6 class="fw-bold text-primary mb-3">
                                <i class="ri-shopping-cart-line me-2"></i>Detalle de Productos
                            </h6>
                            <div class="table-responsive">
                                <table class="table-sm table-bordered mb-0 table">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="5%">#</th>
                                            <th width="45%">Producto</th>
                                            <th width="15%" class="text-center">Cantidad</th>
                                            <th width="17%" class="text-end">P. Unit.</th>
                                            <th width="18%" class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var detallesValidos = _items.Where(i => i.ProductoId.HasValue && i.Cantidad > 0).ToList();
                                        }
                                        @for (int i = 0; i < detallesValidos.Count; i++)
                                        {
                                            var item = detallesValidos[i];
                                            <tr>
                                                <td class="text-center">@(i + 1)</td>
                                                <td>@item.NombreProducto</td>
                                                <td class="text-center">@item.Cantidad</td>
                                                <td class="text-end">$@item.PrecioUnitario.ToString("N2")</td>
                                                <td class="fw-bold text-end">$@item.Subtotal.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <hr />

                        <div class="bg-light rounded p-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal IVA 0%:</span>
                                <span class="fw-semibold">$@_subtotalIva0.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal IVA 15%:</span>
                                <span class="fw-semibold">$@_subtotalIva15.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>IVA (15%):</span>
                                <span class="fw-semibold">$@_iva.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between border-top border-2 pt-2">
                                <span class="fw-bold fs-18">TOTAL:</span>
                                <span class="fw-bold text-success fs-20">$@_total.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="alert alert-warning mt-3 mb-0">
                            <small class="d-flex align-items-start">
                                <i class="ri-error-warning-line me-2 mt-1"></i>
                                <span>Por favor, verifique que todos los datos sean correctos antes de confirmar. Esta acción creará, firmará y enviará la factura al SRI.</span>
                            </small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" @onclick="CerrarModal" disabled="@_isSaving">
                        <i class="ri-close-line me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-success" @onclick="ConfirmarYGuardarAsync">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Procesando...</span>
                        }
                        else
                        {
                            <i class="ri-check-line me-1"></i>
                            <span>Confirmar y Guardar</span>
                        }
                    </button>

                </div>
            </div>
        </div>
    </div>
}

@* ========================================
   MODAL DE SELECCIÓN DE PRODUCTOS
   ======================================== *@
@if (_mostrarModalProductos)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content modal-productos">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="ri-shopping-basket-2-line me-2"></i>Seleccionar Productos
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalProductos"></button>
                </div>

                <div class="modal-header bg-light border-0 pt-3 pb-3">
                    <div class="w-100">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="ri-search-line"></i>
                                    </span>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Buscar por código o nombre del producto..."
                                           @bind="_busquedaModalProductos"
                                           @bind:event="oninput"
                                           @bind:after="FiltrarProductosModal"
                                           autocomplete="off" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" @bind="_categoriaFiltroModal" @bind:after="FiltrarProductosModal">
                                    <option value="">Todas las categorías</option>
                                    @foreach (var cat in _categoriasDisponibles)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex h-100 gap-2">
                                    <button class="btn btn-success flex-fill" @onclick="AgregarProductosSeleccionados" disabled="@(!_productosSeleccionados.Any())">
                                        <i class="ri-check-line me-1"></i>Agregar (@_productosSeleccionados.Count)
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-body p-0" style="max-height: 500px;">
                    @if (_productosFiltradosModal.Any())
                    {
                        <div class="table-responsive">
                            <table class="table-hover table-sm modal-productos-table mb-0 table">
                                <thead class="sticky-top" style="top: 0; z-index: 10;">
                                    <tr>
                                        <th width="5%" class="text-center">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   @onchange="ToggleSeleccionarTodos"
                                                   checked="@_seleccionarTodos" />
                                        </th>
                                        <th width="15%">Código</th>
                                        <th width="35%">Nombre</th>
                                        <th width="15%">Categoría</th>
                                        <th width="12%" class="text-end">Precio</th>
                                        <th width="10%" class="text-center">Stock</th>
                                        <th width="8%" class="text-center">IVA</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var producto in _productosFiltradosModal)
                                    {
                                        var stock = GetStockProducto(producto.Id);
                                        var isSelected = _productosSeleccionados.Contains(producto.Id);
                                        var rowClass = isSelected ? "table-primary" : "";

                                        <tr class="@rowClass" style="cursor: pointer;" @onclick="() => ToggleSeleccionProducto(producto.Id)">
                                            <td class="text-center" @onclick:stopPropagation="true">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       checked="@isSelected"
                                                       @onchange="() => ToggleSeleccionProducto(producto.Id)" />
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary-subtle text-dark">@producto.Codigo</span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@producto.Nombre</div>
                                                <small class="text-muted">@producto.Descripcion</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-info-subtle text-info">@producto.NombreCategoria</span>
                                            </td>
                                            <td class="text-end">
                                                <span class="fw-semibold text-success">$@producto.PrecioVenta.ToString("N2")</span>
                                            </td>
                                            <td class="text-center">
                                                @if (stock > 10)
                                                {
                                                    <span class="badge bg-success">@stock</span>
                                                }
                                                else if (stock > 0)
                                                {
                                                    <span class="badge bg-warning">@stock</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">0</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (producto.IdTipoTributario == 2)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning">15%</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">0%</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="py-5 text-center">
                            <i class="ri-search-line fs-48 text-muted opacity-50"></i>
                            <p class="text-muted mt-3">No se encontraron productos con los filtros aplicados</p>
                            <button class="btn btn-sm btn-primary" @onclick="LimpiarFiltrosModal">
                                <i class="ri-refresh-line me-1"></i>Limpiar filtros
                            </button>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <div class="text-muted small">
                            <i class="ri-information-line me-1"></i>
                            @_productosFiltradosModal.Count productos disponibles | @_productosSeleccionados.Count seleccionados
                        </div>
                        <div>
                            <button type="button" class="btn btn-light me-2" @onclick="CerrarModalProductos">
                                <i class="ri-close-line me-1"></i>Cancelar
                            </button>
                            <button type="button" class="btn btn-success" @onclick="AgregarProductosSeleccionados" disabled="@(!_productosSeleccionados.Any())">
                                <i class="ri-check-line me-1"></i>Agregar Seleccionados (@_productosSeleccionados.Count)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ========================================
   MODAL DE CREAR CLIENTE
   ======================================== *@
@if (_mostrarModalCrearCliente)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
