                                    <div class="mb-0">
                                        <label class="form-label">Identificación / RUC</label>
                                        <InputText class="form-control"
                                                   @bind-Value="_formCliente.Identificacion"
                                                   placeholder="@ObtenerPlaceholderIdentificacion()"
                                                   maxlength="@ObtenerMaxLengthIdentificacion()" />
                                        <small class="text-muted d-block mt-1">@ObtenerHelpTextIdentificacion()</small>
                                        <ValidationMessage For="@(() => _formCliente.Identificacion)" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-7">
                                <div class="rounded-3 h-100 border p-3">
                                    <h6 class="fw-semibold fs-14 d-flex align-items-center mb-3 gap-2">
                                        <i class="ri-user-3-line text-primary fs-5"></i>
                                        <span>Datos personales y de contacto</span>
                                    </h6>

                                    <div class="row g-3">
                                        @if (EsRucJuridicoCliente)
                                        {
                                            <div class="col-12">
                                                <label class="form-label">Nombre / Razón social</label>
                                                <InputText class="form-control"
                                                           @bind-Value="_formCliente.Nombre"
                                                           placeholder="Nombre comercial o razón social"
                                                           maxlength="100" />
                                                <ValidationMessage For="@(() => _formCliente.Nombre)" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-6">
                                                <label class="form-label">Nombre</label>
                                                <InputText class="form-control"
                                                           @bind-Value="_formCliente.Nombre"
                                                           placeholder="Nombres"
                                                           maxlength="100" />
                                                <ValidationMessage For="@(() => _formCliente.Nombre)" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Apellido</label>
                                                <InputText class="form-control"
                                                           @bind-Value="_formCliente.Apellido"
                                                           placeholder="Apellidos"
                                                           maxlength="100" />
                                                <ValidationMessage For="@(() => _formCliente.Apellido)" />
                                            </div>
                                        }

                                        <div class="col-12">
                                            <label class="form-label">Dirección</label>
                                            <InputText class="form-control"
                                                       @bind-Value="_formCliente.Direccion"
                                                       placeholder="Dirección"
                                                       maxlength="200" />
                                            <ValidationMessage For="@(() => _formCliente.Direccion)" />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Teléfono</label>
                                            <InputText class="form-control"
                                                       @bind-Value="_formCliente.Telefono"
                                                       placeholder="Ej: 0999999999"
                                                       maxlength="10" />
                                            <ValidationMessage For="@(() => _formCliente.Telefono)" />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Correo electrónico</label>
                                            <InputText class="form-control"
                                                       @bind-Value="_formCliente.Correo"
                                                       type="email"
                                                       placeholder="usuario@dominio.com" />
