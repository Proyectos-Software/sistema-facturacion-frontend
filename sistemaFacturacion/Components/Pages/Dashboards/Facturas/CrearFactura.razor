@page "/dashboards/facturas/crear"
@using Microsoft.AspNetCore.Components.Authorization
@using sistemaFacturacion.Models
@using sistemaFacturacion.Services
@using CurrieTechnologies.Razor.SweetAlert2
@inject IClientesApiClient ClientesApi
@inject IProductosApiClient ProductosApi
@inject IFacturasApiClient FacturasApi
@inject AuthenticationStateProvider AuthStateProvider
@inject SweetAlertService Swal
@inject NavigationManager NavigationManager

<div class="page-header-breadcrumb mb-4">
    <div class="d-flex align-center justify-content-between flex-wrap">
        <h1 class="page-title fw-medium fs-18 mb-0">
            <i class="ri-file-add-line me-2"></i>Crear Nueva Factura
        </h1>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="javascript:void(0);">Ventas</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nueva Factura</li>
        </ol>
    </div>
</div>

@if (_isLoading)
{
    <div class="py-5 text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="text-muted mt-3">Cargando datos del sistema...</p>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card custom-card mb-3 shadow-sm" style="overflow: visible;">
                <div class="card-header bg-primary-transparent">
                    <div class="d-flex align-items-center">
                        <i class="ri-user-line fs-20 text-primary me-2"></i>
                        <h5 class="fw-semibold mb-0">Cliente</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8 position-relative">
                            <label class="form-label fw-medium">
                                Tipo de identificación <span class="text-danger">*</span>
                            </label>

                            <div class="input-group mb-2">
                                <span class="input-group-text bg-light">
                                    <i class="ri-id-card-line"></i>
                                </span>

                                <select class="form-select" @bind="_tipoDocumentoSeleccionado">
                                    <option value="CEDULA">Cédula</option>
                                    <option value="RUC">RUC</option>
                                    <option value="PASAPORTE">Pasaporte</option>
                                </select>
                            </div>

                            <label class="form-label fw-medium mt-2">
                                Buscar Cliente (Identificación o Nombre) <span class="text-danger">*</span>
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="ri-search-line"></i>
                                </span>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Escriba identificación o nombre..."
                                       @bind="_busquedaDocumento"
                                       @oninput="OnInputBusqueda"
                                       @onfocusout="OcultarSugerenciasDelay"
                                       autocomplete="off" />

                                <button class="btn btn-primary"
                                        type="button"
                                        @onclick="BuscarClienteAsync">
                                    <i class="ri-check-line me-1"></i> Cargar
                                </button>
                            </div>

                            @if (_mostrarSugerencias && _sugerenciasClientes.Any())
                            {
                                <div class="dropdown-menu show w-100 shadow-sm" style="max-height: 250px; overflow-y: auto;">
                                    @foreach (var c in _sugerenciasClientes)
                                    {
                                        <button type="button" class="dropdown-item d-flex justify-content-between align-items-center"
                                                @onclick="() => SeleccionarSugerencia(c)">
                                            <div>
                                                <strong>@c.NomCli @c.ApeCli</strong>
                                                <br />
                                                <small class="text-muted">@c.IdeCli</small>
                                            </div>
                                            <span class="badge bg-light text-dark border">@c.TipCli</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @if (_clienteSeleccionado is not null)
                    {
                        <div class="bg-light rounded-3 border-success mt-3 border p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="badge bg-success-transparent me-2">
                                            <i class="ri-checkbox-circle-line"></i> Seleccionado
                                        </span>
                                    </div>
                                    <h6 class="fw-bold mb-2">
                                        @_clienteSeleccionado.NomCli @_clienteSeleccionado.ApeCli
                                    </h6>
                                    <div class="row g-2 small text-muted">
                                        <div class="col-md-6">
                                            <i class="ri-bank-card-line me-1"></i>
                                            <strong>ID:</strong> @_clienteSeleccionado.IdeCli
                                        </div>
                                        <div class="col-md-6">
                                            <i class="ri-phone-line me-1"></i>
                                            <strong>Tel:</strong> @_clienteSeleccionado.TelCli
                                        </div>
                                        <div class="col-12">
                                            <i class="ri-mail-line me-1"></i>
                                            <strong>Email:</strong> @_clienteSeleccionado.CorCli
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-danger-light" @onclick="LimpiarCliente" title="Cambiar cliente">
                                    <i class="ri-close-line"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card custom-card shadow-sm">
                <div class="card-header bg-info-transparent">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="ri-shopping-cart-line fs-20 text-info me-2"></i>
                            <h5 class="fw-semibold mb-0">Productos</h5>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (_items.Any())
                    {
                        <div class="table-responsive">
                            <table class="table-hover mb-0 table">
                                <thead class="table-light">
                                    <tr>
                                        <th width="5%" class="text-center">#</th>
                                        <th width="45%">Producto</th>
                                        <th width="15%" class="text-center">Cantidad</th>
                                        <th width="15%" class="text-end">P. Unit.</th>
                                        <th width="15%" class="text-end">Subtotal</th>
                                        <th width="5%" class="text-center">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < _items.Count; i++)
                                    {
                                        var index = i;
                                        var item = _items[i];
                                        <tr class="align-middle">
                                            <td class="fw-bold text-muted text-center">@(i + 1)</td>
                                            <td>
                                                <select class="form-select form-select-sm @(item.ProductoId.HasValue ? "border-success" : "")"
                                                        value="@item.ProductoId"
                                                        @onchange="e => OnProductoChanged(item, e)">
                                                    <option value="">-- Seleccione un producto --</option>
                                                    @foreach (var p in _productos)
                                                    {
                                                        <option value="@p.Id">
                                                            @p.Nombre (@p.Codigo)
                                                        </option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <input type="number"
                                                       class="form-control form-control-sm text-center"
                                                       min="1"
                                                       value="@item.Cantidad"
                                                       @onchange="e => OnCantidadChanged(item, e)"
                                                       disabled="@(!item.ProductoId.HasValue)" />
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-secondary-transparent">
                                                    $@item.PrecioUnitario.ToString("N2")
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <span class="fw-bold text-primary">
                                                    $@item.Subtotal.ToString("N2")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-danger-light"
                                                        @onclick="@(() => EliminarItem(index))"
                                                        title="Eliminar item">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    <tr class="bg-light-hover">
                                        <td colspan="6" class="p-0">
                                            <button class="btn btn-link text-decoration-none fw-medium w-100 py-2 ps-4 text-start"
                                                    style="border-radius: 0; color: var(--primary-color);"
                                                    @onclick="AgregarItem">
                                                <i class="ri-add-circle-line fs-16 me-2 align-middle"></i>Agregar nueva línea
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="py-5 text-center">
                            <i class="ri-inbox-line fs-48 text-muted d-block mb-3 opacity-50"></i>
                            <p class="text-muted mb-2">No hay productos agregados</p>
                            <button class="btn btn-sm btn-primary" @onclick="AgregarItem">
                                <i class="ri-add-line me-1"></i>Agregar primer producto
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card custom-card mb-3 shadow-sm">
                <div class="card-header bg-secondary-transparent">
                    <div class="d-flex align-items-center">
                        <i class="ri-information-line fs-20 me-2"></i>
                        <h6 class="fw-semibold mb-0">Información</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Fecha de emisión</label>
                        <input type="date"
                               class="form-control form-control-sm"
                               value="@_fechaEmision.ToString("yyyy-MM-dd")"
                               disabled />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small text-muted mb-1">Usuario</label>
                        <input type="text"
                               class="form-control form-control-sm"
                               value="@_nombreUsuario"
                               disabled />
                    </div>
                </div>
            </div>

            <div class="card custom-card mb-3 shadow-sm">
                <div class="card-header bg-success-transparent">
                    <div class="d-flex align-items-center">
                        <i class="ri-money-dollar-circle-line fs-20 text-success me-2"></i>
                        <h6 class="fw-semibold mb-0">Resumen</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center border-bottom mb-2 pb-2">
                        <span class="text-muted">Subtotal IVA 0%:</span>
                        <span class="fw-semibold">$@_subtotalIva0.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center border-bottom mb-2 pb-2">
                        <span class="text-muted">Subtotal IVA 15%:</span>
                        <span class="fw-semibold">$@_subtotalIva15.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center border-bottom mb-2 pb-2">
                        <span class="text-muted">IVA (15%):</span>
                        <span class="fw-semibold">$@_iva.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <span class="fw-bold fs-16">TOTAL:</span>
                        <span class="fw-bold text-success fs-20">$@_total.ToString("N2")</span>
                    </div>

                    <div class="alert alert-info mt-3 mb-0 border-0 py-2">
                        <small class="d-flex">
                            <i class="ri-information-line me-2 mt-1"></i>
                            <span>Los totales son referenciales. El cálculo final se realiza en el backend.</span>
                        </small>
                    </div>
                </div>
            </div>

            <div class="card custom-card shadow-sm">
                <div class="card-body">
                    <button class="btn btn-success btn-lg mb-2 w-100"
                            @onclick="MostrarModalConfirmacion"
                            disabled="@(!PuedeGuardar || _isSaving)">
                        <i class="ri-save-line me-2"></i>
                        @(_isSaving ? "Procesando..." : "Guardar Factura")
                    </button>
                    <button class="btn btn-light w-100" @onclick="Cancelar" disabled="@_isSaving">
                        <i class="ri-close-line me-1"></i>Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="ri-file-list-3-line me-2"></i>Confirmar Factura
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal" disabled="@_isSaving"></button>
                </div>
                <div class="modal-body">
                    @if (_clienteSeleccionado is not null)
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-primary mb-3">
                                <i class="ri-user-line me-2"></i>Información del Cliente
                            </h6>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Nombre:</small>
                                    <strong>@_clienteSeleccionado.NomCli @_clienteSeleccionado.ApeCli</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Identificación:</small>
                                    <strong>@_clienteSeleccionado.IdeCli</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Email:</small>
                                    <strong>@_clienteSeleccionado.CorCli</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Teléfono:</small>
                                    <strong>@_clienteSeleccionado.TelCli</strong>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="mb-4">
                            <h6 class="fw-bold text-primary mb-3">
                                <i class="ri-shopping-cart-line me-2"></i>Detalle de Productos
                            </h6>
                            <div class="table-responsive">
                                <table class="table-sm table-bordered mb-0 table">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="5%">#</th>
                                            <th width="45%">Producto</th>
                                            <th width="15%" class="text-center">Cantidad</th>
                                            <th width="17%" class="text-end">P. Unit.</th>
                                            <th width="18%" class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var detallesValidos = _items.Where(i => i.ProductoId.HasValue && i.Cantidad > 0).ToList();
                                        }
                                        @for (int i = 0; i < detallesValidos.Count; i++)
                                        {
                                            var item = detallesValidos[i];
                                            <tr>
                                                <td class="text-center">@(i + 1)</td>
                                                <td>@item.NombreProducto</td>
                                                <td class="text-center">@item.Cantidad</td>
                                                <td class="text-end">$@item.PrecioUnitario.ToString("N2")</td>
                                                <td class="fw-bold text-end">$@item.Subtotal.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <hr />

                        <div class="bg-light rounded p-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal IVA 0%:</span>
                                <span class="fw-semibold">$@_subtotalIva0.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal IVA 15%:</span>
                                <span class="fw-semibold">$@_subtotalIva15.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>IVA (15%):</span>
                                <span class="fw-semibold">$@_iva.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between border-top border-2 pt-2">
                                <span class="fw-bold fs-18">TOTAL:</span>
                                <span class="fw-bold text-success fs-20">$@_total.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="alert alert-warning mt-3 mb-0">
                            <small class="d-flex align-items-start">
                                <i class="ri-error-warning-line me-2 mt-1"></i>
                                <span>Por favor, verifique que todos los datos sean correctos antes de confirmar. Esta acción creará, firmará y enviará la factura al SRI.</span>
                            </small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" @onclick="CerrarModal" disabled="@_isSaving">
                        <i class="ri-close-line me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-success" @onclick="ConfirmarYGuardarAsync" disabled="@_isSaving">
                        <i class="ri-check-line me-1"></i>
                        @(_isSaving ? "Procesando..." : "Confirmar y Guardar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .card.custom-card {
        border: none;
        border-radius: 0.75rem;
        transition: transform 0.2s ease;
    }

        .card.custom-card:hover {
            transform: translateY(-2px);
        }

    .form-control:focus, .form-select:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.25);
    }

    .table-hover tbody tr:hover {
        background-color: rgba(99, 102, 241, 0.05);
    }

    .btn-lg {
        padding: 0.75rem 1.5rem;
        font-size: 1.1rem;
    }

    .modal.show {
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .bg-primary-transparent {
        background-color: rgba(99, 102, 241, 0.1) !important;
    }

    .bg-info-transparent {
        background-color: rgba(13, 202, 240, 0.1) !important;
    }

    .bg-success-transparent {
        background-color: rgba(25, 135, 84, 0.1) !important;
    }

    .bg-secondary-transparent {
        background-color: rgba(108, 117, 125, 0.1) !important;
    }

    .bg-light-hover:hover {
        background-color: #f8f9fa;
    }

    .cursor-pointer {
        cursor: pointer;
    }
</style>

@code {
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _mostrarModal = false;

    // Variables para la búsqueda dinámica con autocompletado
    private bool _mostrarSugerencias = false;
    private List<ClienteDto> _todosLosClientes = new(); // Carga local para filtrado rápido
    private List<ClienteDto> _sugerenciasClientes = new();

    private int _idUsu;
    private int _idEmp = 18;
    private int _idEmpresa = 4;
    private string _nombreUsuario = string.Empty;
    private DateTime _fechaEmision = DateTime.Now;

    private string _tipoDocumentoSeleccionado = "CEDULA"; // Valor por defecto
    private string _busquedaDocumento = string.Empty;
    private ClienteDto? _clienteSeleccionado;

    private List<ProductoDto> _productos = new();
    private readonly List<FacturaItemModel> _items = new();

    // --- LÓGICA DE IMPUESTOS (RESTAURADA DE TU CÓDIGO) ---
    private decimal _subtotalIva0 => _items
        .Where(i => i.TarifaTributaria == 0)
        .Sum(i => i.Subtotal);

    private decimal _subtotalIva15 => _items
        .Where(i => i.TarifaTributaria == 15)
        .Sum(i => i.Subtotal);

    private decimal _iva => _items.Sum(i =>
        i.Subtotal * (i.TarifaTributaria / 100m)
    );

    private decimal _subtotal => _subtotalIva0 + _subtotalIva15;
    private decimal _total => _subtotal + _iva;
    // -----------------------------------------------------

    private bool PuedeGuardar =>
        _clienteSeleccionado is not null &&
        _items.Any(i => i.ProductoId.HasValue && i.Cantidad > 0) &&
        _idUsu != 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarUsuarioActualAsync();

            // Carga paralela de productos y clientes (para el filtrado local)
            var tProductos = CargarProductosAsync();
            var tClientes = CargarTodosLosClientesAsync();
            await Task.WhenAll(tProductos, tClientes);

            AgregarItem();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", $"Error durante la inicialización: {ex.Message}", "error");
        }

        _isLoading = false;
    }

    // --- IMPLEMENTACIÓN AUTOCOMPLETADO (BASADO EN TU REFERENCIA) ---

    private async Task CargarTodosLosClientesAsync()
    {
        try
        {
            _todosLosClientes = await ClientesApi.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error cargando clientes para autocompletado: " + ex.Message);
        }
    }

    private void OnInputBusqueda(ChangeEventArgs e)
    {
        _busquedaDocumento = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_busquedaDocumento))
        {
            _sugerenciasClientes.Clear();
            _mostrarSugerencias = false;
            return;
        }

        // Lógica de filtrado local similar a tu /clientes/listar
        // Filtramos por Identificación O Nombre/Apellido
        _sugerenciasClientes = _todosLosClientes
            .Where(c =>
                ContainsIgnoreCase(c.IdeCli, _busquedaDocumento) ||
                ContainsIgnoreCase(c.NomCli, _busquedaDocumento) ||
                ContainsIgnoreCase(c.ApeCli, _busquedaDocumento)
            )
            .Take(5) // Limitamos a 5 sugerencias
            .ToList();

        _mostrarSugerencias = _sugerenciasClientes.Any();
    }

    private void SeleccionarSugerencia(ClienteDto cliente)
    {
        _busquedaDocumento = cliente.IdeCli; // Rellenar el input con la identificación
        _tipoDocumentoSeleccionado = cliente.TipCli; // Ajustar el tipo
        _mostrarSugerencias = false;
        // Opcional: Cargar directamente el cliente aquí si lo deseas,
        // pero mantengo el flujo de "dar click en Buscar" o enter si prefieres.
        // Para este caso, cargamos directamente para mejor UX:
        _clienteSeleccionado = cliente;
    }

    private async Task OcultarSugerenciasDelay()
    {
        // Delay para permitir el click en la sugerencia
        await Task.Delay(200);
        _mostrarSugerencias = false;
    }

    private static bool ContainsIgnoreCase(string? source, string? value)
    {
        if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(value))
            return false;
        return source.IndexOf(value, StringComparison.OrdinalIgnoreCase) >= 0;
    }

    // -------------------------------------------------------------

    private async Task CargarUsuarioActualAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var idUsuClaim = user.FindFirst("idUsu")?.Value;
        if (int.TryParse(idUsuClaim, out var idUsu))
        {
            _idUsu = idUsu;
        }

        _nombreUsuario = user.Identity?.Name ?? "Usuario";
    }

    private async Task CargarProductosAsync()
    {
        try
        {
            _productos = await ProductosApi.GetAllAsync();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", $"No se pudieron cargar los productos: {ex.Message}", "error");
        }
    }

    private async Task BuscarClienteAsync()
    {
        // Si ya se seleccionó por sugerencia, no hacemos nada extra, o recargamos si se desea.
        if (_clienteSeleccionado != null && _clienteSeleccionado.IdeCli == _busquedaDocumento) return;

        if (string.IsNullOrWhiteSpace(_tipoDocumentoSeleccionado))
        {
            await Swal.FireAsync("Atención", "Seleccione el tipo de documento.", "warning");
            return;
        }

        if (string.IsNullOrWhiteSpace(_busquedaDocumento))
        {
            await Swal.FireAsync("Atención", "Ingrese el número del documento o nombre.", "warning");
            return;
        }

        try
        {
            // Intentamos buscar en la lista local primero
            var clienteLocal = _todosLosClientes.FirstOrDefault(c => c.IdeCli == _busquedaDocumento && c.TipCli == _tipoDocumentoSeleccionado);

            if (clienteLocal != null)
            {
                _clienteSeleccionado = clienteLocal;
            }
            else
            {
                // Si no está en local, intentamos por API específica (fallback)
                _clienteSeleccionado = await ClientesApi.GetByDocumentoAsync(
                    _tipoDocumentoSeleccionado,
                    _busquedaDocumento
                );
            }

            if (_clienteSeleccionado is null)
            {
                await Swal.FireAsync("Sin resultados",
                    $"No se encontró un cliente con {_tipoDocumentoSeleccionado} {_busquedaDocumento}.",
                    "info");
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", $"Error al buscar cliente: {ex.Message}", "error");
        }
    }

    private void LimpiarCliente()
    {
        _clienteSeleccionado = null;
        _busquedaDocumento = string.Empty;
    }

    private void AgregarItem()
    {
        _items.Add(new FacturaItemModel());
    }

    private void EliminarItem(int index)
    {
        if (index >= 0 && index < _items.Count)
        {
            _items.RemoveAt(index);
        }
    }

    private void OnProductoChanged(FacturaItemModel item, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id)) return;

        item.ProductoId = id;

        var prod = _productos.FirstOrDefault(p => p.Id == id);
        if (prod is not null)
        {
            item.NombreProducto = prod.Nombre;
            item.PrecioUnitario = prod.PrecioVenta;

            // LÓGICA DE TARIFA TRIBUTARIA (Restaurada)
            item.TarifaTributaria = prod.IdTipoTributario switch
            {
                1 => 0,   // IVA 0%
                2 => 15,  // IVA 15%
                _ => 0
            };
        }
    }

    private void OnCantidadChanged(FacturaItemModel item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var cant) && cant > 0)
        {
            item.Cantidad = cant;
        }
        else
        {
            item.Cantidad = 1;
        }
    }

    private void MostrarModalConfirmacion()
    {
        if (!PuedeGuardar)
        {
            return;
        }
        _mostrarModal = true;
    }

    private void CerrarModal()
    {
        if (!_isSaving)
        {
            _mostrarModal = false;
        }
    }

    private async Task ConfirmarYGuardarAsync()
    {
        var detallesValidos = _items
            .Where(i => i.ProductoId.HasValue && i.Cantidad > 0)
            .ToList();

        var request = new FacturaCreateRequest
        {
            IdCli = _clienteSeleccionado!.IdCli,
            IdEmp = _idEmp,
            IdUsu = _idUsu,
            IdEmpresa = _idEmpresa,
            Detalles = detallesValidos
                .Select(i => new FacturaDetalleCreateRequest
                {
                    IdPro = i.ProductoId!.Value,
                    Cantidad = i.Cantidad
                })
                .ToList()
        };

        try
        {
            _isSaving = true;
            var facturaCreada = await FacturasApi.CrearFacturaAsync(request);
            _isSaving = false;
            _mostrarModal = false;

            await Swal.FireAsync(
                "¡Éxito!",
                $"Factura #{facturaCreada.NumFac} creada, firmada y enviada correctamente.",
                "success"
            );

            NavigationManager.NavigateTo("/dashboards/facturas");
        }
        catch (Exception ex)
        {
            _isSaving = false;
            await Swal.FireAsync("Error", $"Error al crear la factura: {ex.Message}", "error");
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/dashboards/facturas");
    }

    // Modelo Interno Restaurado
    private sealed class FacturaItemModel
    {
        public int? ProductoId { get; set; }
        public string NombreProducto { get; set; } = string.Empty;
        public int Cantidad { get; set; } = 1;
        public decimal PrecioUnitario { get; set; } = 0m;

        // Propiedad restaurada
        public int TarifaTributaria { get; set; } = 0;

        public decimal Subtotal => Cantidad * PrecioUnitario;
    }
}