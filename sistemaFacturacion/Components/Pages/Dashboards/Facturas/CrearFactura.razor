    private void AbrirModalCrearCliente()
    {
        _formCliente = new ClienteCreateVM();
        _mostrarModalCrearCliente = true;
    }

    private void CerrarModalCrearCliente()
    {
        if (_isSavingCliente)
        {
            return;
        }

        CerrarModalCrearClienteInterno();
    }

    private void CerrarModalCrearClienteInterno()
    {
        _mostrarModalCrearCliente = false;
        _formCliente = new ClienteCreateVM();
    }

    private async Task CrearClienteAsync()
    {
        _isSavingCliente = true;
        try
        {
            var esRucJuridico = EsRucJuridicoCliente;

            var req = new ClienteCreateRequest
            {
                Nombre = _formCliente.Nombre?.Trim() ?? "",
                Apellido = esRucJuridico ? "-" : (_formCliente.Apellido?.Trim() ?? ""),
                Identificacion = _formCliente.Identificacion?.Trim() ?? "",
                TipoIdentificacion = (_formCliente.TipoIdentificacion ?? "").ToUpperInvariant(),
                Direccion = _formCliente.Direccion?.Trim() ?? "",
                Telefono = _formCliente.Telefono?.Trim() ?? "",
                CorreoElectronico = _formCliente.Correo?.Trim() ?? ""
            };

            var creado = await ClientesApi.CreateAsync(req);

            var swalResult = await Swal.FireAsync(new SweetAlertOptions
            {
                Icon = SweetAlertIcon.Success,
                Title = "Cliente creado",
                Text = $"Cliente {creado.NomCli} {creado.ApeCli} creado exitosamente.",
                ShowConfirmButton = true,
                ConfirmButtonText = "Aceptar"
            });

            if (swalResult.IsConfirmed)
            {
                await CargarTodosLosClientesAsync();
                _clienteSeleccionado = creado;
                _busquedaDocumento = creado.IdeCli;

                CerrarModalCrearClienteInterno();
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Icon = SweetAlertIcon.Error,
                Title = "Error al crear cliente",
                Text = ex.Message
            });
        }
        finally
        {
            _isSavingCliente = false;
            StateHasChanged();
        }
    }


    private bool EsRucJuridicoCliente =>
        (_formCliente.TipoIdentificacion ?? "").Trim().Equals("RUC", StringComparison.OrdinalIgnoreCase) &&
        (_formCliente.TipoRucPersona ?? "").Trim().Equals("JURIDICA", StringComparison.OrdinalIgnoreCase);

    private string ObtenerPlaceholderIdentificacion()
    {
        return _formCliente.TipoIdentificacion switch
        {
            "Cedula" => "10 dígitos",
            "RUC" => "13 dígitos",
            "Pasaporte" => "6-12 caracteres alfanuméricos",
            _ => "Ingrese identificación"
        };
    }

    private string ObtenerMaxLengthIdentificacion()
    {
        var maxLen = (_formCliente.TipoIdentificacion ?? "").ToUpperInvariant() switch
        {
            "CEDULA" => 10,
            "RUC" => 13,
            "PASAPORTE" => 12,
            _ => 20
        };
        return maxLen.ToString();
    }

    private string ObtenerHelpTextIdentificacion()
    {
        var tipo = _formCliente.TipoIdentificacion ?? "";
        var tipoRuc = _formCliente.TipoRucPersona ?? "";

        if (tipo == "Cedula")
            return "Se validará provincia, tercer dígito (<6) y dígito verificador.";

        if (tipo == "RUC")
        {
            if (string.Equals(tipoRuc, "NATURAL", StringComparison.OrdinalIgnoreCase))
                return "RUC de persona natural: primeros 10 = cédula válida y termina en 001.";
            if (string.Equals(tipoRuc, "JURIDICA", StringComparison.OrdinalIgnoreCase))
                return "RUC de persona jurídica: 13 dígitos numéricos.";
            return "Seleccione si el RUC es de persona natural o jurídica.";
        }

        if (tipo == "Pasaporte")
            return "Se permiten letras y números (6 a 12).";

        return "Seleccione un tipo para ver las reglas.";
    }
    private void OnTipoDocumentoChanged(ChangeEventArgs e)
    {
        var tipo = e.Value?.ToString() ?? "";

        // Si eligió Consumidor Final (07)
        if (tipo == "07")
        {
            // Obtener de la lista de todos los clientes
            _clienteSeleccionado = _todosLosClientes.FirstOrDefault(c => c.IdCli == 1);

            // Ocultar buscador y botón de crear cliente
            _busquedaDocumento = "";
            _mostrarSugerencias = false;
        }
        else
        {
            // Si cambia a otro tipo, reactivar todo
            _clienteSeleccionado = null;
        }
    }


