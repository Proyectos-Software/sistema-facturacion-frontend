                                            <option value="Cedula">Cédula</option>
                                            <option value="RUC">RUC</option>
                                            <option value="Pasaporte">Pasaporte</option>
                                        </InputSelect>
                                        <ValidationMessage For="@(() => _formCliente.TipoIdentificacion)" />
                                    </div>

                                    @if (_formCliente.TipoIdentificacion == "RUC")
