@using sistemaFacturacion.Models
@using sistemaFacturacion.Services
@inject IClientesApiClient ClientesApi
@namespace sistemaFacturacion.Components.Pages.Dashboards.Facturas.Steps

<div class="row justify-content-center">
    <div class="col-xl-10">

        <h6 class="mb-4 text-primary">
            <i class="ri-user-search-line me-1"></i> Selección de Cliente
        </h6>

        <!-- ============================
             BUSQUEDA DE CLIENTE
        ================================ -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="row g-3">

                    <!-- Buscar por documento -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Documento (CI / RUC)</label>
                        <input type="text"
                               class="form-control"
                               placeholder="Ej: 050XXXXXXX"
                               @bind="_documento"
                               @bind:event="oninput" />
                    </div>

                    <!-- Tipo de documento -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Tipo</label>
                        <select class="form-select" @bind="_tipoDocumento">
                            <option value="CEDULA">Cédula</option>
                            <option value="RUC">RUC</option>
                        </select>
                    </div>

                    <!-- Botón Buscar -->
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary w-100"
                                @onclick="BuscarCliente"
                                disabled="@_isLoading">

                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }

                            <span><i class="ri-search-line me-1"></i> Buscar</span>
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger mt-3 mb-0">
                        @_errorMessage
                    </div>
                }
            </div>
        </div>

        <!-- ============================
             RESULTADO / CLIENTE SELECCIONADO
        ================================ -->
        @if (Factura.IdCliente != null)
        {
            <div class="card shadow-sm border-primary mb-3">
                <div class="card-header bg-primary text-white py-2">
                    <strong><i class="ri-user-line me-1"></i> Cliente seleccionado</strong>
                </div>

                <div class="card-body">
                    <div class="row gy-2">
                        <div class="col-md-6">
                            <strong>Nombre:</strong><br />
                            @Factura.NombreCliente
                        </div>

                        <div class="col-md-6">
                            <strong>Documento:</strong><br />
                            @Factura.DocumentoCliente
                        </div>

                        <div class="col-md-12">
                            <strong>Dirección:</strong><br />
                            @Factura.DireccionCliente
                        </div>
                    </div>

                    <button class="btn btn-sm btn-outline-danger mt-3"
                            @onclick="QuitarSeleccionCliente">
                        <i class="ri-close-line me-1"></i> Quitar selección
                    </button>
                </div>
            </div>
        }

        <!-- ============================
             LISTADO COMPLETO (opcional)
        ================================ -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light py-2">
                <strong><i class="ri-database-2-line me-1"></i> Lista de clientes</strong>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Cliente</th>
                                <th>Documento</th>
                                <th>Dirección</th>
                                <th style="width: 90px;">Acción</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (_clientes.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">
                                        No hay clientes registrados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var cli in _clientes.Select((c, i) => new { C = c, I = i }))
                                {
                                    <tr>
                                        <td>@(cli.I + 1)</td>
                                        <td>@cli.C.NomCli @cli.C.ApeCli</td>
                                        <td>@cli.C.IdeCli</td>
                                        <td>@cli.C.DirCli</td>

                                        <td>
                                            <button class="btn btn-sm btn-primary"
                                                    @onclick="() => SeleccionarCliente(cli.C)">
                                                Seleccionar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@code {

    [Parameter] public FacturaDraft Factura { get; set; } = default!;

    private string _documento = "";
    private string _tipoDocumento = "CEDULA";
    private bool _isLoading = false;
    private string? _errorMessage;

    private List<ClienteDto> _clientes = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _clientes = await ClientesApi.GetAllAsync();
        }
        catch
        {
            _errorMessage = "Error al cargar la lista de clientes.";
        }
    }

    private async Task BuscarCliente()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_documento))
        {
            _errorMessage = "Debe ingresar un documento.";
            return;
        }

        _isLoading = true;

        try
        {
            var cliente = await ClientesApi.GetByDocumentoAsync(_tipoDocumento, _documento);

            if (cliente == null)
            {
                _errorMessage = "Cliente no encontrado.";
                Factura.IdCliente = null;
                return;
            }

            SeleccionarCliente(cliente);
        }
        catch
        {
            _errorMessage = "Error al buscar cliente.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SeleccionarCliente(ClienteDto cli)
    {
        Factura.IdCliente = cli.IdCli;
        Factura.NombreCliente = $"{cli.NomCli} {cli.ApeCli}".Trim();
        Factura.DocumentoCliente = cli.IdeCli ?? "";
        Factura.DireccionCliente = cli.DirCli ?? "";
    }

    private void QuitarSeleccionCliente()
    {
        Factura.IdCliente = null;
        Factura.NombreCliente = "";
        Factura.DocumentoCliente = "";
        Factura.DireccionCliente = "";
    }
}
