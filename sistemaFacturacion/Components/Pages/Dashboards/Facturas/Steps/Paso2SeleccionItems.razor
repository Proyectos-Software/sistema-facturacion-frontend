@using sistemaFacturacion.Models
@using sistemaFacturacion.Services

@inject ICategoriasApiClient CategoriasApi
@inject IProductosApiClient ProductosApi
@inject ILotesApiClient LotesApi
@namespace sistemaFacturacion.Components.Pages.Dashboards.Facturas.Steps

<div class="row justify-content-center">
    <div class="col-xl-11">

        <h6 class="mb-3 text-primary">
            <i class="ri-shopping-cart-line me-1"></i> Selección de Ítems
        </h6>

        <!-- ============================
             SECCIÓN: SELECCIONAR ÍTEM
        ================================ -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="row g-3">

                    <!-- Categoría -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Categoría</label>
                        <select class="form-select" @onchange="OnCategoriaChanged">
                            <option value="">Seleccione...</option>

                            @foreach (var c in _categorias)
                            {
                                <option value="@c.Id">@c.Nombre</option>
                            }
                        </select>
                    </div>

                    <!-- Producto -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Producto</label>
                        <select class="form-select" @onchange="OnProductoChanged" disabled="@(!_productos.Any())">
                            <option value="">Seleccione...</option>

                            @foreach (var p in _productos)
                            {
                                <option value="@p.Id">@p.Nombre</option>
                            }
                        </select>
                    </div>

                    <!-- Lote -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Lote</label>
                        <select class="form-select" @onchange="OnLoteChanged" disabled="@(!_lotes.Any())">
                            <option value="">Seleccione...</option>

                            @foreach (var l in _lotes)
                            {
                                <option value="@l.Id">Lote #@l.Id - Stock: @l.CanDis</option>
                            }
                        </select>
                    </div>

                    <!-- Precio -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Precio Unit.</label>
                        <input class="form-control" type="text" disabled value="@_precioUnitario.ToString("0.00")" />
                    </div>

                    <!-- Cantidad -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Cantidad</label>
                        <input class="form-control"
                               type="number"
                               min="1"
                               @bind="_cantidad"
                               @bind:event="oninput" />
                    </div>

                    <!-- Botón Agregar -->
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-success w-100" @onclick="AgregarItem" disabled="@_btnDisabled">
                            <i class="ri-add-line me-1"></i> Agregar
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="col-12 mt-2">
                            <div class="alert alert-danger">@_error</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ============================
             SECCIÓN: TABLA DE ÍTEMS
        ================================ -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light py-2">
                <strong><i class="ri-list-check-2 me-1"></i> Ítems agregados</strong>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Producto</th>
                                <th>Lote</th>
                                <th>Cant.</th>
                                <th>P.Unit</th>
                                <th>Subt.</th>
                                <th>IVA</th>
                                <th>Total</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (!Factura.Detalles.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-3">
                                        No hay ítems agregados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var (item, i) in
                                                            Factura.Detalles.Select((v, i) => (v, i)))
                                {
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@item.NombreProducto</td>
                                        <td>@item.IdLote</td>
                                        <td>@item.Cantidad</td>
                                        <td>@item.PrecioUnitario.ToString("0.00")</td>
                                        <td>@item.Subtotal.ToString("0.00")</td>
                                        <td>@item.Iva.ToString("0.00")</td>
                                        <td>@item.Total.ToString("0.00")</td>

                                        <td>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => EliminarItem(i)">
                                                <i class="ri-delete-bin-line"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@code {

    [Parameter] public FacturaDraft Factura { get; set; } = default!;

    private List<CategoriaProductoDto> _categorias = new();
    private List<ProductoDto> _productos = new();
    private List<LoteDto> _lotes = new();

    private ProductoDto? _productoSel;
    private LoteDto? _loteSel;

    private int _cantidad = 1;
    private decimal _precioUnitario = 0m;
    private string? _error;

    private bool _btnDisabled =>
        _productoSel == null || _loteSel == null || _cantidad <= 0;

    protected override async Task OnInitializedAsync()
    {
        _categorias = await CategoriasApi.ListarAsync();
    }

    private async Task OnCategoriaChanged(ChangeEventArgs e)
    {
        _productos.Clear();
        _lotes.Clear();
        _productoSel = null;
        _loteSel = null;

        if (!int.TryParse(e.Value?.ToString(), out var catId))
            return;

        _productos = (await ProductosApi.GetAllAsync())
            .Where(p => p.IdCategoria == catId)
            .ToList();
    }

    private async Task OnProductoChanged(ChangeEventArgs e)
    {
        _lotes.Clear();
        _loteSel = null;
        _productoSel = null;

        if (!int.TryParse(e.Value?.ToString(), out var id))
            return;

        _productoSel = _productos.FirstOrDefault(p => p.Id == id);

        if (_productoSel != null)
            _lotes = await LotesApi.GetByProductIdAsync(_productoSel.Id);
    }

    private void OnLoteChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id))
            return;

        _loteSel = _lotes.FirstOrDefault(l => l.Id == id);

        if (_loteSel != null)
            _precioUnitario = _loteSel.PreVen;
    }

    private void AgregarItem()
    {
        _error = null;

        if (_loteSel!.CanDis < _cantidad)
        {
            _error = $"Stock insuficiente. Disponible: {_loteSel.CanDis}";
            return;
        }

        // Calcular IVA dependiendo del tipo tributario
        decimal subtotal = _cantidad * _precioUnitario;

        decimal iva = 0m;
        if (_productoSel!.IdTipoTributario != 0)
        {
            iva = subtotal * 0.12m;
        }

        decimal total = subtotal + iva;

        Factura.Detalles.Add(new DetalleFacturaDraft
        {
            IdProducto = _productoSel.Id,
            NombreProducto = _productoSel.Nombre,
            IdLote = _loteSel.Id,
            Cantidad = _cantidad,
            PrecioUnitario = _precioUnitario,
            Subtotal = subtotal,
            Iva = iva,
            Total = total
        });

        // Reset cantidad
        _cantidad = 1;

        // Actualizar totales de factura
        Factura.Subtotal = Factura.Detalles.Sum(x => x.Subtotal);
        Factura.Iva = Factura.Detalles.Sum(x => x.Iva);
        Factura.Total = Factura.Detalles.Sum(x => x.Total);
    }

    private void EliminarItem(int index)
    {
        Factura.Detalles.RemoveAt(index);

        // Recalcular totales
        Factura.Subtotal = Factura.Detalles.Sum(x => x.Subtotal);
        Factura.Iva = Factura.Detalles.Sum(x => x.Iva);
        Factura.Total = Factura.Detalles.Sum(x => x.Total);
    }

}
