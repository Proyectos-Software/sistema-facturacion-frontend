                               $"<td><small>{Escape(d.CodLote)}</small></td>" +            // codLote
                               $"<td class='text-end'><small>{d.CanDet}</small></td>" +    // canDet
                               $"<td class='text-end'><small>{FormatMoney(d.PreDet)}</small></td>" + // preDet
                               $"<td class='text-end'><small><strong>{FormatMoney(d.TotDet)}</strong></small></td>" + // totDet
                               "</tr>";
            }
        }


        detallesHtml += "</tbody></table></div>";

        var html = "<div class='text-start'>" +
                  $"<p><strong>Número:</strong> {Escape(f.NumFac)}</p>" +
                  $"<p><strong>Cliente:</strong> {Escape(f.Cliente?.NomCli)}</p>" +
                  $"<p><strong>Dirección:</strong> {Escape(f.Cliente?.DirCli)}</p>" +
                  $"<p><strong>Empleado:</strong> {Escape(f.Empleado?.NomEmp)}</p>" +
                  $"<p><strong>Fecha:</strong> {f.FecFac:dd/MM/yyyy HH:mm}</p>" +
                  $"<hr/>" +
                  $"<p><strong>Subtotal:</strong> {FormatMoney(f.SubFac)}</p>" +
                  $"<p><strong>IVA:</strong> {FormatMoney(f.IvaFac)}</p>" +
                  $"<p><strong>Total:</strong> <span class='text-primary'>{FormatMoney(f.TotFac)}</span></p>" +
                  $"<hr/>" +
                  $"<h6>Detalles de la factura:</h6>" +
                  detallesHtml +
