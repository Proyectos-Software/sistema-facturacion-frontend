    // Método auxiliar para detectar mantenimiento del SRI
    // Línea: ~1020-1030
    private static bool DetectarMantenimientoSri(string? mensaje)
    {
        if (string.IsNullOrWhiteSpace(mensaje)) return false;

        var mensajeLower = mensaje.ToLower();
        return mensajeLower.Contains("mantenimiento") ||
               mensajeLower.Contains("no disponible") ||
               mensajeLower.Contains("fuera de servicio") ||
               mensajeLower.Contains("temporalmente") ||
               mensajeLower.Contains("maintenance");
    }

