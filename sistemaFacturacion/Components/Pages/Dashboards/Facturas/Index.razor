    private static (string badgeClass, string icon) GetEstadoBadge(string? estado)
    {
        return estado switch
        {
            "Emitida" => ("bg-success-subtle text-success", "ri-check-line"),
            "Pagada" => ("bg-info-subtle text-info", "ri-money-dollar-circle-line"),
            "Pendiente" => ("bg-warning-subtle text-warning", "ri-time-line"),
            "Anulada" => ("bg-danger-subtle text-danger", "ri-close-circle-line"),
            _ => ("bg-secondary-subtle text-secondary", "ri-question-line")
        };
    }

    private static bool ContainsIgnoreCase(string? source, string? value)
    {
        if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(value))
            return false;

        return source.IndexOf(value, StringComparison.OrdinalIgnoreCase) >= 0;
    }

    private static string FormatMoney(decimal? v) =>
        v.HasValue ? "$" + v.Value.ToString("N2") : "-";

    private static string Escape(string? s) =>
        string.IsNullOrEmpty(s)
            ? string.Empty
            : s.Replace("<", "&lt;").Replace(">", "&gt;");
}