    private async Task CambiarEstado(FacturaDto f)
    {
        var inputOptions = new Dictionary<string, string>
    {
        { "Emitida", "Emitida" },
        { "Pagada", "Pagada" },
        { "Pendiente", "Pendiente" },
        { "Anulada", "Anulada" }
    };

        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Cambiar estado",
            Text = $"Selecciona el nuevo estado para la factura {f.NumFac}",
            Icon = SweetAlertIcon.Question,
            Input = SweetAlertInputType.Select,
            InputOptions = inputOptions,
            InputValue = f.EstFac ?? "Emitida",
            ShowCancelButton = true,
            ConfirmButtonText = "Cambiar",
            CancelButtonText = "Cancelar"
        });

        if (result.IsConfirmed && !string.IsNullOrEmpty(result.Value))
        {
            try
            {
                var ok = await FacturasApi.CambiarEstadoAsync(f.IdFac, result.Value);
                if (ok)
                {
                    f.EstFac = result.Value;
                    StateHasChanged();

                    var isDark = await JSRuntime.InvokeAsync<bool>("isAppInDarkMode");
                    await Swal.FireAsync(new SweetAlertOptions
                    {
                        Toast = true,
                        Position = SweetAlertPosition.TopEnd,
                        Icon = SweetAlertIcon.Success,
                        Title = "Estado actualizado",
                        ShowConfirmButton = false,
                        Timer = 1600,
                        TimerProgressBar = true,
                        Background = isDark ? "#1e1e1e" : null,
                        Color = isDark ? "#e6e6e6" : null
                    });
                }
            }
            catch (Exception ex)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Icon = SweetAlertIcon.Error,
                    Title = "Error",
                    Text = ex.Message
                });
            }
        }
    }

