                   $"<div class='mb-3'>" +
                   $"<p class='fs-15 mb-2'>¿Deseas intentar autorizar la factura?</p>" +
                   $"<div class='badge bg-primary-subtle text-primary fs-14 px-3 py-2'>{f.NumFac}</div>" +
