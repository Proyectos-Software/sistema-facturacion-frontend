@page "/dashboards/facturas"
@using Microsoft.AspNetCore.Authorization
@using CurrieTechnologies.Razor.SweetAlert2
@using sistemaFacturacion.Services
@using sistemaFacturacion.Models
@attribute [Authorize]

@inject IJSRuntime JSRuntime
@inject IFacturasApiClient FacturasApi
@inject NavigationManager Navigation
@inject SweetAlertService Swal

<div class="page-header mb-4">
    <h1 class="page-title fw-semibold fs-20">Gestión de Facturas</h1>
    <p class="text-muted fs-13">Consulta y administración de facturas emitidas</p>
</div>

@if (cargando)
{
    <div class="alert alert-info">
        <span class="spinner-border spinner-border-sm me-2"></span> Cargando facturas...
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">
        <i class="ri-error-warning-line me-2"></i>@error
    </div>
}
else
{
    <!-- Filtros y búsqueda -->
    <div class="card mb-3 border-0 shadow-sm">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4 col-12">
                    <label class="form-label">Búsqueda rápida</label>
                    <input class="form-control"
                           @bind="FiltroTexto"
                           @bind:event="oninput"
                           placeholder="Número, cliente, empleado..." />
                </div>
                <div class="col-lg-2 col-6">
                    <label class="form-label">Estado</label>
                    <select class="form-select" @bind="FiltroEstado">
                        <option value="">Todos</option>
                        <option value="Emitida">Emitida</option>
                        <option value="Anulada">Anulada</option>
                        <option value="Pagada">Pagada</option>
                        <option value="Pendiente">Pendiente</option>
                    </select>
                </div>
                <div class="col-lg-2 col-6">
                    <label class="form-label">Por página</label>
                    <select class="form-select" @bind="pageSize">
                        <option>5</option>
                        <option>10</option>
                        <option>20</option>
                        <option>50</option>
                    </select>
                </div>
                <div class="col-lg-4 d-grid d-lg-flex justify-content-lg-end col-12 gap-2">
                    <button class="btn btn-success" @onclick="IrACrear">
                        <i class="ri-add-line me-1"></i>Nueva Factura
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Recargar">
                        <i class="ri-refresh-line me-1"></i>Recargar
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltros">
                        <i class="ri-filter-off-line me-1"></i>Limpiar
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <button type="button"
                        class="btn btn-sm btn-link px-0"
                        @onclick="ToggleFiltrosAvanzados">
                    <i class="ri-filter-3-line me-1"></i>
                    @(mostrarFiltrosAvanzados ? "Ocultar filtros avanzados" : "Mostrar filtros avanzados")
                </button>
                <span class="text-muted small">
                    Filtros por cliente, fecha y rango de montos.
                </span>
            </div>

            @if (mostrarFiltrosAvanzados)
            {
                <div class="row g-3 mt-2">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Cliente</label>
                        <div class="position-relative">
                            <input class="form-control"
                                   value="@filtroCliente"
                                   @oninput="OnClienteInput"
                                   placeholder="Filtrar por cliente..."
                                   autocomplete="off" />
                            @if (sugerenciasCliente.Count > 0)
                            {
                                <div class="dropdown-menu show w-100 shadow-sm">
                                    @foreach (var s in sugerenciasCliente)
                                    {
                                        <button type="button"
                                                class="dropdown-item"
                                                @onclick="() => SeleccionarSugerenciaCliente(s)">
                                            @s
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Empleado</label>
                        <div class="position-relative">
                            <input class="form-control"
                                   value="@filtroEmpleado"
                                   @oninput="OnEmpleadoInput"
                                   placeholder="Filtrar por empleado..."
                                   autocomplete="off" />
                            @if (sugerenciasEmpleado.Count > 0)
                            {
                                <div class="dropdown-menu show w-100 shadow-sm">
                                    @foreach (var s in sugerenciasEmpleado)
                                    {
                                        <button type="button"
                                                class="dropdown-item"
                                                @onclick="() => SeleccionarSugerenciaEmpleado(s)">
                                            @s
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Rango de fechas</label>
                        <div class="d-flex gap-2">
                            <input type="date"
                                   class="form-control form-control-sm"
                                   @bind="FechaDesde" />
                            <input type="date"
                                   class="form-control form-control-sm"
                                   @bind="FechaHasta" />
                        </div>
                        <small class="text-muted">Filtra por fecha de emisión</small>
                    </div>

                    <div class="col-lg-6 col-md-6">
                        <label class="form-label">Monto total</label>
                        <div class="row g-2 align-items-center">
                            <div class="col-12">
                                <select class="form-select form-select-sm"
                                        @bind="FiltroMontoModo">
                                    <option value="todos">Todos</option>
                                    <option value="igual">Igual a</option>
                                    <option value="mayorIgual">Mayor o igual que</option>
                                    <option value="menorIgual">Menor o igual que</option>
                                    <option value="entre">Entre</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control form-control-sm"
                                       @bind="FiltroMontoMin"
                                       @bind:event="oninput"
                                       placeholder="Monto mínimo" />
                            </div>
                            <div class="col-6">
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control form-control-sm"
                                       @bind="FiltroMontoMax"
                                       @bind:event="oninput"
                                       placeholder="Monto máximo"
                                       disabled="@(FiltroMontoModo != "entre")" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Resumen de métricas -->
    <div class="row mb-3">
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12">
            <div class="card custom-card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-fill">
                            <p class="text-muted mb-1">Total Facturas</p>
                            <h4 class="fw-semibold mb-0">@FilteredCount</h4>
                        </div>
                        <div class="avatar avatar-lg bg-primary-transparent">
                            <i class="ri-file-list-3-line fs-20"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12">
            <div class="card custom-card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-fill">
                            <p class="text-muted mb-1">Subtotal</p>
                            <h4 class="fw-semibold mb-0">@FormatMoney(TotalSubtotal)</h4>
                        </div>
                        <div class="avatar avatar-lg bg-success-transparent">
                            <i class="ri-money-dollar-circle-line fs-20"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12">
            <div class="card custom-card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-fill">
                            <p class="text-muted mb-1">IVA</p>
                            <h4 class="fw-semibold mb-0">@FormatMoney(TotalIva)</h4>
                        </div>
                        <div class="avatar avatar-lg bg-warning-transparent">
                            <i class="ri-percent-line fs-20"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12">
            <div class="card custom-card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-fill">
                            <p class="text-muted mb-1">Total</p>
                            <h4 class="fw-semibold mb-0">@FormatMoney(TotalGeneral)</h4>
                        </div>
                        <div class="avatar avatar-lg bg-info-transparent">
                            <i class="ri-wallet-3-line fs-20"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de facturas -->
    <div class="card border-0 shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between bg-transparent">
            <h6 class="mb-0">
                <i class="ri-bill-line me-2"></i>Facturas (@FilteredCount resultados)
            </h6>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-light" title="Anterior" @onclick="PrevPage" disabled="@(pageIndex == 1)">
                    <i class="ri-arrow-left-s-line"></i>
                </button>
                <span class="small text-muted">Página @pageIndex de @TotalPages</span>
                <button class="btn btn-sm btn-light" title="Siguiente" @onclick="NextPage" disabled="@(pageIndex == TotalPages)">
                    <i class="ri-arrow-right-s-line"></i>
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table-hover mb-0 table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th @onclick="@(() => OrdenarPor(nameof(FacturaDto.NumFac)))"
                                role="button"
                                class="user-select-none">
                                Número @IconoOrden(nameof(FacturaDto.NumFac))
                            </th>
                            <th>Cliente</th>
                            <th>Empleado</th>
                            <th @onclick="@(() => OrdenarPor(nameof(FacturaDto.FecFac)))"
                                role="button"
                                class="user-select-none">
                                Fecha @IconoOrden(nameof(FacturaDto.FecFac))
                            </th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">IVA</th>
                            <th class="text-end" @onclick="@(() => OrdenarPor(nameof(FacturaDto.TotFac)))"
                                role="button">
                                Total @IconoOrden(nameof(FacturaDto.TotFac))
                            </th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Paged.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-muted py-4 text-center">
                                    <i class="ri-inbox-line fs-3 d-block mb-2"></i>
                                    No hay facturas con los filtros aplicados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var f in Paged)
                            {
                                if (f == null) continue;
                                <tr @key="f.IdFac">
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary fw-semibold">
                                            @(f.NumFac ?? "-")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-medium">@(f.Cliente?.NomCli ?? "-")</span>
                                            <small class="text-muted">@(f.Cliente?.DirCli ?? "")</small>
                                        </div>
                                    </td>
                                    <td>
                                        <small>@(f.Empleado?.NomEmp ?? "-")</small>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @f.FecFac.ToString("dd/MM/yyyy")
                                            <br />
                                            <span class="text-muted" style="font-size: 0.75rem;">
                                                @f.FecFac.ToString("HH:mm")
                                            </span>
                                        </small>
                                    </td>
                                    <td class="text-end">
                                        <small>@FormatMoney(f.SubFac)</small>
                                    </td>
                                    <td class="text-end">
                                        <small>@FormatMoney(f.IvaFac)</small>
                                    </td>
                                    <td class="text-end">
                                        <strong>@FormatMoney(f.TotFac)</strong>
                                    </td>
                                    <td>
                                        @{
                                            var (badgeClass, icon) = GetEstadoBadge(f.EstFac);
                                        }
                                        <span class="badge @badgeClass">
                                            <i class="@icon"></i> @(f.EstFac ?? "Sin estado")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button"
                                                    class="btn btn-outline-info"
                                                    @onclick="() => VerDetalles(f)"
                                                    title="Ver detalles">
                                                <i class="ri-eye-line"></i>
                                            </button>
                                            @if (f.EstFac != "Anulada")
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-warning"
                                                        @onclick="() => CambiarEstado(f)"
                                                        title="Cambiar estado">
                                                    <i class="ri-refresh-line"></i>
                                                </button>
                                            }
                                            <button type="button"
                                                    class="btn btn-outline-primary"
                                                    @onclick="() => DescargarPDF(f)"
                                                    title="Descargar PDF">
                                                <i class="ri-download-2-line"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<FacturaDto> items = new();
    private bool cargando = true;
    private string? error;

    private string? _filtroTexto;
    private string? _filtroEstado;

    private string? FiltroTexto
    {
        get => _filtroTexto;
        set
        {
            if (_filtroTexto != value)
            {
                _filtroTexto = value;
                pageIndex = 1;
            }
        }
    }

    private string? FiltroEstado
    {
        get => _filtroEstado;
        set
        {
            if (_filtroEstado != value)
            {
                _filtroEstado = value;
                pageIndex = 1;
            }
        }
    }

    private string? filtroCliente;
    private string? filtroEmpleado;
    private DateTime? _fechaDesde;
    private DateTime? _fechaHasta;

    private DateTime? FechaDesde
    {
        get => _fechaDesde;
        set
        {
            if (_fechaDesde != value)
            {
                _fechaDesde = value;
                pageIndex = 1;
            }
        }
    }

    private DateTime? FechaHasta
    {
        get => _fechaHasta;
        set
        {
            if (_fechaHasta != value)
            {
                _fechaHasta = value;
                pageIndex = 1;
            }
        }
    }

    private bool mostrarFiltrosAvanzados;

    private List<string> sugerenciasCliente = new();
    private List<string> sugerenciasEmpleado = new();

    private string _filtroMontoModo = "todos";
    private decimal? _filtroMontoMin;
    private decimal? _filtroMontoMax;

    private string FiltroMontoModo
    {
        get => _filtroMontoModo;
        set
        {
            if (_filtroMontoModo != value)
            {
                _filtroMontoModo = value;
                pageIndex = 1;
            }
        }
    }

    private decimal? FiltroMontoMin
    {
        get => _filtroMontoMin;
        set
        {
            if (_filtroMontoMin != value)
            {
                _filtroMontoMin = value;
                pageIndex = 1;
            }
        }
    }

    private decimal? FiltroMontoMax
    {
        get => _filtroMontoMax;
        set
        {
            if (_filtroMontoMax != value)
            {
                _filtroMontoMax = value;
                pageIndex = 1;
            }
        }
    }

    private int pageIndex = 1;
    private int _pageSize = 10;

    private int pageSize
    {
        get => _pageSize;
        set
        {
            if (_pageSize != value)
            {
                _pageSize = value;
                pageIndex = 1;
            }
        }
    }

    private string? sortBy;
    private bool sortAsc = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            cargando = true;
            error = null;

            items = await FacturasApi.GetFacturasAsync() ?? new List<FacturaDto>();

            var isDark = await JSRuntime.InvokeAsync<bool>("isAppInDarkMode");
            await Swal.FireAsync(new SweetAlertOptions
            {
                Toast = true,
                Position = SweetAlertPosition.TopEnd,
                Icon = SweetAlertIcon.Success,
                Title = $"✓ {items.Count} facturas cargadas",
                ShowConfirmButton = false,
                Timer = 2000,
                TimerProgressBar = true,
                Background = isDark ? "#1e1e1e" : null,
                Color = isDark ? "#e6e6e6" : null
            });
        }
        catch (HttpRequestException ex)
        {
            error = "Error al cargar facturas: " + ex.Message;
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error al cargar",
                Html = "<small>" + Escape(ex.Message) + "</small>",
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "Entendido"
            });
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Recargar()
    {
        var isDark = await JSRuntime.InvokeAsync<bool>("isAppInDarkMode");
        await Swal.FireAsync(new SweetAlertOptions
        {
            Toast = true,
            Position = SweetAlertPosition.TopEnd,
            Icon = SweetAlertIcon.Info,
            Title = "Recargando...",
            ShowConfirmButton = false,
            Timer = 1000,
            Background = isDark ? "#1e1e1e" : null,
            Color = isDark ? "#e6e6e6" : null
        });

        await CargarDatos();
        pageIndex = 1;
    }

    private void LimpiarFiltros()
    {
        FiltroTexto = null;
        FiltroEstado = null;
        filtroCliente = null;
        filtroEmpleado = null;
        FechaDesde = null;
        FechaHasta = null;

        sugerenciasCliente.Clear();
        sugerenciasEmpleado.Clear();

        FiltroMontoModo = "todos";
        FiltroMontoMin = null;
        FiltroMontoMax = null;

        sortBy = null;
        sortAsc = true;
        pageIndex = 1;
    }

    private void ToggleFiltrosAvanzados()
    {
        mostrarFiltrosAvanzados = !mostrarFiltrosAvanzados;
    }

    private void OnClienteInput(ChangeEventArgs e)
    {
        filtroCliente = e.Value?.ToString();
        sugerenciasCliente = CalcularSugerencias(
            filtroCliente,
            x => x.Cliente?.NomCli
        );
        pageIndex = 1;
    }

    private void OnEmpleadoInput(ChangeEventArgs e)
    {
        filtroEmpleado = e.Value?.ToString();
        sugerenciasEmpleado = CalcularSugerencias(
            filtroEmpleado,
            x => x.Empleado?.NomEmp
        );
        pageIndex = 1;
    }

    private void SeleccionarSugerenciaCliente(string valor)
    {
        filtroCliente = valor;
        sugerenciasCliente.Clear();
        pageIndex = 1;
    }

    private void SeleccionarSugerenciaEmpleado(string valor)
    {
        filtroEmpleado = valor;
        sugerenciasEmpleado.Clear();
        pageIndex = 1;
    }

    private List<string> CalcularSugerencias(string? valor, Func<FacturaDto, string?> selector)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return new List<string>();

        var query = valor.Trim();
        if (query.Length < 2)
            return new List<string>();

        return items
            .Select(selector)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(s => s.IndexOf(query, StringComparison.OrdinalIgnoreCase) >= 0)
            .OrderBy(s => s)
            .Take(8)
            .ToList();
    }

    private List<FacturaDto> Filtered
    {
        get
        {
            var r = (items ?? new List<FacturaDto>()).AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_filtroTexto))
            {
                var q = _filtroTexto.Trim();
                r = r.Where(x =>
                    ContainsIgnoreCase(x.NumFac, q) ||
                    ContainsIgnoreCase(x.Cliente?.NomCli, q) ||
                    ContainsIgnoreCase(x.Empleado?.NomEmp, q) ||
                    ContainsIgnoreCase(x.Usuario?.NomUsu, q));
            }

            if (!string.IsNullOrWhiteSpace(_filtroEstado))
            {
                r = r.Where(x => string.Equals(x.EstFac, _filtroEstado, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(filtroCliente))
            {
                var q = filtroCliente.Trim();
                r = r.Where(x => ContainsIgnoreCase(x.Cliente?.NomCli, q));
            }

            if (!string.IsNullOrWhiteSpace(filtroEmpleado))
            {
                var q = filtroEmpleado.Trim();
                r = r.Where(x => ContainsIgnoreCase(x.Empleado?.NomEmp, q));
            }

            if (FechaDesde.HasValue)
            {
                var desde = FechaDesde.Value.Date;
                r = r.Where(x => x.FecFac.Date >= desde);
            }

            if (FechaHasta.HasValue)
            {
                var hasta = FechaHasta.Value.Date;
                r = r.Where(x => x.FecFac.Date <= hasta);
            }

            r = AplicarFiltroMonto(r);
            r = Ordenar(r);

            return r.ToList();
        }
    }

    private IEnumerable<FacturaDto> AplicarFiltroMonto(IEnumerable<FacturaDto> src)
    {
        if (string.IsNullOrWhiteSpace(_filtroMontoModo) || _filtroMontoModo == "todos")
            return src;

        var tieneMin = _filtroMontoMin.HasValue;
        var tieneMax = _filtroMontoMax.HasValue;

        switch (_filtroMontoModo)
        {
            case "igual":
                if (!tieneMin) return src;
                return src.Where(x => x.TotFac == _filtroMontoMin.Value);

            case "mayorIgual":
                if (!tieneMin) return src;
                return src.Where(x => x.TotFac >= _filtroMontoMin.Value);

            case "menorIgual":
                if (!tieneMin) return src;
                return src.Where(x => x.TotFac <= _filtroMontoMin.Value);

            case "entre":
                if (!tieneMin && !tieneMax) return src;
                return src.Where(x =>
                {
                    var t = x.TotFac;
                    if (tieneMin && tieneMax) return t >= _filtroMontoMin.Value && t <= _filtroMontoMax.Value;
                    if (tieneMin) return t >= _filtroMontoMin.Value;
                    return t <= _filtroMontoMax!.Value;
                });

            default:
                return src;
        }
    }

    private int FilteredCount => Filtered.Count;

    private decimal TotalSubtotal => Filtered.Sum(x => x.SubFac);
    private decimal TotalIva => Filtered.Sum(x => x.IvaFac);
    private decimal TotalGeneral => Filtered.Sum(x => x.TotFac);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)pageSize));

    private List<FacturaDto> Paged =>
        Filtered
            .Skip((pageIndex - 1) * pageSize)
            .Take(pageSize)
            .ToList();

    private IEnumerable<FacturaDto> Ordenar(IEnumerable<FacturaDto> src)
    {
        if (string.IsNullOrWhiteSpace(sortBy))
            return src;

        Func<FacturaDto, object?> key = sortBy switch
        {
            nameof(FacturaDto.NumFac) => x => x.NumFac ?? string.Empty,
            nameof(FacturaDto.FecFac) => x => x.FecFac,
            nameof(FacturaDto.TotFac) => x => x.TotFac,
            _ => x => x.IdFac
        };

        return sortAsc ? src.OrderBy(key) : src.OrderByDescending(key);
    }

    private void OrdenarPor(string prop)
    {
        if (sortBy == prop)
        {
            sortAsc = !sortAsc;
        }
        else
        {
            sortBy = prop;
            sortAsc = true;
        }

        pageIndex = 1;
    }

    private string IconoOrden(string prop) =>
        sortBy != prop ? string.Empty : (sortAsc ? "↑" : "↓");

    private void PrevPage()
    {
        if (pageIndex > 1) pageIndex--;
    }
    private void NextPage()
    {
        if (pageIndex < TotalPages) pageIndex++;
    }

    private async Task VerDetalles(FacturaDto f)
