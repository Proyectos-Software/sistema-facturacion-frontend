@code {
    private bool isRendered = false;
    private bool isLoading = true;
    private int? _currentUserId;
    private UserProfileModel profile = new UserProfileModel();

    private bool EsAdmin =>
        string.Equals(profile.Rol, "Admin", StringComparison.OrdinalIgnoreCase);

    private string BannerUrl =>
        EsAdmin
            ? "assets/images/media/backgrounds/profile-banner-admin.svg"
            : "assets/images/media/backgrounds/profile-banner-empleado.svg";

    private string AvatarUrl =>
        EsAdmin
            ? "assets/images/media/avatar-admin.svg"
            : "assets/images/media/avatar-empleado.svg";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                NavigationManager.NavigateTo("/", true);
                return;
            }

            // Obtener el ID del usuario
            var idClaim = user.FindFirst("idUsu") ?? user.FindFirst(ClaimTypes.NameIdentifier);
            if (idClaim != null && int.TryParse(idClaim.Value, out var id))
            {
                _currentUserId = id;
            }
            else
            {
                _currentUserId = await AuthService.GetCurrentUserIdAsync();
            }

            if (_currentUserId.HasValue)
            {
                // Obtener los datos completos desde la API
                var usuarioDto = await UsuariosApi.GetByIdAsync(_currentUserId.Value);

                if (usuarioDto != null)
                {
                    // Mapear los datos del DTO al perfil
                    profile.NombreCompleto = $"{usuarioDto.NomUsu} {usuarioDto.ApeUsu}".Trim();
                    profile.Email = usuarioDto.CorUsu ?? "Sin correo";
                    profile.Telefono = usuarioDto.TelUsu ?? "No registrado";

                    // Obtener el rol desde los claims
                    var rol = user.FindFirst(ClaimTypes.Role)?.Value;
                    profile.Rol = string.IsNullOrWhiteSpace(rol) ? "Usuario" : rol;

                    // Asignar cargo y sueldo
                    if (EsAdmin)
                    {
                        profile.Cargo = "Administrador del Sistema";
                        profile.Sueldo = null; // No mostrar sueldo para admin
                    }
                    else
                    {
                        profile.Cargo = usuarioDto.CarEmp ?? "Empleado";
                        profile.Sueldo = usuarioDto.SueEmp;
                    }
                }
                else
                {
                    // Fallback si no se encuentra el usuario en la API
                    await LoadFromClaims(user);
                }
            }
            else
            {
                // Fallback si no se puede obtener el ID
                await LoadFromClaims(user);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando perfil: {ex.Message}");
            // Fallback en caso de error
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await LoadFromClaims(authState.User);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadFromClaims(ClaimsPrincipal user)
    {
        var nombre = user.Identity?.Name ?? user.FindFirst(ClaimTypes.Name)?.Value;
        profile.NombreCompleto = string.IsNullOrWhiteSpace(nombre) ? "Usuario" : nombre;

        var email = user.FindFirst(ClaimTypes.Email)?.Value;
        profile.Email = string.IsNullOrWhiteSpace(email) ? "Sin correo" : email;

        var rol = user.FindFirst(ClaimTypes.Role)?.Value;
        profile.Rol = string.IsNullOrWhiteSpace(rol) ? "Usuario" : rol;

        if (EsAdmin)
        {
            profile.Cargo = "Administrador del Sistema";
            profile.Sueldo = null;
        }
        else
        {
            profile.Cargo = "Empleado";
            profile.Sueldo = null;
        }

        profile.Telefono = "No registrado";

        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isRendered = true;
            await Task.Delay(0);
            StateHasChanged();
        }
    }

    private FilePond? FilePond { get; set; }

    private readonly FilePondOptions _Attachments = new()
    {
        MaxFiles = 12,
        AllowMultiple = true,
    };

    private sealed class UserProfileModel
    {
        public string NombreCompleto { get; set; } = "Usuario";
        public string Rol { get; set; } = "Usuario";
        public string Email { get; set; } = "Sin correo";
        public string Telefono { get; set; } = "No registrado";
        public string Cargo { get; set; } = "Usuario";
        public decimal? Sueldo { get; set; }
    }
}