@page "/profile"
@using Soenneker.Blazor.FilePond
@using Soenneker.Blazor.FilePond.Options
@using Soenneker.Blazor.FilePond.Dtos
@using Soenneker.Blazor.FilePond.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IUsuariosApiClient UsuariosApi

<div class="page-header-breadcrumb mb-3">
    <div class="d-flex align-center justify-content-between flex-wrap">
        <h1 class="page-title fw-medium fs-18 mb-0">Perfil</h1>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="javascript:void(0);">Páginas</a></li>
            <li class="breadcrumb-item active" aria-current="page">Perfil</li>
        </ol>
    </div>
</div>

@if (isLoading)
{
    <div class="py-5 text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="row">
                <div class="col-xl-12">
                    <div class="card custom-card profile-card">
                        <div class="profile-banner-image">
                            <img src="@BannerUrl" class="card-img-top" alt="Banner perfil">
                        </div>
                        <div class="card-body position-relative p-4 pb-0">
                            <div class="d-flex align-items-end justify-content-between flex-wrap">
                                <div class="d-flex align-items-end flex-wrap gap-3">
                                    <span class="avatar avatar-xxl avatar-rounded @(EsAdmin ? "bg-danger" : "bg-info") online">
                                        <img src="@AvatarUrl" alt="Avatar">
                                    </span>
                                    <div class="mt-4 mb-3">
                                        <div class="d-flex align-items-center mb-1 flex-wrap gap-2">
                                            <h5 class="fw-semibold mb-0">@profile.NombreCompleto</h5>
                                            <span class="badge @(EsAdmin ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary")">
                                                @profile.Rol
                                            </span>
                                        </div>
                                        <span class="d-block fw-medium text-muted mb-2">
                                            <i class="ri-briefcase-line me-1"></i>@profile.Cargo
                                        </span>
                                        <p class="fs-13 fw-medium text-muted mb-0">
                                            <span class="me-3">
                                                <i class="ri-phone-line me-1 align-middle"></i>@profile.Telefono
                                            </span>
                                            <span>
                                                <i class="ri-mail-line me-1 align-middle"></i>@profile.Email
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-12">
                    <div class="tab-content" id="profile-tabs">
                        <div class="tab-pane show active border-0 p-0" id="profile-about-tab-pane" role="tabpanel"
                             aria-labelledby="profile-about-tab" tabindex="0">
                            <div class="row">
                                <div class="col-xxl-12">
                                    <div class="row">
                                        <div class="col-xl-12">
                                            <div class="card custom-card">
                                                <div class="card-header">
                                                    <div class="card-title">
                                                        <i class="ri-information-line me-2"></i>Información del Perfil
                                                    </div>
                                                </div>
                                                <div class="card-body">
                                                    <div class="row g-3">
                                                        <div class="col-md-6">
                                                            <div class="d-flex align-items-center rounded border p-3">
                                                                <span class="avatar avatar-md avatar-rounded bg-primary-subtle text-primary me-3">
                                                                    <i class="ri-user-line fs-18"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="d-block text-muted fs-12 mb-1">Nombre Completo</span>
                                                                    <span class="fw-semibold">@profile.NombreCompleto</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <div class="d-flex align-items-center rounded border p-3">
                                                                <span class="avatar avatar-md avatar-rounded bg-success-subtle text-success me-3">
                                                                    <i class="ri-mail-line fs-18"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="d-block text-muted fs-12 mb-1">Correo Electrónico</span>
                                                                    <span class="fw-semibold">@profile.Email</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <div class="d-flex align-items-center rounded border p-3">
                                                                <span class="avatar avatar-md avatar-rounded bg-info-subtle text-info me-3">
                                                                    <i class="ri-phone-line fs-18"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="d-block text-muted fs-12 mb-1">Teléfono</span>
                                                                    <span class="fw-semibold">@profile.Telefono</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <div class="d-flex align-items-center rounded border p-3">
                                                                <span class="avatar avatar-md avatar-rounded @(EsAdmin ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning") me-3">
                                                                    <i class="ri-shield-user-line fs-18"></i>
                                                                </span>
                                                                <div>
                                                                    <span class="d-block text-muted fs-12 mb-1">Rol del Sistema</span>
                                                                    <span class="fw-semibold">@profile.Rol</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        @if (!EsAdmin)
                                                        {
                                                            <div class="col-md-6">
                                                                <div class="d-flex align-items-center rounded border p-3">
                                                                    <span class="avatar avatar-md avatar-rounded bg-purple-subtle text-purple me-3">
                                                                        <i class="ri-building-line fs-18"></i>
                                                                    </span>
                                                                    <div>
                                                                        <span class="d-block text-muted fs-12 mb-1">Cargo</span>
                                                                        <span class="fw-semibold">@profile.Cargo</span>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            @if (profile.Sueldo.HasValue && profile.Sueldo.Value > 0)
                                                            {
                                                                <div class="col-md-6">
                                                                    <div class="d-flex align-items-center rounded border p-3">
                                                                        <span class="avatar avatar-md avatar-rounded bg-success-subtle text-success me-3">
                                                                            <i class="ri-money-dollar-circle-line fs-18"></i>
                                                                        </span>
                                                                        <div>
                                                                            <span class="d-block text-muted fs-12 mb-1">Sueldo</span>
                                                                            <span class="fw-semibold">$@profile.Sueldo.Value.ToString("N2")</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

