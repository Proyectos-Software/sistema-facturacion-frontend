        }
        catch { /* no bloquear por errors del endpoint */ }

        // limpia almacenamiento local y header Authorization
        await SessionService.RemoveTokenAsync(); // o RemoveTokenAsync()

        if (AuthStateProvider is CustomAuthStateProvider cap)
            cap.NotifyUserLogout();


