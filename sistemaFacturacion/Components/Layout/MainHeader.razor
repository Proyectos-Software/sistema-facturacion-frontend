    private async Task LogoutAsync()
    {
        try
        {
            // (Opcional) informa al backend si tienes endpoint para invalidar refresh token
            await AuthService.LogoutAsync(); // si no existe, omite esta línea
        }
        catch { /* no bloquear por errors del endpoint */ }

        // limpia almacenamiento local y header Authorization
        await SessionService.RemoveTokenAsync(); // o RemoveTokenAsync()

        if (AuthStateProvider is CustomAuthStateProvider cap)
            cap.NotifyUserLogout();


        // redirige al login (tu "/" o "/index")
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
